{%- comment -%}
  Full-width editorial card injected mid-grid on the collection page.
  Rendered only when the caller resolves editorial content (chapter collections via
  metafields, or the emblemas template via section settings). Accepts:
    ed_picker — image_picker image (real path, preferred)
    ed_asset  — asset filename fallback (e.g. collection-aurora.webp)
    ed_text   — caption (richtext/plain)
{%- endcomment -%}
{%- liquid
  assign ed_alt = ed_text | default: '' | strip_html | escape
-%}
<div class="editorial-insert reveal">
  {%- if ed_picker != blank -%}
    {% render 'image-responsive', image: ed_picker, alt: ed_alt, sizes: '100vw' %}
  {%- elsif ed_asset != blank -%}
    <img src="{{ ed_asset | asset_url }}" alt="{{ ed_alt }}" width="1760" height="640" loading="lazy" decoding="async">
  {%- endif -%}
  {%- if ed_text != blank -%}<p>{{ ed_text }}</p>{%- endif -%}
</div>
