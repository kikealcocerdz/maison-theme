{%- comment -%}
  Nuestras mesas — editorial page: hero + text filter bar + alternating shoppable
  table scenes. Each scene = full-bleed photo with pulsing hotspots + a product
  mini-carousel (arrows, dots, hotspot→product switching, per-product note and
  add-to-cart CTAs). Scenes are `scene` blocks; their products are flat `product`
  blocks linked by `scene_id` == the scene's `type_slug`. Filters toggle scenes.
  All product slides are server-rendered; JS only swaps the active one.
{%- endcomment -%}
{%- liquid
  assign all_label = section.settings.filter_all_label | default: 'Todas'
  assign filter_rows = section.settings.filters | newline_to_br | split: '<br />'
-%}
<main class="tables-page tables-page-v48" data-section-id="{{ section.id }}">
  <section class="tables-hero">
    <div>
      {%- if section.settings.kicker != blank -%}<p class="collection-kicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h1>{{ section.settings.heading | escape }}</h1>{%- endif -%}
    </div>
    {%- if section.settings.intro != blank -%}<p>{{ section.settings.intro | strip_html }}</p>{%- endif -%}
  </section>

  {%- if filter_rows.size > 0 -%}
    <section class="table-filters table-filters--text" aria-label="{{ 'sections.tables.filters' | t }}">
      <button class="table-filter active" type="button" data-table-filter="all"><span>{{ all_label | escape }}</span></button>
      {%- for row in filter_rows -%}
        {%- assign parts = row | split: '|' -%}
        {%- if parts[0] != blank -%}
          <button class="table-filter" type="button" data-table-filter="{{ parts[1] | default: parts[0] | strip | handleize }}"><span>{{ parts[0] | strip | escape }}</span></button>
        {%- endif -%}
      {%- endfor -%}
    </section>
  {%- endif -%}

  <section class="table-scenes-list table-scenes-list-v48">
    {%- for block in section.blocks -%}
      {%- if block.type == 'scene' -%}
        {%- liquid
          assign slug = block.settings.type_slug | default: 'all' | strip | handleize
          assign hotspot_rows = block.settings.hotspots | newline_to_br | split: '<br />'
          assign v42 = block.settings.vajilla42
          assign v56 = block.settings.vajilla56

          # How many product blocks belong to this scene (needed for the dot rows).
          assign prod_count = 0
          for b in section.blocks
            if b.type == 'product' and b.settings.scene_id == block.settings.type_slug
              assign prod_count = prod_count | plus: 1
            endif
          endfor
        -%}
        <article class="table-scene-block table-shop-scene{% if block.settings.reverse %} reverse{% endif %}" data-table-type="{{ slug }}" {{ block.shopify_attributes }}>
          <div class="table-scene-photo">
            {%- if block.settings.photo != blank -%}
              {% render 'image-responsive', image: block.settings.photo, alt: block.settings.photo_alt, sizes: '(max-width: 1000px) 100vw, 55vw' %}
            {%- else -%}
              <img src="{{ block.settings.demo_photo | default: 'scene-table.webp' | asset_url }}" alt="{{ block.settings.photo_alt | escape }}" width="1800" height="1343" loading="lazy" decoding="async">
            {%- endif -%}
            {%- for row in hotspot_rows -%}
              {%- assign xy = row | split: '|' -%}
              {%- if xy[0] != blank -%}
                {%- liquid
                  assign hs_label = xy[2] | strip
                  if hs_label == blank
                    assign hs_label = 'sections.tables.hotspot' | t
                  endif
                -%}
                <button class="scene-hotspot{% if forloop.first %} active{% endif %}" type="button" data-table-hotspot="{{ forloop.index0 }}" aria-label="{{ hs_label | escape }}" style="left:{{ xy[0] | strip }}%;top:{{ xy[1] | default: '50' | strip }}%"></button>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <aside class="table-scene-product" aria-live="polite">
            <button class="table-prod-arrow prev" type="button" data-table-prev aria-label="{{ 'general.accessibility.previous' | t }}">&lsaquo;</button>
            <div class="table-product-slot">
              {%- assign idx = -1 -%}
              {%- for b in section.blocks -%}
                {%- if b.type == 'product' and b.settings.scene_id == block.settings.type_slug -%}
                  {%- liquid
                    assign idx = idx | plus: 1
                    assign p = b.settings.product
                    assign p_name = b.settings.demo_title
                    assign p_url = b.settings.demo_url
                    if p != blank
                      assign p_name = p.title
                      assign p_url = p.url
                    endif
                  -%}
                  <div class="table-product-item{% if idx == 0 %} is-active{% endif %}" {{ b.shopify_attributes }}>
                    {%- if p != blank and p.featured_image != blank -%}
                      <a class="table-product-link" href="{{ p.url }}">
                        {% render 'image-responsive', image: p.featured_image, alt: p.title, sizes: '(max-width: 1000px) 80vw, 30vw' %}
                      </a>
                    {%- elsif b.settings.demo_image != blank -%}
                      <a class="table-product-link" href="{{ p_url | default: '#' }}">
                        <img src="{{ b.settings.demo_image | asset_url }}" alt="{{ p_name | escape }}" width="884" height="884" loading="lazy" decoding="async">
                      </a>
                    {%- endif -%}
                    {%- if b.settings.meta_line != blank -%}<p class="table-product-label">{{ b.settings.meta_line | escape }}</p>{%- endif -%}
                    {%- if p_name != blank -%}<h2>{{ p_name | escape }}</h2>{%- endif -%}
                    {%- if p != blank -%}
                      <span>{{ p.price | money }}</span>
                    {%- elsif b.settings.demo_price != blank -%}
                      <span>{{ b.settings.demo_price | escape }}</span>
                    {%- endif -%}
                    {%- if b.settings.note != blank -%}<p class="table-product-note">{{ b.settings.note | escape }}</p>{%- endif -%}
                    {%- if prod_count > 1 -%}
                      <div class="table-product-lines">
                        {%- for j in (1..prod_count) -%}
                          <button type="button" class="{% if forloop.index0 == idx %}active{% endif %}" data-go="{{ forloop.index0 }}" aria-label="Ver producto {{ forloop.index }}"></button>
                        {%- endfor -%}
                      </div>
                    {%- endif -%}
                    <div class="table-scene-actions">
                      {%- if p != blank and p.selected_or_first_available_variant != blank -%}
                        <form action="{{ routes.cart_add_url }}" method="post">
                          <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                          <button class="ghost-btn table-add-piece" type="submit">Añadir pieza</button>
                        </form>
                      {%- else -%}
                        <a class="ghost-btn table-add-piece" href="{{ p_url | default: '#' }}">Añadir pieza</a>
                      {%- endif -%}
                      {%- if v42 != blank and v42.selected_or_first_available_variant != blank -%}
                        <form action="{{ routes.cart_add_url }}" method="post">
                          <input type="hidden" name="id" value="{{ v42.selected_or_first_available_variant.id }}">
                          <button class="ghost-btn" type="submit">Añadir vajilla · 42 platos</button>
                        </form>
                      {%- endif -%}
                      {%- if v56 != blank and v56.selected_or_first_available_variant != blank -%}
                        <form action="{{ routes.cart_add_url }}" method="post">
                          <input type="hidden" name="id" value="{{ v56.selected_or_first_available_variant.id }}">
                          <button class="ghost-btn" type="submit">Añadir vajilla · 56 platos</button>
                        </form>
                      {%- endif -%}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <button class="table-prod-arrow next" type="button" data-table-next aria-label="{{ 'general.accessibility.next' | t }}">&rsaquo;</button>
          </aside>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </section>
</main>

{% stylesheet %}
.tables-page { padding-top: calc(var(--header-h) + 74px); background: var(--paper); color: var(--ink); }
.tables-page .tables-hero { width: var(--content); margin: 0 auto 66px; display: grid; grid-template-columns: 1fr .82fr; gap: min(8vw, 120px); align-items: start; }
.tables-page .collection-kicker { font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); margin: 0 0 18px; }
.tables-page .tables-hero h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(44px, 5vw, 76px); line-height: .98; margin: 0; color: var(--ink); letter-spacing: -.01em; }
.tables-page .tables-hero > p { font-size: 14px; line-height: 1.9; color: var(--muted); margin: 34px 0 0; text-align: right; }

.tables-page .table-filters { width: var(--content); margin: 0 auto 86px; display: flex; align-items: center; justify-content: center; gap: clamp(26px, 5vw, 78px); border-top: .5px solid var(--rule); border-bottom: .5px solid var(--rule); padding: 28px 0 30px; }
.tables-page .table-filter { position: relative; background: transparent; color: var(--muted); text-align: center; padding: 0 0 9px; font-size: 10px; letter-spacing: .22em; text-transform: uppercase; transition: color 260ms var(--ease); }
.tables-page .table-filter span { position: relative; display: block; font-family: var(--sans); font-size: 10px; letter-spacing: .22em; }
.tables-page .table-filter::after { content: ""; position: absolute; left: 50%; bottom: 0; width: 0; height: 1px; background: var(--ink); transform: translateX(-50%); transition: width 360ms var(--ease-long), opacity 260ms var(--ease); opacity: 0; }
.tables-page .table-filter:hover, .tables-page .table-filter.active { color: var(--ink); }
.tables-page .table-filter.active::after { width: 100%; opacity: 1; }
.tables-page .table-filter:hover::after { width: 100%; opacity: .42; }

.tables-page .table-scenes-list { width: var(--content); margin: 0 auto 140px; display: grid; gap: 96px; }
.tables-page .table-scene-block { display: grid; grid-template-columns: 1.1fr .9fr; gap: min(5vw, 76px); align-items: center; scroll-margin-top: 120px; }
.tables-page .table-scene-block.reverse .table-scene-photo { order: 2; }
.tables-page .table-scene-block.reverse .table-scene-product { order: 1; }
.tables-page .table-scene-block.is-hidden { display: none; }
.tables-page .table-scene-photo { height: 640px; min-height: 640px; background: var(--ink-faint-20); position: relative; overflow: hidden; }
.tables-page .table-scene-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center; transition: transform 1000ms var(--ease-long); }
.tables-page .table-scene-photo:hover img { transform: scale(1.025); }
.tables-page .table-scene-product { position: relative; border-top: .5px solid var(--rule); border-bottom: .5px solid var(--rule); height: 640px; min-height: 640px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 60px 84px; }

.tables-page .table-product-slot { width: 100%; min-height: 100%; display: grid; align-content: center; justify-items: center; transition: opacity .28s var(--ease), transform .36s var(--ease); }
.tables-page .table-product-slot.is-changing { opacity: 0; transform: translateY(10px); }
.tables-page .table-product-item { display: none; width: 100%; }
.tables-page .table-product-item.is-active { display: grid; justify-items: center; }
.tables-page .table-product-link { display: block; width: 100%; color: inherit; text-decoration: none; }
.tables-page .table-product-link img { height: min(40vh, 320px); max-height: 320px; width: 100%; object-fit: contain; margin-bottom: 22px; cursor: pointer; }
.tables-page .table-product-label { font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); margin: 0 0 10px; }
.tables-page .table-product-item h2 { font-family: var(--serif); font-weight: 400; font-size: 28px; line-height: 1.1; margin: 0 0 10px; color: var(--ink); max-width: 360px; }
.tables-page .table-product-item > span { font-size: 13px; color: var(--ink); }
.tables-page .table-scene-product .table-product-note { font-size: 12px; line-height: 1.7; color: var(--muted); text-transform: none; letter-spacing: .02em; max-width: 360px; margin: 14px auto 0; }
.tables-page .table-product-lines { display: flex; justify-content: center; gap: 7px; margin: 20px 0 0; }
.tables-page .table-product-lines button { width: 26px; height: 1px; padding: 0; border: 0; background: rgba(15, 26, 46, .22); cursor: pointer; transition: width .25s var(--ease), background .25s var(--ease); }
.tables-page .table-product-lines button.active { width: 38px; background: var(--ink); }

.tables-page .table-scene-actions { display: grid; grid-template-columns: 1fr; gap: 10px; width: min(100%, 340px); margin: 24px auto 0; }
.tables-page .table-scene-actions form { display: contents; }
.tables-page .table-scene-actions .ghost-btn { width: 100%; min-width: 0; height: 42px; font-size: 10px; letter-spacing: .18em; padding: 0 18px; }
@media (min-width: 1180px) {
  .tables-page .table-scene-actions { grid-template-columns: 1fr 1fr; }
  .tables-page .table-scene-actions .table-add-piece { grid-column: 1 / -1; }
}

.tables-page .table-prod-arrow { position: absolute; top: 50%; transform: translateY(-50%); font-family: var(--serif); font-size: 34px; line-height: 1; color: var(--ink); opacity: .75; background: transparent; border: 0; cursor: pointer; z-index: 2; transition: opacity 220ms var(--ease); }
.tables-page .table-prod-arrow:hover { opacity: 1; }
.tables-page .table-prod-arrow.prev { left: 24px; }
.tables-page .table-prod-arrow.next { right: 24px; }

.tables-page .scene-hotspot { position: absolute; width: 18px; height: 18px; border: .5px solid var(--ink); background: var(--paper); border-radius: 999px; box-shadow: 0 0 0 9px rgba(255, 255, 255, .48); cursor: pointer; animation: tableHotspotPulse 2600ms infinite; }
.tables-page .scene-hotspot.active { background: var(--ink); }
@keyframes tableHotspotPulse {
  0% { box-shadow: 0 0 0 0 rgba(255, 255, 255, .5); }
  70% { box-shadow: 0 0 0 14px rgba(255, 255, 255, 0); }
  100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0); }
}

@media (max-width: 1000px) {
  .tables-page .tables-hero { grid-template-columns: 1fr; }
  .tables-page .tables-hero > p { text-align: left; margin-top: 0; }
  .tables-page .table-filters { flex-wrap: wrap; row-gap: 18px; }
  .tables-page .table-scene-block, .tables-page .table-scene-block.reverse { grid-template-columns: 1fr; }
  .tables-page .table-scene-block.reverse .table-scene-photo, .tables-page .table-scene-block.reverse .table-scene-product { order: initial; }
  .tables-page .table-scene-photo, .tables-page .table-scene-product { height: 520px; min-height: 520px; }
}
@media (max-width: 620px) {
  .tables-page .table-filters { justify-content: flex-start; gap: 20px; overflow-x: auto; padding: 22px 0 24px; }
  .tables-page .table-filter { flex: 0 0 auto; }
  .tables-page .table-scene-photo, .tables-page .table-scene-product { height: 420px; min-height: 420px; }
  .tables-page .table-scene-product { padding: 42px 54px; }
  .tables-page .table-product-link img { height: 210px; }
  .tables-page .table-scene-actions { width: 100%; }
}
@media (prefers-reduced-motion: reduce) {
  .tables-page .scene-hotspot { animation: none; }
  .tables-page .table-product-slot, .tables-page .table-scene-photo img { transition: none; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  function initScene(scene) {
    var slot = scene.querySelector('.table-product-slot');
    if (!slot) return;
    var items = [].slice.call(slot.querySelectorAll('.table-product-item'));
    if (!items.length) return;
    var hotspots = [].slice.call(scene.querySelectorAll('[data-table-hotspot]'));
    var current = 0;

    function apply() {
      items.forEach(function (it, i) { it.classList.toggle('is-active', i === current); });
      hotspots.forEach(function (h, i) { h.classList.toggle('active', i === current); });
    }
    function show(i) {
      current = ((i % items.length) + items.length) % items.length;
      if (reduce.matches) { apply(); return; }
      slot.classList.add('is-changing');
      setTimeout(function () { apply(); slot.classList.remove('is-changing'); }, 120);
    }

    var prev = scene.querySelector('[data-table-prev]');
    var next = scene.querySelector('[data-table-next]');
    if (prev) prev.addEventListener('click', function () { show(current - 1); });
    if (next) next.addEventListener('click', function () { show(current + 1); });
    hotspots.forEach(function (h) {
      h.addEventListener('click', function () { show(Number(h.dataset.tableHotspot || 0)); });
    });
    slot.addEventListener('click', function (e) {
      var go = e.target.closest('[data-go]');
      if (go) show(Number(go.dataset.go));
    });
  }

  function init(root) {
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';

    var filters = [].slice.call(root.querySelectorAll('[data-table-filter]'));
    var blocks = [].slice.call(root.querySelectorAll('[data-table-type]'));
    filters.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var type = btn.dataset.tableFilter;
        filters.forEach(function (b) { b.classList.toggle('active', b === btn); });
        blocks.forEach(function (block) { block.classList.toggle('is-hidden', type !== 'all' && block.dataset.tableType !== type); });
      });
    });

    root.querySelectorAll('.table-shop-scene').forEach(initScene);
  }

  document.querySelectorAll('.tables-page').forEach(init);
  document.addEventListener('shopify:section:load', function (e) { e.target.querySelectorAll('.tables-page').forEach(init); });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Our tables",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Editorial · Nuestras mesas" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Mesas que cuentan una historia" },
    { "type": "richtext", "id": "intro", "label": "Intro copy" },
    { "type": "header", "content": "Filters" },
    { "type": "text", "id": "filter_all_label", "label": "\"All\" label", "default": "Todas" },
    { "type": "textarea", "id": "filters", "label": "Filters (one per line: Label|slug)", "info": "slug must match a scene's Type slug.", "default": "Aurora Oaxaca|oaxaca\nFlor de Lis Azul|flor\nAurora Ceilán|ceilan\nBellavista|bellavista\nNegro Vistas|negro" }
  ],
  "blocks": [
    {
      "type": "scene",
      "name": "Table scene",
      "settings": [
        { "type": "checkbox", "id": "reverse", "label": "Reverse layout (product on left)", "default": false },
        { "type": "text", "id": "type_slug", "label": "Type slug (matches a filter)", "default": "oaxaca", "info": "Product blocks with the same Scene id belong to this scene." },
        { "type": "header", "content": "Scene photo" },
        { "type": "image_picker", "id": "photo", "label": "Photo" },
        { "type": "text", "id": "demo_photo", "label": "Demo photo (asset filename)" },
        { "type": "text", "id": "photo_alt", "label": "Photo alt text" },
        { "type": "textarea", "id": "hotspots", "label": "Hotspots (one per line: left%|top%|label)", "info": "Hotspot n shows the scene's n-th product.", "default": "34|45|Ver pieza\n58|52|Ver pieza\n73|37|Ver pieza" },
        { "type": "header", "content": "Vajilla CTAs" },
        { "type": "product", "id": "vajilla42", "label": "Vajilla 42 piezas (product)" },
        { "type": "product", "id": "vajilla56", "label": "Vajilla 56 piezas (product)" }
      ]
    },
    {
      "type": "product",
      "name": "Scene product",
      "settings": [
        { "type": "text", "id": "scene_id", "label": "Scene id (matches a scene's Type slug)", "default": "oaxaca" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "meta_line", "label": "Meta line (e.g. 'Aurora Collection · Oaxaca')" },
        { "type": "textarea", "id": "note", "label": "Editorial note" },
        { "type": "header", "content": "Demo (when no product selected)" },
        { "type": "text", "id": "demo_image", "label": "Demo image (asset filename)" },
        { "type": "text", "id": "demo_title", "label": "Demo title" },
        { "type": "text", "id": "demo_price", "label": "Demo price (e.g. 92 €)" },
        { "type": "url", "id": "demo_url", "label": "Demo link" }
      ]
    }
  ],
  "presets": [{ "name": "Our tables" }]
}
{% endschema %}
