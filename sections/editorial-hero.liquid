<section class="editorial-hero" id="editorialHero-{{ section.id }}" data-section-id="{{ section.id }}" data-header-variant="light"{% if section.settings.light_frames != blank %} data-light-frames="{{ section.settings.light_frames | escape }}"{% endif %} aria-label="{{ section.settings.heading | strip_html | escape | default: 'Hero' }}">
  {%- liquid
    assign hero_video_src = ''
    if section.settings.video != blank
      assign hero_video_src = section.settings.video
    elsif section.settings.demo_video != blank
      assign hero_video_src = section.settings.demo_video | asset_url
    endif
  -%}
  <div class="editorial-hero__sticky">
    <div class="editorial-hero__frame">
      {%- if hero_video_src != blank -%}
        <video class="editorial-hero__media" autoplay muted loop playsinline preload="metadata" poster="{%- if section.settings.image != blank -%}{{ section.settings.image | image_url: width: 1920 }}{%- else -%}{{ 'hero-poster.webp' | asset_url }}{%- endif -%}" aria-label="{{ section.settings.heading | strip_html | escape }}">
          <source src="{{ hero_video_src }}" type="video/mp4">
        </video>
      {%- elsif section.settings.image != blank -%}
        <img class="editorial-hero__media" src="{{ section.settings.image | image_url: width: 1920 }}"
          srcset="{{ section.settings.image | image_url: width: 720 }} 720w, {{ section.settings.image | image_url: width: 1080 }} 1080w, {{ section.settings.image | image_url: width: 1440 }} 1440w, {{ section.settings.image | image_url: width: 1920 }} 1920w"
          sizes="100vw"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          loading="eager" fetchpriority="high" decoding="async"
          width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
      {%- else -%}
        {%- comment -%} Demo fallback image (shipped in /assets) until a hero image is set. {%- endcomment -%}
        <img class="editorial-hero__media" src="{{ 'hero.webp' | asset_url }}"
          alt="{{ section.settings.heading | strip_html | escape }}"
          width="2200" height="1257"
          loading="eager" fetchpriority="high" decoding="async">
      {%- endif -%}

      <div class="editorial-hero__noise" aria-hidden="true"></div>

      <div class="editorial-hero__title">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow editorial-hero__eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h1 class="display">{{ section.settings.heading | remove: '<p>' | remove: '</p>' }}</h1>{%- endif -%}
        {%- comment -%} richtext ya envuelve en <p>: anidarlo dejaba un <p> vacío suelto. {%- endcomment -%}
        {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading | remove: '<p>' | remove: '</p>' }}</p>{%- endif -%}
      </div>

      {%- comment -%}
        Sonido del propio vídeo: arranca siempre en silencio (el navegador no deja otra
        cosa) y sólo suena si se pulsa el botón, y sólo mientras el hero está en pantalla.
      {%- endcomment -%}
      {%- if hero_video_src != blank and section.settings.video_sound -%}
        <button class="editorial-hero__sound" type="button" data-hero-sound aria-pressed="false"
          data-label-play="{{ 'sections.hero.unmute' | t | escape }}" data-label-pause="{{ 'sections.hero.mute' | t | escape }}"
          aria-label="{{ 'sections.hero.unmute' | t | escape }}">
          <span class="editorial-hero__sound-bars" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="editorial-hero__sound-label">{{ section.settings.sound_label | default: 'Sonido' | escape }}</span>
        </button>
      {%- endif -%}

      <div class="editorial-hero__progress" aria-hidden="true"><span></span></div>
      <div class="editorial-hero__scroll-cue" aria-label="{{ 'general.accessibility.scroll_down' | t }}"><span></span></div>
    </div>
  </div>
</section>

{% stylesheet %}
.editorial-hero {
  height: 245vh;
  position: relative;
  background: #EEEFF1;
}
.editorial-hero__sticky {
  position: sticky; top: 0; height: 100vh;
  background: var(--paper); overflow: hidden;
  contain: layout paint style;
}
.editorial-hero__frame {
  position: absolute; inset: 0;
  width: 100vw; height: 100vh; overflow: hidden;
  background: #dbe1e8;
  isolation: isolate;
  clip-path: polygon(
    var(--hero-clip-left, 0%) var(--hero-clip-top, 0%),
    var(--hero-clip-right, 100%) var(--hero-clip-top, 0%),
    var(--hero-clip-right, 100%) var(--hero-clip-bottom, 100%),
    var(--hero-clip-left, 0%) var(--hero-clip-bottom, 100%)
  );
  will-change: clip-path;
  transform: translateZ(0);
}
.editorial-hero__frame::before {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(180deg,
    rgba(15, 26, 46, 0.32) 0%,
    rgba(15, 26, 46, 0.13) 18%,
    rgba(15, 26, 46, 0.03) 52%,
    rgba(15, 26, 46, 0.20) 100%);
  z-index: 2; pointer-events: none;
}
.editorial-hero__frame::after {
  content: ""; position: absolute; inset: 0;
  background: rgba(15, 26, 46, 0.48);
  opacity: var(--hero-dim, 0);
  z-index: 4; pointer-events: none;
  transition: opacity 80ms linear;
}

.editorial-hero__media {
  width: 100%; height: 100%; object-fit: cover; object-position: center;
  transform: translate3d(0, 0, 0) scale(var(--hero-media-scale, 1.04));
  filter: saturate(0.96);
  will-change: transform;
}

.editorial-hero__placeholder {
  width: 100%; height: 100%; background: linear-gradient(180deg, #dbe1e8 0%, #b9c2cc 100%);
}

.editorial-hero__noise {
  position: absolute; inset: 0;
  background-image: radial-gradient(circle at 1px 1px, rgba(255, 255, 255, 0.12) 1px, transparent 0);
  background-size: 12px 12px; opacity: 0.10; z-index: 3; pointer-events: none;
}

.editorial-hero__title {
  position: absolute; z-index: 6;
  left: 50%; bottom: 7.2vh;
  transform: translate3d(-50%, calc((1 - var(--hero-title-opacity, 0)) * 18px), 0);
  width: min(880px, 88vw);
  text-align: center; color: var(--paper);
  opacity: var(--hero-title-opacity, 0);
  pointer-events: none;
  will-change: opacity, transform;
}
.editorial-hero__title h1 {
  font-size: clamp(56px, 7.5vw, 128px);
  line-height: 1;
  margin: 0 0 16px;
  text-wrap: balance;
  letter-spacing: -0.005em;
}
.editorial-hero__title h1 p { margin: 0; font-size: inherit; line-height: inherit; }
.editorial-hero__title > p {
  font-size: clamp(10px, 0.85vw, 13px);
  line-height: 1.8; letter-spacing: 0.04em;
  margin: 0 auto; max-width: 560px;
}
.editorial-hero__eyebrow { color: var(--paper); display: block; margin-bottom: 18px; }

.editorial-hero__progress {
  position: absolute; left: 50%; bottom: 28px;
  transform: translateX(-50%); z-index: 8;
  width: min(260px, 24vw); height: 0.5px;
  background: rgba(255, 255, 255, 0.35);
  opacity: var(--hero-title-opacity, 0);
}
.editorial-hero__progress span {
  display: block; height: 100%; background: var(--paper);
  width: calc(var(--hero-progress, 0) * 100%);
}

.editorial-hero__sound {
  position: absolute; left: 4vw; bottom: 26px; z-index: 9;
  display: inline-flex; align-items: center; gap: 10px;
  height: 36px; padding: 0 16px 0 14px;
  border: 0.5px solid rgba(255, 255, 255, 0.72); border-radius: 999px;
  background: rgba(15, 26, 46, 0.18); color: var(--paper);
  -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; cursor: pointer;
  transition: background 260ms var(--ease);
}
.editorial-hero__sound:hover, .editorial-hero__sound:focus-visible { background: rgba(15, 26, 46, 0.42); }
.editorial-hero__sound-bars { display: inline-flex; align-items: flex-end; gap: 2px; height: 12px; }
.editorial-hero__sound-bars i { display: block; width: 2px; height: 4px; background: currentColor; }
.editorial-hero__sound[aria-pressed="true"] .editorial-hero__sound-bars i { animation: heroSoundBar 900ms ease-in-out infinite alternate; }
.editorial-hero__sound[aria-pressed="true"] .editorial-hero__sound-bars i:nth-child(2) { animation-delay: -300ms; }
.editorial-hero__sound[aria-pressed="true"] .editorial-hero__sound-bars i:nth-child(3) { animation-delay: -600ms; }
@keyframes heroSoundBar { from { height: 3px; } to { height: 12px; } }
@media (max-width: 680px) { .editorial-hero__sound { left: 16px; bottom: 18px; } }

/* Tramo blanco del vídeo: lo que era blanco pasa a tinta. */
.editorial-hero__title, .editorial-hero__eyebrow, .editorial-hero__sound, .editorial-hero__scroll-cue {
  transition: color 600ms var(--ease), border-color 600ms var(--ease), background 600ms var(--ease);
}
.editorial-hero.is-light-frame .editorial-hero__title,
.editorial-hero.is-light-frame .editorial-hero__eyebrow,
.editorial-hero.is-light-frame .editorial-hero__scroll-cue { color: var(--ink); text-shadow: none; }
.editorial-hero.is-light-frame .editorial-hero__scroll-cue { border-color: rgba(15, 26, 46, 0.45); }
.editorial-hero.is-light-frame .editorial-hero__sound { color: var(--ink); border-color: rgba(15, 26, 46, 0.45); background: rgba(255, 255, 255, 0.45); }
.editorial-hero.is-light-frame .editorial-hero__progress { background: rgba(15, 26, 46, 0.18); }
.editorial-hero.is-light-frame .editorial-hero__progress span { background: var(--ink); }
@media (prefers-reduced-motion: reduce) { .editorial-hero__sound-bars i { animation: none !important; height: 8px; } }

.editorial-hero__scroll-cue {
  position: absolute; right: 4vw; bottom: 26px; z-index: 8;
  width: 26px; height: 42px;
  border: 0.5px solid rgba(255, 255, 255, 0.72);
  border-radius: 999px; color: var(--paper);
  opacity: calc(var(--hero-title-opacity, 0) * 0.72);
  display: grid; place-items: start center; padding-top: 8px;
}
.editorial-hero__scroll-cue span {
  display: block; width: 3px; height: 3px;
  border-radius: 999px; background: currentColor;
  animation: heroScrollDot 1600ms cubic-bezier(.22,.61,.36,1) infinite;
}
.editorial-hero__scroll-cue::after {
  content: ""; position: absolute; left: 50%; bottom: -12px;
  width: 7px; height: 7px;
  border-right: 0.5px solid currentColor; border-bottom: 0.5px solid currentColor;
  transform: translateX(-50%) rotate(45deg); opacity: 0.72;
}
@keyframes heroScrollDot {
  0% { transform: translateY(0); opacity: 0; }
  28% { opacity: 1; }
  72% { opacity: 1; }
  100% { transform: translateY(18px); opacity: 0; }
}

@media (max-width: 680px) {
  .editorial-hero { height: 100vh; }
  .editorial-hero__sticky { position: relative; }
  .editorial-hero__frame {
    clip-path: none !important;
  }
  .editorial-hero__title {
    opacity: 1 !important;
    transform: translate3d(-50%, 0, 0) !important;
    bottom: 12vh;
  }
  .editorial-hero__progress { display: none; }
  .editorial-hero__scroll-cue { display: none; }
  .editorial-hero__title h1 { font-size: 42px; }
}

@media (prefers-reduced-motion: reduce) {
  .editorial-hero__frame { clip-path: none !important; }
  .editorial-hero__title { opacity: 1 !important; transform: translate3d(-50%, 0, 0) !important; }
}

/* ==========================================================================
   v96 — Hero de la home en móvil: sin scroll-clip. La sección ocupa un
   viewport, el recorte se desactiva y el titular se muestra ya revelado, sin
   obligar a hacer scroll para leerlo. Sustituye al JS de v96, que hacía lo
   mismo escribiendo las variables a mano.
   ========================================================================== */
@media (max-width: 780px) {
  .editorial-hero {
    /* svh, no dvh: dvh cambia de valor cuando el navegador móvil pliega su barra
       y el hero se reajustaba a cada scroll. svh es fijo. */
    height: 100svh !important;
    min-height: 560px !important;
    --hero-title-opacity: 1 !important;
    --hero-progress: 1 !important;
    --hero-dim: 0.08 !important;
    --hero-media-scale: 1.025 !important;
  }

  .editorial-hero__sticky { position: relative !important; top: auto !important; height: 100svh !important; }
  .editorial-hero__frame { height: 100svh !important; clip-path: none !important; }

  .editorial-hero__title {
    opacity: 1 !important;
    transform: translate3d(-50%, 0, 0) !important;
    width: calc(100vw - 42px) !important;
    /* v101: a 42px la última línea del subtítulo quedaba bajo «Sonido» y el ancla de ayuda. */
    bottom: calc(92px + env(safe-area-inset-bottom, 0px)) !important;
  }

  .editorial-hero__title h1 { font-size: clamp(42px, 12.4vw, 64px) !important; line-height: 0.98 !important; }
  .editorial-hero__title > p { font-size: 14px !important; line-height: 1.6 !important; max-width: 420px !important; }
  .editorial-hero__eyebrow { font-size: 12px !important; letter-spacing: 0.2em !important; }

  .editorial-hero__progress,
  .editorial-hero__scroll-cue { display: none !important; }
  .editorial-hero__media { object-position: center center !important; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  const sections = document.querySelectorAll('.editorial-hero:not([data-init])');
  sections.forEach(initHero);

  function initHero(root) {
    root.dataset.init = '1';
    const isMobile = window.matchMedia('(max-width: 680px)').matches;
    if (isMobile) return; // mobile uses static hero, no scroll math

    const clamp = (n, min, max) => Math.max(min, Math.min(max, n));

    function update() {
      const rect = root.getBoundingClientRect();
      const max = Math.max(root.offsetHeight - window.innerHeight, 1);
      const raw = clamp(-rect.top / max, 0, 1);
      const dim = clamp((raw - 0.06) / 0.34, 0, 0.58);
      const titleOpacity = clamp((raw - 0.16) / 0.20, 0, 1);
      const holdProgress = clamp(raw / 0.82, 0, 1);
      const styles = document.documentElement.style;
      styles.setProperty('--hero-progress', holdProgress.toFixed(3));
      styles.setProperty('--hero-dim', dim.toFixed(3));
      styles.setProperty('--hero-title-opacity', titleOpacity.toFixed(3));
      styles.setProperty('--hero-clip-left', '0%');
      styles.setProperty('--hero-clip-right', '100%');
      styles.setProperty('--hero-clip-top', '0%');
      styles.setProperty('--hero-clip-bottom', '100%');
      styles.setProperty('--hero-media-scale', (1.04 - (raw * 0.02)).toFixed(3));
    }

    let ticking = false;
    function tick() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { update(); ticking = false; });
    }
    window.addEventListener('scroll', tick, { passive: true });
    window.addEventListener('resize', tick);
    update();
  }

  document.addEventListener('shopify:section:load', (e) => {
    e.target.querySelectorAll('.editorial-hero:not([data-init])').forEach(initHero);
  });

  // Tramos del vídeo con fondo blanco: el hero deja de pedir cabecera clara y pasa a
  // tinta oscura (título, botón, progreso) para que nada blanco quede sobre blanco.
  function initInk(hero) {
    const video = hero.querySelector('video');
    const spans = (hero.dataset.lightFrames || '').split(',').map((s) => s.split('-').map(Number))
      .filter((s) => s.length === 2 && s.every((n) => !isNaN(n)));
    if (!video || !spans.length) return;
    let light = false;
    video.addEventListener('timeupdate', () => {
      const t = video.currentTime;
      const now = spans.some(([a, b]) => t >= a && t < b);
      if (now === light) return;
      light = now;
      hero.classList.toggle('is-light-frame', light);
      if (light) hero.removeAttribute('data-header-variant');
      else hero.setAttribute('data-header-variant', 'light');
      window.dispatchEvent(new Event('scroll')); // la cabecera recalcula su tinta
    });
  }
  document.querySelectorAll('.editorial-hero[data-light-frames]').forEach(initInk);

  // Sonido del vídeo: el botón lo activa y sólo suena con el hero en pantalla.
  // Al bajar de la sección el vídeo se pausa (y calla); al volver sigue, y con
  // sonido si el visitante lo había activado. Fundidos para que no entre de golpe.
  function initSound(btn) {
    if (btn.dataset.init) return;
    btn.dataset.init = '1';
    const hero = btn.closest('.editorial-hero');
    const video = hero && hero.querySelector('video');
    if (!video) return;
    let wanted = false; // lo que eligió el visitante
    let inView = true;
    let fade;
    // ponytail: en iOS `volume` es de sólo lectura; allí el fundido no hace nada y manda `muted`.
    function ramp(to, done) {
      clearInterval(fade);
      fade = setInterval(() => {
        const before = video.volume;
        const next = before + (to > before ? 0.05 : -0.05);
        video.volume = Math.min(1, Math.max(0, next));
        // iOS ignora `volume` (sigue en 1): sin esta salida el fundido no acababa
        // nunca y el vídeo no llegaba a `muted` — el botón no silenciaba en móvil.
        if (video.volume === before || Math.abs(video.volume - to) < 0.051) {
          clearInterval(fade);
          if (video.volume !== before) video.volume = to;
          if (done) done();
        }
      }, 40);
    }
    function apply() {
      const on = wanted && inView && !document.hidden;
      if (on) {
        video.muted = false;
        ramp(1);
      } else if (!video.muted) {
        ramp(0, () => { video.muted = true; });
      }
      if (inView && !document.hidden) video.play().catch(() => {});
      else video.pause();
    }
    btn.addEventListener('click', () => {
      wanted = !wanted;
      btn.setAttribute('aria-pressed', wanted ? 'true' : 'false');
      btn.setAttribute('aria-label', wanted ? btn.dataset.labelPause : btn.dataset.labelPlay);
      if (wanted) { video.volume = 0; video.muted = false; }
      // 2026-10-05 · cliente: en móvil pulsar no silenciaba. El silencio va síncrono dentro
      // del toque, sin depender del fundido (que en iOS no hace nada con `volume`).
      else { clearInterval(fade); video.muted = true; }
      apply();
    });
    new IntersectionObserver((entries) => {
      inView = entries[entries.length - 1].isIntersecting;
      apply();
    }).observe(hero);
    document.addEventListener('visibilitychange', apply);
  }
  document.querySelectorAll('[data-hero-sound]').forEach(initSound);
  document.addEventListener('shopify:section:load', (e) => e.target.querySelectorAll('[data-hero-sound]').forEach(initSound));
})();
{% endjavascript %}

{% schema %}
{
  "name": "Editorial hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image (fallback for video, also LCP)" },
    { "type": "url", "id": "video", "label": "Hero video URL (MP4, optional)" },
    { "type": "text", "id": "demo_video", "label": "Demo video asset (filename in /assets)", "info": "Used when no Hero video URL is set. Default ships the brand film with sound.", "default": "hero-cartuja-audio.mp4" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "La Cartuja de Sevilla · 1841" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Heritage crafted for modern living</p>" },
    { "type": "richtext", "id": "subheading", "label": "Subheading", "default": "<p>La Cartuja de Sevilla presenta El Renacer: una colección que reúne memoria, oficio y mesa contemporánea desde 1841.</p>" },
    { "type": "header", "content": "Sonido" },
    { "type": "checkbox", "id": "video_sound", "label": "El vídeo tiene sonido", "info": "Muestra el botón para activarlo. Nunca suena solo y se calla al bajar de la sección.", "default": true },
    { "type": "text", "id": "sound_label", "label": "Texto del botón", "default": "Sonido" },
    { "type": "text", "id": "light_frames", "label": "Tramos claros del vídeo (segundos)", "info": "Donde el vídeo es blanco la cabecera y los textos pasan a tinta oscura. Formato 12.8-22.4, separados por comas. Vacío = siempre en blanco.", "default": "12.8-22.4" }
  ],
  "presets": [{ "name": "Editorial hero" }]
}
{% endschema %}
