<aside class="mega" id="megaMenu" aria-hidden="true">
  <div class="mega-inner">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

      {%- when 'column' -%}
        {%- assign linklist = linklists[block.settings.menu] -%}
        <div {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading | escape }}</h3>
          <ul>
            {%- if linklist.links.size > 0 -%}
              {%- for link in linklist.links -%}
                <li><a class="mega-row{% if link.current %} is-current{% endif %}" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}><span>{{ link.title }}</span></a></li>
              {%- endfor -%}
            {%- elsif block.settings.items != blank -%}
              {%- comment -%} Demo items: one per line, "Label | meta | url" (meta + url optional). {%- endcomment -%}
              {%- assign lines = block.settings.items | strip | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                {%- assign row = line | strip -%}
                {%- if row == blank -%}{%- continue -%}{%- endif -%}
                {%- assign parts = row | split: '|' -%}
                {%- assign label = parts[0] | strip -%}
                {%- assign meta = '' -%}
                {%- assign url = '' -%}
                {%- if parts.size > 1 -%}{%- assign meta = parts[1] | strip -%}{%- endif -%}
                {%- if parts.size > 2 -%}{%- assign url = parts[2] | strip -%}{%- endif -%}
                {%- if url != blank -%}
                  {%- assign is_current = false -%}
                  {%- if url == request.path -%}{%- assign is_current = true -%}{%- endif -%}
                  <li><a class="mega-row{% if is_current %} is-current{% endif %}" href="{{ url }}"{% if is_current %} aria-current="page"{% endif %}><span>{{ label | escape }}</span>{%- if meta != blank -%}<span aria-hidden="true">{{ meta | escape }}</span>{%- endif -%}</a></li>
                {%- else -%}
                  <li><span class="mega-row"><span>{{ label | escape }}</span>{%- if meta != blank -%}<span aria-hidden="true">{{ meta | escape }}</span>{%- endif -%}</span></li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>

      {%- when 'feature_card' -%}
        <div class="mega-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {% render 'image-responsive', image: block.settings.image, alt: block.settings.image.alt, sizes: '(max-width: 1100px) 100vw, 25vw' %}
          {%- else -%}
            {%- comment -%} Demo fallback (shipped in /assets) until an image is set. {%- endcomment -%}
            <img src="{{ 'craft.webp' | asset_url }}" alt="{{ block.settings.text | escape }}" width="1450" height="1800" loading="lazy" decoding="async">
          {%- endif -%}
          <p>{{ block.settings.text | escape }}</p>
          {%- if block.settings.link != blank -%}
            <a class="cta" href="{{ block.settings.link }}">{{ block.settings.link_label | default: 'Descubrir' | escape }} <span aria-hidden="true">→</span></a>
          {%- endif -%}
        </div>

      {%- endcase -%}
    {%- endfor -%}
  </div>
</aside>

{% stylesheet %}
.mega {
  position: fixed;
  z-index: 70;
  top: var(--header-h);
  left: 0;
  right: 0;
  background: var(--paper);
  color: var(--ink);
  border-bottom: 0.5px solid var(--rule);
  transform: translate3d(0, -112%, 0);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: transform 680ms var(--ease-long), opacity 360ms var(--ease), visibility 0s linear 680ms;
  box-shadow: 0 20px 60px rgba(15, 26, 46, 0.06);
}

.menu-open .mega {
  transform: translate3d(0, 0, 0);
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transition: transform 680ms var(--ease-long), opacity 360ms var(--ease), visibility 0s linear 0s;
}

.mega-inner {
  width: var(--content-wide);
  margin: 0 auto;
  padding: 42px 0 46px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(280px, 1.1fr);
  gap: 42px;
  align-items: start;
}

/* Filete vertical entre columnas; la última de texto no lo lleva. */
.mega-inner > div:not(.mega-card) {
  border-right: 0.5px solid rgba(15, 26, 46, 0.10);
  padding-right: 30px;
}

.mega-inner > div:not(.mega-card):last-child,
.mega-inner > div:has(+ .mega-card) { border-right: 0; padding-right: 0; }

.mega h3 {
  font-family: var(--serif);
  font-size: clamp(22px, 1.7vw, 28px);
  font-weight: 400;
  line-height: 1;
  margin: 0 0 18px;
}

.mega ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 0;
}

.mega li {
  border-top: 0.5px solid rgba(15, 26, 46, 0.10);
  margin: 0;
  padding: 0;
}

.mega li:last-child { border-bottom: 0.5px solid rgba(15, 26, 46, 0.10); }

.mega-row {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 9px 0;
  color: var(--ink-soft);
  font-size: 13px;
  line-height: 1.35;
  letter-spacing: 0.055em;
  transition: color 280ms var(--ease);
}

.mega-row > span {
  transition: transform 380ms var(--ease);
}

/* Rótulos largos ("Negro Vistas by ASH Yellow") mandan sobre la meta. */
.mega-row > span:first-child { min-width: 0; }

.mega-row > span:last-child:not(:first-child) {
  flex: 0 0 auto;
  font-size: 11px;
  letter-spacing: 0.12em;
  color: var(--muted);
}

/* Punto de marca que entra por la izquierda al pasar por encima. */
.mega-row::before {
  content: "";
  position: absolute;
  left: -12px;
  top: 50%;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--brand);
  opacity: 0;
  transform: translate(-6px, -50%) scale(0.6);
  transition: opacity 300ms var(--ease), transform 380ms var(--ease);
}

a.mega-row:hover > span:first-child,
a.mega-row:focus-visible > span:first-child,
.mega-row.is-current > span:first-child { transform: translateX(6px); }

a.mega-row:hover::before,
a.mega-row:focus-visible::before,
.mega-row.is-current::before { opacity: 1; transform: translate(0, -50%) scale(1); }

.mega-card {
  align-self: start;
  background: var(--ink-faint-20);
  padding: 12px;
  overflow: hidden;
}

.mega-card img {
  width: 100%;
  height: 160px;
  object-fit: cover;
  display: block;
}

.mega-card p {
  font-family: var(--serif);
  font-size: 23px;
  line-height: 1.02;
  margin: 15px 0 13px;
  max-width: 15ch;
  color: var(--ink);
}

.mega-card .cta { font-size: 12px; letter-spacing: 0.17em; }

@media (prefers-reduced-motion: reduce) {
  .mega-row,
  .mega-row > span,
  .mega-row::before { transition: none; }
}

@media (max-width: 1000px) {
  .mega-inner { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .mega-inner > div:not(.mega-card) { border-right: 0; padding-right: 0; }
}

@media (max-width: 680px) {
  .mega { top: var(--header-h); }
  .mega-inner { grid-template-columns: 1fr; padding: 32px 0; gap: 28px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Mega menu",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Column heading", "default": "Producto" },
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "textarea", "id": "items", "label": "Items (one per line: 'Label | meta')", "info": "Used when no menu is selected. The optional text after | is the right-side meta label; omit it for no second column." }
      ]
    },
    {
      "type": "feature_card",
      "name": "Feature card",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "text", "label": "Text", "default": "Heritage crafted for modern living" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Descubrir historia" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mega menu",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" },
        { "type": "feature_card" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
