<aside class="mega" id="megaMenu" aria-hidden="true">
  <div class="mega-inner">
    {%- for block in section.blocks -%}
      {%- case block.type -%}

      {%- when 'column' -%}
        {%- assign linklist = linklists[block.settings.menu] -%}
        <div {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading | escape }}</h3>
          <ul>
            {%- if linklist.links.size > 0 -%}
              {%- for link in linklist.links -%}
                <li><a class="mega-row{% if link.current %} is-current{% endif %}" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}><span>{{ link.title }}</span></a></li>
              {%- endfor -%}
            {%- elsif block.settings.items != blank -%}
              {%- comment -%} Demo items: one per line, "Label | meta | url" (meta + url optional). {%- endcomment -%}
              {%- assign lines = block.settings.items | strip | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                {%- assign row = line | strip -%}
                {%- if row == blank -%}{%- continue -%}{%- endif -%}
                {%- assign parts = row | split: '|' -%}
                {%- assign label = parts[0] | strip -%}
                {%- comment -%} Un «!» delante del rótulo lo pinta en acento (Fin de existencias). {%- endcomment -%}
                {%- assign is_flag = false -%}
                {%- if label contains '!' -%}
                  {%- assign is_flag = true -%}
                  {%- assign label = label | remove_first: '!' | strip -%}
                {%- endif -%}
                {%- assign meta = '' -%}
                {%- assign url = '' -%}
                {%- if parts.size > 1 -%}{%- assign meta = parts[1] | strip -%}{%- endif -%}
                {%- if parts.size > 2 -%}{%- assign url = parts[2] | strip -%}{%- endif -%}
                {%- if url != blank -%}
                  {%- assign is_current = false -%}
                  {%- if url == request.path -%}{%- assign is_current = true -%}{%- endif -%}
                  <li><a class="mega-row{% if is_current %} is-current{% endif %}{% if is_flag %} mega-row--flag{% endif %}" href="{{ url }}"{% if is_current %} aria-current="page"{% endif %}><span>{{ label | escape }}</span>{%- if meta != blank -%}<span aria-hidden="true">{{ meta | escape }}</span>{%- endif -%}</a></li>
                {%- else -%}
                  <li><span class="mega-row{% if is_flag %} mega-row--flag{% endif %}"><span>{{ label | escape }}</span>{%- if meta != blank -%}<span aria-hidden="true">{{ meta | escape }}</span>{%- endif -%}</span></li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>

      {%- when 'feature_card' -%}
        {%- comment -%} Tarjeta con foto a sangre, degradado y texto abajo; si hay enlace, toda la tarjeta es el enlace. {%- endcomment -%}
        {%- if block.settings.link != blank -%}<a class="mega-card" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{%- else -%}<div class="mega-card" {{ block.shopify_attributes }}>{%- endif -%}
          {%- if block.settings.image != blank -%}
            {% render 'image-responsive', image: block.settings.image, alt: '', sizes: '(max-width: 1050px) 100vw, 25vw' %}
          {%- else -%}
            {%- comment -%} Demo fallback (shipped in /assets) until an image is set. {%- endcomment -%}
            <img src="{{ 'menu-heritage-menu.webp' | asset_url }}" alt="" width="1536" height="1024" loading="lazy" decoding="async">
          {%- endif -%}
          <span class="mega-card__copy">
            <small>{{ shop.name }}</small>
            <strong>{{ block.settings.text | escape }}</strong>
            {%- if block.settings.link != blank -%}<em>{{ block.settings.link_label | default: 'Descubrir' | escape }} →</em>{%- endif -%}
          </span>
        {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}

      {%- endcase -%}
    {%- endfor -%}
  </div>
</aside>

{% stylesheet %}
.mega {
  position: fixed;
  z-index: 70;
  top: var(--header-h);
  left: 0;
  right: 0;
  background: var(--paper);
  color: var(--ink);
  border-bottom: 0.5px solid var(--rule);
  transform: translate3d(0, -112%, 0);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: transform 680ms var(--ease-long), opacity 360ms var(--ease), visibility 0s linear 680ms;
  box-shadow: 0 20px 60px rgba(15, 26, 46, 0.06);
}

.menu-open .mega {
  transform: translate3d(0, 0, 0);
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
  transition: transform 680ms var(--ease-long), opacity 360ms var(--ease), visibility 0s linear 0s;
}

.mega-inner {
  width: var(--content-wide);
  margin: 0 auto;
  padding: 35px 0 38px;
  display: grid;
  grid-template-columns: 1fr 1.06fr 1.05fr 1.18fr;
  gap: 28px 38px;
  align-items: stretch;
}

/* Filete vertical entre columnas; la última de texto no lo lleva. */
.mega-inner > div:not(.mega-card) {
  border-right: 0.5px solid var(--rule);
  padding-right: 27px;
}

.mega-inner > div:not(.mega-card):last-child,
.mega-inner > div:has(+ .mega-card) { border-right: 0; padding-right: 0; }

.mega h3 {
  font-family: var(--serif);
  font-size: 25px;
  font-weight: 400;
  line-height: 1;
  letter-spacing: -0.01em;
  margin: 0 0 13px;
}

.mega ul {
  list-style: none;
  margin: 0;
  padding: 0;
}

.mega li {
  border-bottom: 0.5px solid rgba(15, 26, 46, 0.12);
  margin: 0;
  padding: 0;
}

.mega-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 28px;
  padding: 6px 0;
  color: var(--ink);
  font-size: 12px;
  line-height: 1.25;
  letter-spacing: 0.035em;
  transition: padding 240ms var(--ease), color 240ms var(--ease);
}

/* Rótulos largos ("Negro Vistas by ASH Yellow") mandan sobre la meta. */
.mega-row > span:first-child { min-width: 0; }

.mega-row > span:last-child:not(:first-child) {
  flex: 0 0 auto;
  font-size: 8.5px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  white-space: nowrap;
  color: var(--muted);
}

/* Flecha que entra por la derecha al pasar por encima. */
a.mega-row::after {
  content: "→";
  font-size: 11px;
  opacity: 0;
  transform: translateX(-5px);
  transition: opacity 240ms var(--ease), transform 240ms var(--ease);
}

a.mega-row:hover,
a.mega-row:focus-visible,
.mega-row.is-current { padding-left: 6px; color: var(--brand); }

a.mega-row:hover::after,
a.mega-row:focus-visible::after,
.mega-row.is-current::after { opacity: 1; transform: none; }

.mega-row--flag { color: var(--accent-1); }

/* Tarjeta con foto: imagen a sangre, degradado y texto abajo a la izquierda. */
.mega-card {
  position: relative;
  display: block;
  min-height: 220px;
  overflow: hidden;
  background: #d7d3cd;
  isolation: isolate;
  color: var(--paper);
}

.mega-card img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.mega-card::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(180deg, rgba(15, 26, 46, 0.01) 30%, rgba(15, 26, 46, 0.78) 100%);
}

.mega-card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  border: 0 solid rgba(255, 255, 255, 0.45);
  transition: border-width 350ms var(--ease);
}

a.mega-card:hover::before { border-width: 6px; }

.mega-card__copy {
  position: absolute;
  z-index: 2;
  left: 17px;
  right: 17px;
  bottom: 16px;
}

.mega-card__copy small {
  display: block;
  margin-bottom: 5px;
  font-size: 8px;
  line-height: 1.3;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.78);
}

.mega-card__copy strong {
  display: block;
  font-family: var(--serif);
  font-size: 21px;
  line-height: 1.02;
  font-weight: 400;
}

.mega-card__copy em {
  display: inline-block;
  margin-top: 11px;
  padding-bottom: 4px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.75);
  font-style: normal;
  font-size: 8.5px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

@media (prefers-reduced-motion: reduce) {
  .mega-row,
  a.mega-row::after,
  .mega-card::before { transition: none; }
}

/* Por debajo de 1050px manda el cajón móvil (snippets/mobile-drawer). */
@media (max-width: 1050px) {
  .mega { display: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Mega menu",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "heading", "label": "Column heading", "default": "Producto" },
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "textarea", "id": "items", "label": "Items (one per line: 'Label | meta')", "info": "Used when no menu is selected. The optional text after | is the right-side meta label; omit it for no second column." }
      ]
    },
    {
      "type": "feature_card",
      "name": "Feature card",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "text", "label": "Text", "default": "Heritage crafted for modern living" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Descubrir historia" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mega menu",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" },
        { "type": "feature_card" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
