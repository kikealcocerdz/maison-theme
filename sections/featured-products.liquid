{%- liquid
  assign cards_per_row = section.settings.cards_per_row | default: 3
  assign collection_handle = section.settings.collection
  assign collection_obj = collections[collection_handle]
  assign show_arrows = section.settings.show_arrows
  assign auto_from_collection = false
  if collection_obj != blank and collection_obj.products.size > 0
    assign auto_from_collection = true
  endif
-%}

<section class="featured-products {% if section.settings.soft_bg %}soft-bg{% endif %}" data-section-id="{{ section.id }}" data-cards-per-row="{{ cards_per_row }}">
  {%- if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.description != blank -%}
    <div class="section-head reveal">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.description != blank -%}{{ section.settings.description }}{%- endif -%}
    </div>
  {%- endif -%}

  <div class="featured-products__window reveal">
    {%- if show_arrows -%}
      <button class="nav-arrow nav-arrow--left" data-carousel-prev aria-label="{{ 'general.accessibility.previous' | t }}">{% render 'icon-arrow-left' %}</button>
    {%- endif -%}
    <div class="featured-products__viewport">
      <div class="featured-products__track" data-carousel-track>
        {%- if auto_from_collection -%}
          {%- for product in collection_obj.products limit: 12 -%}
            <article class="featured-products__card">
              <a href="{{ product.url }}" class="block-product-card__link">
                <div class="block-product-card__media block-product-card__media--portrait">
                  {%- if product.featured_image -%}
                    {% render 'image-responsive', image: product.featured_image, alt: product.title, sizes: '(max-width: 680px) 50vw, 25vw' %}
                  {%- endif -%}
                </div>
                {%- assign meta = product.metafields.custom.meta_line | metafield_text -%}
                {%- if meta != blank -%}<p class="block-product-card__meta">{{ meta | escape }}</p>{%- endif -%}
                <h3 class="block-product-card__title">{{ product.title | escape }}</h3>
                <span class="block-product-card__price">{{ product.price | money }}</span>
              </a>
              {% render 'quick-add', product: product %}
            </article>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            <div class="featured-products__card" {{ block.shopify_attributes }}>
              {%- render block -%}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
    {%- if show_arrows -%}
      <button class="nav-arrow nav-arrow--right" data-carousel-next aria-label="{{ 'general.accessibility.next' | t }}">{% render 'icon-arrow-right' %}</button>
    {%- endif -%}
  </div>

  {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
    <div class="featured-products__cta reveal">
      <a href="{{ section.settings.cta_link }}" class="ghost-btn">{{ section.settings.cta_label | escape }}</a>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
.featured-products { padding: 42px 0 142px; }
.featured-products.soft-bg { padding: clamp(24px, 3vh, 36px) 0 152px; }
.featured-products.soft-bg .section-head { margin-bottom: 18px; }
.featured-products__window { position: relative; width: var(--content); margin: 0 auto; }
.featured-products__viewport {
  overflow-x: auto; overflow-y: hidden;
  overscroll-behavior-x: contain;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}
.featured-products__viewport::-webkit-scrollbar { display: none; }
.featured-products__track { display: flex; cursor: grab; -webkit-user-select: none; user-select: none; }
.featured-products__track.is-dragging { cursor: grabbing; }
.featured-products__track.is-dragging a { pointer-events: none; }
.featured-products__card { position: relative; flex: 0 0 calc(100% / 3); padding: 0 18px; text-align: center; }

/* Auto-fill cards (collection source) reuse .block-product-card__* markup but NOT
   blocks/product-card.liquid's stylesheet — that only ships when the block itself is
   rendered. Without this the img keeps its width/height attributes and comes out
   stretched, so mirror the block's card styles here. Keep both in sync. */
.featured-products__card .block-product-card__link { display: block; }
.featured-products__card .block-product-card__media {
  position: relative; overflow: hidden; background: transparent;
  display: grid; place-items: center;
}
.featured-products__card .block-product-card__media--portrait { aspect-ratio: 4/5; }
.featured-products__card .block-product-card__media::after {
  content: ""; position: absolute; width: 44%; height: 28px; bottom: 44px; left: 28%;
  background: radial-gradient(ellipse, rgba(15, 26, 46, 0.12), transparent 68%);
  filter: blur(9px);
}
.featured-products__card .block-product-card__media img {
  width: auto; height: auto; max-width: 80%; max-height: 300px;
  object-fit: contain; position: relative; z-index: 2;
  transition: transform 700ms var(--ease); will-change: transform;
}
.featured-products__card:hover .block-product-card__media img { transform: translateY(-6px) scale(1.03); }
.featured-products__card .block-product-card__meta {
  font-family: var(--sans); font-weight: 400; font-size: 10px; letter-spacing: 0.22em;
  text-transform: uppercase; color: var(--muted); margin: 0;
}
.featured-products__card .block-product-card__title {
  font-family: var(--serif); font-weight: 400; font-size: 16px; line-height: 1.2;
  color: var(--ink); margin: 14px 0 4px;
}
.featured-products__card .block-product-card__price {
  display: block; margin-top: 4px; font-family: var(--sans); font-weight: 300; font-size: 13px;
  color: var(--ink-soft);
}
@media (prefers-reduced-motion: reduce) {
  .featured-products__card:hover .block-product-card__media img { transform: none; }
}

.featured-products[data-cards-per-row="2"] .featured-products__card { flex-basis: 50%; }
.featured-products[data-cards-per-row="4"] .featured-products__card { flex-basis: 25%; }

/* 4-up cards are smaller than the 3-up bestsellers (matches mockup .mini-product) */
.featured-products[data-cards-per-row="4"] .featured-products__card .block-product-card__media img { max-height: 235px; }
.featured-products[data-cards-per-row="4"] .featured-products__card .block-product-card__media::after { height: 24px; bottom: 34px; }
.featured-products[data-cards-per-row="4"] .featured-products__card .block-product-card__title { margin-top: 14px; }

.featured-products__cta { width: var(--content); margin: 74px auto 0; text-align: center; }

.nav-arrow {
  position: absolute; top: 50%; transform: translateY(-50%);
  width: 44px; height: 44px;
  border: 0.5px solid var(--ink); border-radius: 999px;
  background: transparent; display: grid; place-items: center;
  color: var(--ink); transition: all 240ms var(--ease); z-index: 3;
}
.nav-arrow:hover { transform: translateY(-50%) scale(1.08); }
.nav-arrow--left { left: -64px; }
.nav-arrow--right { right: -64px; }

@media (max-width: 1100px) {
  .featured-products__card { flex-basis: 50%; }
  .nav-arrow--left { left: 6px; }
  .nav-arrow--right { right: 6px; }
}

@media (max-width: 680px) {
  .featured-products { padding-top: 0; padding-bottom: 82px; }
  .featured-products.soft-bg { padding-top: 24px; padding-bottom: 82px; }
  .featured-products__viewport { overflow: visible; }
  .featured-products__track {
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 14px;
    transform: none !important;
  }
  .featured-products__card { flex: initial !important; padding: 0 !important; min-width: 0; }
  .featured-products__card:nth-child(n+5) { display: none; }
  .featured-products__card .block-product-card__media img {
    max-height: 190px; max-width: 86%; margin-left: auto; margin-right: auto;
  }
  .nav-arrow { display: none; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  const section = document.currentScript.previousElementSibling?.closest('.featured-products') || document.querySelector('.featured-products:not([data-init])');
  document.querySelectorAll('.featured-products:not([data-init])').forEach(initCarousel);

  function initCarousel(root) {
    root.dataset.init = '1';
    const track = root.querySelector('[data-carousel-track]');
    const viewport = track && track.parentElement;
    const prev = root.querySelector('[data-carousel-prev]');
    const next = root.querySelector('[data-carousel-next]');
    if (!track || !viewport) return;

    const cardW = () => {
      const c = track.firstElementChild;
      return c ? c.getBoundingClientRect().width : viewport.clientWidth;
    };

    // Infinite loop: clone the set before + after, scroll lives in the middle copy.
    // ponytail: desktop carousel only — mobile is a static grid, so we skip cloning
    // (it would duplicate the grid). No re-clone on breakpoint resize.
    let loop = false, setW = 0;
    if (window.matchMedia('(min-width: 681px)').matches && track.children.length > 1) {
      const originals = [...track.children];
      originals.forEach(c => { const cl = c.cloneNode(true); cl.setAttribute('aria-hidden', 'true'); track.appendChild(cl); });
      for (let i = originals.length - 1; i >= 0; i--) { const cl = originals[i].cloneNode(true); cl.setAttribute('aria-hidden', 'true'); track.insertBefore(cl, track.firstChild); }
      requestAnimationFrame(() => {
        setW = originals.reduce((s, c) => s + c.getBoundingClientRect().width, 0);
        if (setW > viewport.clientWidth) { loop = true; viewport.scrollLeft = setW; }
      });
      viewport.addEventListener('scroll', () => {
        if (!loop) return;
        if (viewport.scrollLeft >= setW * 2) viewport.scrollLeft -= setW;
        else if (viewport.scrollLeft < setW) viewport.scrollLeft += setW;
      });
    }

    // Arrows nudge one card; native smooth scroll handles the glide.
    prev && prev.addEventListener('click', () => viewport.scrollBy({ left: -cardW(), behavior: 'smooth' }));
    next && next.addEventListener('click', () => viewport.scrollBy({ left: cardW(), behavior: 'smooth' }));

    // Mouse drag with kinetic inertia (free glide, no snap). Touch uses native momentum.
    let down = false, startX = 0, startLeft = 0, moved = false, lastX = 0, lastT = 0, vx = 0, raf = 0;
    const maxLeft = () => viewport.scrollWidth - viewport.clientWidth;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') return;            // native touch scroll
      if (e.button !== 0) return;
      cancelAnimationFrame(raf);
      down = true; moved = false; startX = lastX = e.clientX; startLeft = viewport.scrollLeft;
      vx = 0; lastT = performance.now();
    });
    track.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 5 && !moved) {
        // Real drag started — capture now (NOT on pointerdown, or a plain
        // click would target the track instead of the card's <a> and never navigate).
        moved = true;
        track.setPointerCapture?.(e.pointerId);
        track.classList.add('is-dragging');
      }
      viewport.scrollLeft = startLeft - dx;
      const now = performance.now(), dt = now - lastT || 16;
      vx = (e.clientX - lastX) / dt;                    // px per ms (signed)
      lastX = e.clientX; lastT = now;
    });
    const end = (e) => {
      if (!down) return;
      down = false;
      track.releasePointerCapture?.(e.pointerId);
      track.classList.remove('is-dragging');
      let v = -vx * 16;                                 // px per frame, continues the flick
      const glide = () => {
        v *= 0.94;                                      // friction
        viewport.scrollLeft += v;
        const at = viewport.scrollLeft;
        if (Math.abs(v) > 0.4 && at > 0 && at < maxLeft()) raf = requestAnimationFrame(glide);
      };
      if (moved && Math.abs(v) > 0.4) raf = requestAnimationFrame(glide);
    };
    track.addEventListener('pointerup', end);
    track.addEventListener('pointercancel', end);
    // Block native image/link drag so a press-drag scrolls instead of ghost-dragging an image.
    track.addEventListener('dragstart', (e) => e.preventDefault());
    // Swallow only the click that ends a real drag; `moved` resets on every pointerdown.
    track.addEventListener('click', (e) => {
      if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; }
    }, true);
  }

  document.addEventListener('shopify:section:load', (e) => {
    e.target.querySelectorAll('.featured-products:not([data-init])').forEach(initCarousel);
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Featured products",
  "max_blocks": 12,
  "blocks": [
    { "type": "product-card" },
    { "type": "text" },
    { "type": "button" }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Emblemas de la casa" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "richtext", "id": "description", "label": "Description" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection (optional — overrides blocks)",
      "info": "If set, products auto-populate from this collection (up to 12) and manual blocks are ignored."
    },
    {
      "type": "range",
      "id": "cards_per_row",
      "label": "Cards per row (desktop)",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    { "type": "checkbox", "id": "show_arrows", "label": "Show navigation arrows", "default": true },
    { "type": "checkbox", "id": "soft_bg", "label": "Soft background", "default": false },
    { "type": "header", "content": "Footer CTA (optional)" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_link", "label": "CTA link" }
  ],
  "presets": [
    {
      "name": "Featured products (3-up)",
      "settings": { "cards_per_row": 3, "soft_bg": true },
      "blocks": [
        { "type": "product-card" },
        { "type": "product-card" },
        { "type": "product-card" }
      ]
    },
    {
      "name": "Featured products (4-up)",
      "settings": { "cards_per_row": 4, "soft_bg": false },
      "blocks": [
        { "type": "product-card" },
        { "type": "product-card" },
        { "type": "product-card" },
        { "type": "product-card" }
      ]
    }
  ]
}
{% endschema %}
