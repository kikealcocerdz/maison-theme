.vt-page .guide-media-label { position: absolute; left: 22px; bottom: 22px; z-index: 5; display: inline-flex; align-items: center; gap: 12px; padding: 10px 15px 10px 10px; border-radius: 999px; background: rgba(255, 255, 255, .78); border: .5px solid rgba(255, 255, 255, .58); backdrop-filter: blur(14px); color: var(--ink); box-shadow: 0 18px 44px rgba(15, 26, 46, .16); }
.vt-page .guide-media-label span { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 50%; background: var(--ink); color: #fff; font-family: var(--serif); font-size: 15px; }
.vt-page .guide-media-label b { font-weight: 500; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; }
.vt-page .result-match .match-number { min-width: 72px; text-align: right; font-variant-numeric: tabular-nums; letter-spacing: .01em; }
