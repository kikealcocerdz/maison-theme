/* ===== v58 · Guía por imágenes + ajustes de resultado ===== */
.vt-page .guide-visual { background: #EDE8DE; box-shadow: inset 0 0 0 1px rgba(15, 26, 46, .08), 0 24px 80px rgba(15, 26, 46, .08); }
.vt-page .guide-visual:before { inset: 0; border: 0; border-radius: 36px; background: linear-gradient(180deg, rgba(255, 255, 255, .12), rgba(15, 26, 46, .10)); z-index: 3; pointer-events: none; }
.vt-page .guide-visual:after { content: ""; position: absolute; inset: 0; width: auto; aspect-ratio: auto; border-radius: 36px; background: radial-gradient(circle at 50% 38%, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0) 46%, rgba(15, 26, 46, .22) 100%); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .16); z-index: 4; pointer-events: none; }
.vt-page .guide-image-panel { position: absolute; inset: 0; opacity: 0; transform: scale(1.035); transition: opacity 560ms var(--ease), transform 1050ms var(--ease-long), filter 650ms var(--ease); z-index: 1; filter: saturate(.92) contrast(.98); }
.vt-page .guide-image-panel.is-active { opacity: 1; transform: scale(1); filter: saturate(1) contrast(1); }
.vt-page .guide-image-panel img { width: 100%; height: 100%; object-fit: cover; display: block; }
.vt-page .guide-image-panel[data-guide-image="base"] img { object-position: center center; }
.vt-page .guide-image-panel[data-guide-image="capas"] img { object-position: center center; }
.vt-page .guide-image-panel[data-guide-image="gesto"] img { object-position: center center; }
