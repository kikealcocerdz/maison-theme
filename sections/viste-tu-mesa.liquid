        ], collectionUrl: '/collections/oaxaca', featuredUrl: '/collections/oaxaca'
      },
      'gifts-decor': {
        name: 'Gifts & Decor', tag: 'Objeto · Anfitrión', eyebrow: 'Completar la mesa', ambient: 'assets/gifts_decor_arch.webp', plate: 'assets/catalog/gifts-decor/bandeja-vistas-cibeles-azul.webp',
        reason: 'Las piezas que hacen que una mesa funcione de verdad: bandejas, objetos de servicio y detalles decorativos.',
        products: [
          { n: 'Bandeja decorativa', p: '110 €', img: 'assets/catalog/gifts-decor/bandeja-vistas-cibeles-azul.webp' },
          { n: 'Cabeza frenológica', p: '220 €', img: 'assets/catalog/gifts-decor/cabeza-frenologica.webp' },
          { n: 'Florero Alhambra', p: '160 €', img: 'assets/catalog/gifts-decor/florero-alhambra-azul-grande.webp' }
        ], collectionUrl: '/collections/gifts-decor', featuredUrl: '/collections/gifts-decor'
      }
    };

    var SCORE = {
      occasion: {
        desayuno:      { 'aurora-blanca': 4, 'rosa-202': 2, 'bellavista': 1 },
        aperitivo:     { 'gifts-decor': 4, 'ochavada-blanca': 2, 'oaxaca': 1 },
        comidaFormal:  { 'rosa-202': 3, 'bellavista': 3, 'aurora-blanca': 2 },
        cenaEspecial:  { 'negro-vistas': 4, 'ochavada-blanca': 2, 'rosa-202': 2 }
      },
      space: {
        luminoso:      { 'aurora-blanca': 3, 'rosa-202': 3, 'bellavista': 1 },
        clasico:       { 'rosa-202': 4, 'bellavista': 2, 'gifts-decor': 1 },
        contemporaneo: { 'ochavada-blanca': 4, 'negro-vistas': 3, 'aurora-blanca': 1 },
        jardin:        { 'oaxaca': 4, 'bellavista': 4, 'aurora-blanca': 1 }
      },
      base: {
        woodLight: { 'aurora-blanca': 2, 'bellavista': 2, 'rosa-202': 1 },
        woodDark:  { 'negro-vistas': 3, 'ochavada-blanca': 1, 'oaxaca': 1 },
        stone:     { 'ochavada-blanca': 3, 'aurora-blanca': 3 },
        graphite:  { 'negro-vistas': 4, 'ochavada-blanca': 2 }
      },
      textil: {
        none:       { 'ochavada-blanca': 3, 'negro-vistas': 2, 'aurora-blanca': 1 },
        linenWhite: { 'aurora-blanca': 3, 'ochavada-blanca': 2, 'rosa-202': 1 },
        linenBeige: { 'bellavista': 3, 'oaxaca': 2, 'aurora-blanca': 1 },
        blueSoft:   { 'bellavista': 3, 'aurora-blanca': 2 },
        dark:       { 'negro-vistas': 3, 'ochavada-blanca': 2 }
      },
      style: {
        clasico:       { 'rosa-202': 4, 'bellavista': 2 },
        contemporaneo: { 'ochavada-blanca': 4, 'negro-vistas': 3 },
        mediterraneo:  { 'oaxaca': 4, 'bellavista': 3 },
        sobrio:        { 'ochavada-blanca': 3, 'aurora-blanca': 3, 'negro-vistas': 1 }
      },
      presence: {
        sutil:        { 'aurora-blanca': 3, 'ochavada-blanca': 2 },
        equilibrada:  { 'bellavista': 2, 'rosa-202': 2, 'aurora-blanca': 1 },
        protagonista: { 'negro-vistas': 3, 'oaxaca': 3, 'rosa-202': 2 }
      }
    };

    var answers = {};
    var stepIndex = 0;
    var totalSteps = QUESTIONS.length;
    var panel = $('#wzPanel');
    var progress = $('#wzProgress');
    if (panel && progress) {
      QUESTIONS.forEach(function (Q, i) {
        var step = document.createElement('div');
        step.className = 'wz-step' + (i === 0 ? ' active' : '');
        step.dataset.step = i;
        var opts = Q.options.map(function (o) {
          var sw = o.swatch ? '<span class="swatch" style="background:' + o.swatch + '"></span>' : '';
          return '<button class="wz-opt" type="button" role="radio" aria-checked="false" aria-pressed="false" data-key="' + Q.key + '" data-id="' + o.id + '">' + sw + '<span>' + o.label + '</span></button>';
        }).join('');
        step.innerHTML = '<span class="wz-q-no">Paso ' + (i + 1) + ' de ' + totalSteps + '</span><h3>' + Q.q + '</h3><div class="wz-options" role="radiogroup" aria-label="' + Q.q + '">' + opts + '</div><div class="wz-actions"><button class="wz-back" type="button" data-back ' + (i === 0 ? 'disabled' : '') + '>← Atrás</button><span class="wz-hint">Elige una opción para continuar</span></div>';
        panel.appendChild(step);
        var bar = document.createElement('span');
        if (i === 0) bar.className = 'active';
        progress.appendChild(bar);
      });
    }

    var steps = $$('.wz-step');
    var bars = $$('#wzProgress span');
    function showStep(i) {
      stepIndex = clamp(i, 0, totalSteps - 1);
      steps.forEach(function (s, idx) { s.classList.toggle('active', idx === stepIndex); });
      bars.forEach(function (b, idx) { b.className = idx < stepIndex ? 'done' : (idx === stepIndex ? 'active' : ''); });
      if (stepIndex > 0 && window.innerWidth <= 1024) {
        var top = $('#wizard').getBoundingClientRect().top + window.scrollY - 90;
        window.scrollTo({ top: top, behavior: scrollBehavior });
      }
    }

    var stage = $('#wzStage');
    var elPhoto = $('#wzPhoto');
    var elCaption = $('#wzCaption');
    var currentPhoto = elPhoto ? elPhoto.getAttribute('src') : '';

    function labelFor(key, id) {
      var Q = QUESTIONS.filter(function (q) { return q.key === key; })[0];
      var o = Q && Q.options.filter(function (x) { return x.id === id; })[0];
      return o ? o.label : id;
    }

    function getPhoto() {
      var occasion = answers.occasion || 'desayuno';
      var space = answers.space || 'luminoso';
      var root = FORM_IMAGES[occasion] || FORM_IMAGES.desayuno;

      // Línea completamente desarrollada: Desayuno lento + Jardín/terraza + base + textil.
      if (occasion === 'desayuno' && space === 'jardin') {
        var base = answers.base || 'woodLight';
        var textil = answers.textil || 'default';
        var branch = root.jardin[base] || root.jardin.woodLight;
        return branch[textil] || branch.default || root.jardin.default || root.default;
      }

      // Resto de espacios de Desayuno: imagen editorial ya preparada.
      if (occasion === 'desayuno' && typeof root[space] === 'string') return root[space];

      // Resto de ocasiones: vista orientativa, manteniendo la transición y los efectos finales.
      if (typeof FORM_IMAGES.desayuno[space] === 'string') return FORM_IMAGES.desayuno[space];
      return FORM_IMAGES.default;
    }

    function setPhoto(src) {
      src = resolve(src);
      if (!elPhoto || !src || src === currentPhoto) return;
      currentPhoto = src;
      elPhoto.classList.add('is-changing');
      var next = new Image();
      next.onload = function () {
        elPhoto.src = src;
        requestAnimationFrame(function () { elPhoto.classList.remove('is-changing'); });
      };
      next.onerror = function () { elPhoto.classList.remove('is-changing'); };
      next.src = src;
    }

    function updatePreview() {
      if (!stage) return;
      stage.dataset.style = answers.style || '';
      stage.dataset.presence = answers.presence || '';
      setPhoto(getPhoto());

      var labels = [];
      ['occasion', 'space', 'base', 'textil', 'style', 'presence'].forEach(function (key) {
        if (answers[key]) labels.push(labelFor(key, answers[key]));
      });
      if (elCaption) {
        elCaption.innerHTML = labels.length ? '<b>Tu mesa</b> · ' + labels.join(' · ') : '<b>Tu mesa</b> · responde para verla tomar forma';
      }
    }

    if (panel) {
      panel.addEventListener('click', function (e) {
        var opt = e.target.closest('.wz-opt');
        var back = e.target.closest('[data-back]');
        if (back) { showStep(stepIndex - 1); return; }
        if (!opt) return;
        var key = opt.dataset.key, id = opt.dataset.id;
        answers[key] = id;
        $$('.wz-opt', opt.parentElement).forEach(function (b) {
          var sel = b === opt;
          b.setAttribute('aria-pressed', sel ? 'true' : 'false');
          b.setAttribute('aria-checked', sel ? 'true' : 'false');
        });
        updatePreview();
        if (stepIndex < totalSteps - 1) setTimeout(function () { showStep(stepIndex + 1); }, 260);
        else setTimeout(buildResult, 320);
      });
    }

    function recommend() {
      var totals = {};
      Object.keys(COLLECTIONS).forEach(function (k) { totals[k] = 0; });
      Object.keys(answers).forEach(function (key) {
        var map = SCORE[key] && SCORE[key][answers[key]];
        if (!map) return;
        Object.keys(map).forEach(function (col) { totals[col] += map[col]; });
      });
      var order = Object.keys(COLLECTIONS);
      return order.slice().sort(function (a, b) {
        if (totals[b] !== totals[a]) return totals[b] - totals[a];
        return order.indexOf(a) - order.indexOf(b);
      }).slice(0, 3);
    }

    var resultSection = $('#result');
    var tabsWrap = $('#resultTabs');
    var cardsWrap = $('#resultCards');
    function buildResult() {
      if (!resultSection || !tabsWrap || !cardsWrap) return;
      var top3 = recommend();
      tabsWrap.innerHTML = top3.map(function (id, i) {
        var c = COLLECTIONS[id];
        return '<button class="result-tab" role="tab" data-target="' + id + '" aria-selected="' + (i === 0) + '"><span class="rank">0' + (i + 1) + '</span>' + c.name + '</button>';
      }).join('');
      cardsWrap.innerHTML = top3.map(function (id, i) {
        var c = COLLECTIONS[id];
        var prods = c.products.map(function (p) {
          return '<div class="result-product"><div class="result-product__img"><img src="' + resolve(p.img) + '" alt="' + p.n + '" loading="lazy"></div><b>' + p.n + '</b><small>' + p.p + '</small></div>';
        }).join('');
        return '<article class="result-card' + (i === 0 ? ' active' : '') + '" data-card="' + id + '"><div class="result-ambient"><span class="result-ambient__tag">' + c.tag + '</span><img src="' + resolve(c.ambient) + '" alt="Mesa vestida con ' + c.name + '" loading="lazy"></div><div class="result-body"><span class="eyebrow">' + c.eyebrow + '</span><h3>' + c.name + '</h3><p class="result-reason">' + c.reason + '</p><div class="result-products">' + prods + '</div><div class="result-ctas"><a class="ghost-btn solid" href="' + c.collectionUrl + '">Ver colección</a><a class="ghost-btn" href="' + c.featuredUrl + '">Ver pieza destacada</a><button class="ghost-btn" type="button" data-add="' + c.name + '">Añadir a la cesta</button></div></div></article>';
      }).join('');
      resultSection.hidden = false;
      resultSection.classList.add('is-visible');
      resultSection.scrollIntoView({ behavior: scrollBehavior, block: 'start' });
    }

    if (resultSection) {
      resultSection.addEventListener('click', function (e) {
        var tab = e.target.closest('.result-tab');
        if (!tab) return;
        var id = tab.dataset.target;
        $$('.result-tab', tabsWrap).forEach(function (t) { t.setAttribute('aria-selected', t === tab ? 'true' : 'false'); });
        $$('.result-card', cardsWrap).forEach(function (card) { card.classList.toggle('active', card.dataset.card === id); });
      });
    }

    /* ---------- Add to cart ---------- */
    var toast = $('#vtToast');
    function showToast(name, msg) {
      if (!toast) return;
      toast.textContent = name + (msg || ' · añadido a la cesta');
      toast.classList.add('show');
      clearTimeout(showToast._t);
      showToast._t = setTimeout(function () { toast.classList.remove('show'); }, 2200);
    }
    function openCartDrawer() {
      var toggle = document.querySelector('[data-cart-toggle]');
      if (toggle) { toggle.click(); }              // reuses cart-drawer open+refresh
    }
    container.addEventListener('click', function (e) {
      var add = e.target.closest('[data-add]');
      if (!add) return;
      e.preventDefault();
      // Build the /cart/add.js body: a multi-item pack (data-items) or a single variant.
      var body = null;
      var itemsAttr = add.getAttribute('data-items');
      if (itemsAttr) {
        try {
          var items = JSON.parse(itemsAttr);
          if (items && items.length) { body = { items: items }; }
        } catch (err) { body = null; }
      }
      if (!body) {
        var vid = add.getAttribute('data-variant-id');
        if (vid) { body = { id: vid, quantity: 1 }; }
      }
      if (!body) { showToast(add.dataset.add); return; }   // demo card w/o real product → toast only
      if (add.dataset.busy) return;
      add.dataset.busy = '1';
      add.setAttribute('disabled', 'disabled');
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(body)
      }).then(function (r) {
        if (!r.ok) { throw new Error('add failed'); }
        return r.json();
      }).then(function () {
        showToast(add.dataset.add);
        openCartDrawer();
      }).catch(function () {
        showToast(add.dataset.add, ' · no se pudo añadir');
      }).then(function () {
        delete add.dataset.busy;
        add.removeAttribute('disabled');
      });
    });

    /* ---------- Smooth-scroll CTAs ---------- */
    $$('[data-scroll-to]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        var target = $(a.dataset.scrollTo);
        if (target) { e.preventDefault(); target.scrollIntoView({ behavior: scrollBehavior, block: 'start' }); }
      });
    });

    updatePreview();
  }

  function initAll() {
    document.querySelectorAll('.vt-page').forEach(boot);
  }
  initAll();
  document.addEventListener('shopify:section:load', initAll);
})();
{% endjavascript %}

