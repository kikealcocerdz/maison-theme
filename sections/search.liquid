{%- comment -%}
  Search results reuse the PLP product card. Articles and pages stay in a
  separate editorial list so mixed result types remain clear.
{%- endcomment -%}

<section class="search-page">
  <header class="search-page__header">
    <h1>{{ 'search.title' | t }}</h1>
    <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
      <label for="SearchPageInput">{{ 'search.title' | t }}</label>
      <div>
        <input
          id="SearchPageInput"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t }}"
          autocomplete="off"
        >
        <button type="submit">{{ 'search.submit' | t }}</button>
      </div>
    </form>
  </header>

  {%- if search.performed -%}
    {%- if search.results_count == 0 -%}
      <div class="search-page__empty">
        <p>{{ 'search.no_results_html' | t: terms: search.terms }}</p>
      </div>
    {%- else -%}
      <p class="search-page__count">{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>

      {%- paginate search.results by 24 -%}
        {%- assign has_product_results = false -%}
        {%- for result in search.results -%}
          {%- if result.object_type == 'product' -%}{%- assign has_product_results = true -%}{%- endif -%}
        {%- endfor -%}

        {%- if has_product_results -%}
          <div class="search-page__products products">
            {%- for result in search.results -%}
              {%- if result.object_type == 'product' -%}
                {%- liquid
                  assign result_image = result.featured_image
                  assign image_url = result_image | image_url: width: 720
                  assign image_width = result_image.width | default: 1000
                  assign image_height = result_image.height | default: 1250
                  assign result_price = result.price | money
                  assign result_new = false
                  if result.tags contains 'novedad' or result.tags contains 'new'
                    assign result_new = true
                  endif
                -%}
                {% render 'collection-card', product: result, scope: section.id,
                  card_url: result.url, title: result.title,
                  price: result_price, meta: result.type,
                  img1: image_url, img_w: image_width, img_h: image_height,
                  badge: result_new, data_price: result.price, data_new: result_new, data_type: result.type %}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- assign has_editorial_results = false -%}
        {%- for result in search.results -%}
          {%- unless result.object_type == 'product' -%}{%- assign has_editorial_results = true -%}{%- endunless -%}
        {%- endfor -%}
        {%- if has_editorial_results -%}
          <div class="search-page__other">
            {%- for result in search.results -%}
              {%- unless result.object_type == 'product' -%}
                <article class="search-page__other-row">
                  <p>{{ result.object_type | escape }}</p>
                  <h2><a href="{{ result.url }}">{{ result.title | escape }}</a></h2>
                  {%- assign result_excerpt = result.content | strip_html | strip -%}
                  {%- if result_excerpt != blank -%}<div>{{ result_excerpt | truncate: 180 }}</div>{%- endif -%}
                </article>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}
          <nav class="search-page__pagination" aria-label="{{ 'general.meta.page' | t: page: paginate.current_page }}">
            {{ paginate | default_pagination }}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  {%- endif -%}
</section>

{% stylesheet %}
.search-page { width: var(--content); min-height: calc(100vh - var(--header-h)); margin: 0 auto; padding: calc(var(--header-h) + 70px) 0 120px; color: var(--ink); }
.search-page__header { display: grid; grid-template-columns: minmax(220px, .72fr) minmax(320px, 1fr); gap: clamp(48px, 8vw, 130px); align-items: end; margin-bottom: 58px; }
.search-page__header h1 { margin: 0; font: 400 clamp(50px, 6vw, 88px)/.95 var(--serif); }
.search-page__form label { display: block; margin-bottom: 12px; color: var(--muted); font-size: 10px; letter-spacing: .18em; text-transform: uppercase; }
.search-page__form > div { display: grid; grid-template-columns: minmax(0, 1fr) auto; border-bottom: .5px solid var(--ink); }
.search-page__form input { min-width: 0; height: 52px; padding: 0 12px 0 0; border: 0; background: transparent; color: var(--ink); font: 300 14px/1 var(--sans); }
.search-page__form input::placeholder { color: var(--muted); opacity: 1; }
.search-page__form input:focus { outline: 0; }
.search-page__form > div:focus-within { outline: 1px solid var(--ink); outline-offset: 5px; }
.search-page__form button { min-width: 96px; color: var(--ink); font-size: 10px; letter-spacing: .17em; text-transform: uppercase; white-space: nowrap; }
.search-page__count { margin: 0 0 38px; color: var(--muted); font-size: 11px; line-height: 1.5; }
.search-page__products { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 52px 22px; }
.search-page__other { margin-top: 82px; border-top: .5px solid var(--rule); }
.search-page__other-row { display: grid; grid-template-columns: 120px minmax(220px, .65fr) 1fr; gap: 30px; align-items: baseline; padding: 26px 0; border-bottom: .5px solid var(--rule); }
.search-page__other-row > p { margin: 0; color: var(--muted); font-size: 9px; letter-spacing: .15em; text-transform: uppercase; }
.search-page__other-row h2 { margin: 0; font: 400 23px/1.15 var(--serif); }
.search-page__other-row > div { color: var(--muted); font-size: 12px; line-height: 1.65; }
.search-page__pagination { margin-top: 64px; text-align: center; }
.search-page__pagination .page,
.search-page__pagination .next,
.search-page__pagination .prev { display: inline-block; margin: 0 8px; font-size: 11px; }
.search-page__empty { display: flex; min-height: 260px; align-items: center; border-top: .5px solid var(--rule); }
.search-page__empty p { margin: 0; font: 400 clamp(24px, 3vw, 38px)/1.15 var(--serif); }

@media (max-width: 900px) {
  .search-page { width: calc(100% - 40px); padding-top: calc(var(--header-h) + 42px); }
  .search-page__header { grid-template-columns: 1fr; gap: 38px; }
  .search-page__products { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 34px 14px; }
  .search-page__other-row { grid-template-columns: 90px 1fr; }
  .search-page__other-row > div { grid-column: 2; }
}
@media (max-width: 520px) {
  .search-page { width: calc(100% - 28px); padding-bottom: 80px; }
  .search-page__header { margin-bottom: 42px; }
  .search-page__form button { min-width: 76px; }
  .search-page__products { gap: 28px 10px; }
  .search-page__other { margin-top: 58px; }
  .search-page__other-row { grid-template-columns: 1fr; gap: 8px; }
  .search-page__other-row > div { grid-column: auto; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
