{%- comment -%}
  Collection grid — the storefront PLP. One flexible section that renders any
  collection (chapter / subcollection / product-type) plus the curated "Emblemas"
  page. Layout: left sidebar nav accordion + intro + toolbar (grid/list view,
  server-side sort) + product grid with a mid-grid editorial insert + load more.

  Real path: renders collection.products (paginated). Demo path (pre-catalog):
  renders `product` blocks with demo images/titles/prices (CLAUDE.md §7).
{%- endcomment -%}

{%- liquid
  assign has_products = false
  if collection.products.size > 0
    assign has_products = true
  endif
  assign editorial_after = section.settings.editorial_after | default: 6
  assign per_page = section.settings.products_per_page | default: 24
  assign initial_count = section.settings.demo_initial_count | default: 12

  # Editorial insert: per-collection via metafields, falling back to section settings.
  # Chapter collections carry custom.editorial_image / custom.editorial_text; sub-collection
  # and product-type pages have neither, so the mid-grid insert is suppressed for them.
  assign ed_asset = collection.metafields.custom.editorial_image.value
  if ed_asset == blank
    assign ed_asset = section.settings.editorial_demo_image
  endif
  assign ed_text = collection.metafields.custom.editorial_text.value
  if ed_text == blank
    assign ed_text = section.settings.editorial_text
  endif
  assign ed_picker = section.settings.editorial_image
  assign has_editorial = false
  if ed_picker != blank or ed_asset != blank or ed_text != blank
    assign has_editorial = true
  endif

  assign intro_kicker = collection.metafields.custom.chapter | metafield_text
  if intro_kicker == blank
    assign intro_kicker = section.settings.kicker
  endif
  assign intro_title = section.settings.title | default: collection.title
  assign intro_copy = section.settings.intro_copy
  if intro_copy == blank and collection.description != blank
    assign intro_copy = collection.description
  endif

  assign current_sort = collection.sort_by | default: collection.default_sort_by
-%}

{%- capture sort_filter_query -%}
  {%- for filter in collection.filters -%}
    {%- for value in filter.active_values -%}
      &{{ value.param_name | url_encode }}={{ value.value | url_encode }}
    {%- endfor -%}
    {%- if filter.type == 'price_range' -%}
      {%- if filter.min_value.value -%}&{{ filter.min_value.param_name | url_encode }}={{ filter.min_value.value | divided_by: 100 }}{%- endif -%}
      {%- if filter.max_value.value -%}&{{ filter.max_value.param_name | url_encode }}={{ filter.max_value.value | divided_by: 100 }}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- comment -%}
  `sort_mode` viaja al JS para que el barajado no pise nunca un orden colocado a mano
  en el admin: con «Manual» el orden de la colección es una decisión, no un descuido.
{%- endcomment -%}
{%- assign sort_mode = collection.sort_by | default: collection.default_sort_by -%}
<div class="collection-grid collection-page{% if section.settings.budget_mode %} collection-page--budget{% endif %}{% if template.suffix == 'emblemas' %} collection-page--emblemas{% endif %}" data-section-id="{{ section.id }}" data-sort-mode="{{ sort_mode }}"{% if section.settings.interleave_results %} data-interleave="1"{% endif %}{% if section.settings.budget_mode and collection.sort_by == blank %} data-default-sort="low"{% endif %}>
  <section class="shop-layout">
    {% render 'collection-nav', sort_query: sort_filter_query, current_sort: current_sort %}

    <div class="shop-main">
      <section class="collection-intro">
        <div>
          <div class="breadcrumbs">
            <a href="{{ routes.root_url }}">{{ 'sections.collection.home' | t }}</a> /
            <a href="{{ routes.collections_url }}">{{ 'collections.title' | t }}</a>
            {%- if intro_title != blank %} / {{ intro_title | escape }}{% endif -%}
          </div>
          {%- if intro_kicker != blank -%}<div class="collection-kicker">{{ intro_kicker | escape }}</div>{%- endif -%}
          {%- if intro_title != blank -%}<h1>{{ intro_title | escape }}</h1>{%- endif -%}
        </div>
        {%- comment -%}
          `intro_copy` ya viene en HTML (richtext o collection.description): envolverlo
          en otro <p> hace que el parser cierre el de fuera y cuele dos <p> vacíos como
          hijos extra del grid. strip_html deja un único hijo, como en el mock.
        {%- endcomment -%}
        {%- assign intro_copy_text = intro_copy | strip_html | strip -%}
        {%- if intro_copy_text != blank -%}<p>{{ intro_copy_text }}</p>{%- endif -%}
      </section>

      <div class="toolbar">
        {%- comment -%}
          Mobile-only door to the sidebar: below 780px `.sidebar` is display:none, so
          without this the facets would be unreachable on a phone. Always visible because
          Forma and Color keep their zero-count placeholders before catalog completion.
        {%- endcomment -%}
        <button class="filters-open" type="button" data-filters-open aria-expanded="false">
          {{ 'sections.collection.filters_open' | t }}
          {%- assign active_count = 0 -%}
          {%- for filter in collection.filters -%}{%- assign active_count = active_count | plus: filter.active_values.size -%}{%- endfor -%}
          {%- if active_count > 0 -%}<span class="filters-open-count">{{ active_count }}</span>{%- endif -%}
        </button>
        <div class="view-toggle" aria-label="{{ 'sections.collection.view_toggle' | t }}">
          <button class="view-btn active" type="button" data-view="grid" aria-label="{{ 'sections.collection.view_grid' | t }}"><span class="view-icon grid"><i></i><i></i><i></i></span></button>
          <button class="view-btn" type="button" data-view="list" aria-label="{{ 'sections.collection.view_list' | t }}"><span class="view-icon list"><i></i><i></i><i></i></span></button>
        </div>
        <div class="sort-wrap">
          <button class="sort-btn" type="button">{{ 'sections.collection.sort' | t }} <span aria-hidden="true">⌄</span></button>
          <div class="sort-menu">
            <a href="{{ collection.url }}?sort_by=created-descending{{ sort_filter_query }}"{% if current_sort == 'created-descending' %} aria-current="true"{% endif %}>{{ 'sections.collection.sort_new' | t }}</a>
            <a href="{{ collection.url }}?sort_by=price-descending{{ sort_filter_query }}"{% if current_sort == 'price-descending' %} aria-current="true"{% endif %}>{{ 'sections.collection.sort_high' | t }}</a>
            <a href="{{ collection.url }}?sort_by=price-ascending{{ sort_filter_query }}"{% if current_sort == 'price-ascending' %} aria-current="true"{% endif %}>{{ 'sections.collection.sort_low' | t }}</a>
            <a href="{{ collection.url }}?sort_by=title-ascending{{ sort_filter_query }}"{% if current_sort == 'title-ascending' %} aria-current="true"{% endif %}>{{ 'sections.collection.sort_az' | t }}</a>
            <a href="{{ collection.url }}?sort_by=title-descending{{ sort_filter_query }}"{% if current_sort == 'title-descending' %} aria-current="true"{% endif %}>{{ 'sections.collection.sort_za' | t }}</a>
          </div>
        </div>
      </div>

      {%- comment -%}
        Active-filter chips. Each one is a real link to `url_to_remove`, so removing a
        filter works with JS off; the facet JS intercepts them like any other filter
        change. The price chip is a single chip for the whole range, which is how
        Shopify models it (`min_value` / `max_value` share one `url_to_remove`).
      {%- endcomment -%}
      {%- assign has_active = false -%}
      {%- for filter in collection.filters -%}
        {%- if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value -%}{%- assign has_active = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if has_active -%}
        <div class="facet-chips" data-facet-chips>
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <a class="facet-chip" href="{{ value.url_to_remove }}" aria-label="{{ 'sections.collection.filter_remove' | t: name: value.label }}">
                <span>{{ value.label | escape }}</span><span class="facet-chip-x" aria-hidden="true">×</span>
              </a>
            {%- endfor -%}
            {%- if filter.type == 'price_range' and filter.min_value.value or filter.type == 'price_range' and filter.max_value.value -%}
              {%- liquid
                assign price_lo = filter.min_value.value | default: 0 | money
                assign price_hi = filter.max_value.value | default: filter.range_max | money
                assign price_label = price_lo | append: ' – ' | append: price_hi
              -%}
              <a class="facet-chip" href="{{ filter.url_to_remove }}" aria-label="{{ 'sections.collection.filter_remove' | t: name: price_label }}">
                <span>{{ price_label }}</span><span class="facet-chip-x" aria-hidden="true">×</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
          <a class="facet-chips-clear" href="{{ collection.url }}">{{ 'sections.collection.filter_clear' | t }}</a>
        </div>
      {%- endif -%}

      {%- comment -%}
        Sin resultados. Antes no se pintaba nada —ni el contenedor— entre la barra
        de herramientas y el pie: la página parecía rota en vez de vacía.
      {%- endcomment -%}
      {%- if collection != blank and collection.products.size == 0 and section.blocks.size == 0 -%}
        <div class="collection-empty">
          <p class="collection-empty__title">{{ 'sections.collection.no_results' | t }}</p>
          <p class="collection-empty__body">{{ 'sections.collection.no_results_body' | t }}</p>
          {%- if has_active -%}
            <a class="ghost-btn" href="{{ collection.url }}">{{ 'sections.collection.no_results_clear' | t }}</a>
          {%- else -%}
            <a class="ghost-btn" href="{{ routes.collections_url }}">{{ 'collections.title' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="products" id="productGrid" data-editorial-after="{{ editorial_after }}">
        {%- if has_products -%}
          {%- paginate collection.products by per_page -%}
            {%- for product in collection.products -%}
              {%- liquid
                assign p_img1 = product.featured_image | image_url: width: 720
                assign p_w = product.featured_image.width | default: 1000
                assign p_h = product.featured_image.height | default: 1250
                assign p_price = product.price | money
                assign p_new = false
                if product.tags contains 'novedad' or product.tags contains 'new'
                  assign p_new = true
                endif
              -%}
              {% render 'collection-card', product: product, scope: section.id,
                card_url: product.url, title: product.title,
                price: p_price, meta: product.type,
                img1: p_img1, img_w: p_w, img_h: p_h,
                badge: p_new, data_price: product.price, data_new: p_new, data_type: product.type %}
              {%- if forloop.index == editorial_after and has_editorial -%}{% render 'collection-editorial-insert', ed_picker: ed_picker, ed_asset: ed_asset, ed_text: ed_text %}{%- endif -%}
            {%- endfor -%}

            {%- if paginate.pages > 1 -%}
              {%- assign shown = paginate.current_offset | plus: collection.products.size -%}
              <div class="load-more" data-total="{{ collection.products_count }}">
                <p class="load-count">{{ 'sections.collection.showing' | t: shown: shown, total: collection.products_count }}</p>
                {%- if paginate.next -%}
                  <a class="ghost-btn" href="{{ paginate.next.url }}" rel="next">{{ 'sections.collection.load_more' | t }}&nbsp;→</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endpaginate -%}
        {%- else -%}
          {%- assign has_extra = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'product' -%}
              {%- liquid
                assign d_img1 = block.settings.demo_image | asset_url
                assign is_extra = false
                if forloop.index > initial_count
                  assign is_extra = true
                  assign has_extra = true
                endif
              -%}
              {% render 'collection-card', scope: section.id,
                card_url: block.settings.link, title: block.settings.demo_title,
                price: block.settings.demo_price, meta: block.settings.demo_meta,
                img1: d_img1, badge: block.settings.badge,
                data_price: block.settings.data_price, data_new: block.settings.data_new,
                data_type: block.settings.data_type, extra: is_extra %}
              {%- if forloop.index == editorial_after and has_editorial -%}{% render 'collection-editorial-insert', ed_picker: ed_picker, ed_asset: ed_asset, ed_text: ed_text %}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if has_extra -%}
            <div class="load-more"><button class="ghost-btn" type="button" id="loadMore">{{ 'sections.collection.load_more' | t }}&nbsp;→</button></div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% stylesheet %}
.collection-page { padding-top: calc(var(--header-h) + 64px); }
.collection-page .breadcrumbs { font-size: 10px; color: var(--muted); letter-spacing: .08em; margin-bottom: 28px; }
.collection-page .breadcrumbs a:hover { color: var(--ink); }

.collection-page .shop-layout {
  width: var(--content); margin: 0 auto;
  display: grid; grid-template-columns: minmax(190px, 230px) minmax(0, 1fr);
  gap: min(4vw, 64px); align-items: start;
}
.collection-page .shop-main { min-width: 0; grid-column: 2; }

/* Intro a dos columnas (mock v21): título a la izquierda, copy abajo a la derecha. */
.collection-page .collection-intro {
  width: 100%; margin: 0 0 46px;
  display: grid; grid-template-columns: minmax(260px, 1fr) minmax(320px, .78fr);
  gap: min(6vw, 90px); align-items: end;
}
.collection-page .collection-intro h1 {
  font-family: var(--serif); font-weight: 400; font-size: clamp(48px, 4.8vw, 84px);
  line-height: .95; margin: 0; color: var(--ink); font-variant: small-caps; letter-spacing: .02em;
}
.collection-page .collection-intro > p {
  justify-self: end; text-align: right; color: #777f8d; max-width: 540px;
  margin: 0 0 4px auto; font-size: 14px; line-height: 1.8;
}
.collection-page .collection-kicker {
  font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); margin-bottom: 18px;
}

@media (max-width: 1000px) {
  .collection-page .collection-intro { grid-template-columns: 1fr; gap: 20px; align-items: start; }
  .collection-page .collection-intro > p { justify-self: start; text-align: left; margin: 0; }
}

/* Sidebar accordion */
/* Sticky column. The cap + scroll is what stops a tall sidebar (several panels open, or
   a long chapter tree) from running past the viewport with no way to reach the bottom:
   sticky pins it, so the page scroll never brings the overflow back. */
.collection-page .sidebar {
  margin-top: 205px; position: sticky; top: calc(var(--header-h) + 22px);
  max-height: calc(100vh - var(--header-h) - 44px);
  overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin;
}
.collection-page .side-accordion { display: grid; border-top: .5px solid var(--rule); }
.collection-page .side-section { border-bottom: .5px solid var(--rule); }
.collection-page .side-section-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; min-height: 42px; }
.collection-page .side-main-link { font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-soft); opacity: .86; }
.collection-page .side-main-link.active { color: var(--ink); opacity: 1; }
.collection-page .side-toggle { position: relative; width: 28px; height: 28px; flex: 0 0 28px; color: var(--ink); opacity: .74; }
.collection-page .side-toggle::before, .collection-page .side-toggle::after {
  content: ""; position: absolute; left: 8px; right: 8px; top: 50%; height: .5px; background: currentColor;
  transition: transform 240ms var(--ease), opacity 240ms var(--ease);
}
.collection-page .side-toggle::after { transform: rotate(90deg); }
.collection-page .side-section.is-open .side-toggle::after { transform: rotate(0deg); opacity: 0; }
.collection-page .side-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 360ms var(--ease), padding 360ms var(--ease); padding: 0; }
.collection-page .side-panel > div { overflow: hidden; }
.collection-page .side-section.is-open .side-panel { grid-template-rows: 1fr; padding: 0 0 16px; }
.collection-page .side-panel a { display: block; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); padding: 6px 0; opacity: .82; }
.collection-page .side-panel a.active, .collection-page .side-panel a:hover { color: var(--ink); opacity: 1; }

/* Accesos rápidos del lateral (Novedades / Fin de existencias) y puerta al cajón
   de filtros adicionales. El árbol de capítulos queda debajo, sin cambios. */
.collection-page .side-quick { display: grid; border-top: .5px solid var(--rule); }
.collection-page .side-quick__link {
  display: flex; align-items: center; min-height: 42px;
  font-size: 10px; letter-spacing: .18em; text-transform: uppercase;
  color: var(--ink); border-bottom: .5px solid var(--rule);
}
.collection-page .side-quick__link--end { color: var(--accent-1); }
.collection-page .side-quick__link:hover { opacity: .7; }
.collection-page .sidebar__nav .side-accordion { border-top: 0; }
.collection-page .more-filters {
  display: flex; align-items: center; gap: 8px; width: 100%; min-height: 44px;
  margin-top: 20px; padding: 0 14px; border: .5px solid var(--rule);
  font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--ink);
  transition: border-color 200ms var(--ease);
}
.collection-page .more-filters:hover { border-color: var(--ink); }

/* Cajón de filtros adicionales en escritorio: entra por la izquierda, sobre fondo
   blanco y texto azul corporativo. El árbol se oculta dentro — el
   cajón lleva «únicamente los filtros adicionales». */
@media (min-width: 781px) {
  .collection-page .side-filters { display: none; }

  .collection-page.filters-drawer-open .sidebar {
    position: fixed; inset: 0 auto 0 0; z-index: 120;
    width: min(420px, 92vw); margin: 0; max-height: none;
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--paper); color: var(--ink);
    animation: facets-left-in 280ms var(--ease);
  }
  @keyframes facets-left-in { from { transform: translateX(-100%); } to { transform: none; } }
  .collection-page.filters-drawer-open::after {
    content: ''; position: fixed; inset: 0; z-index: 115; background: rgba(15, 26, 46, .34);
  }

  .collection-page.filters-drawer-open .sidebar__nav,
  .collection-page.filters-drawer-open .more-filters,
  .collection-page.filters-drawer-open .filters-bar__clear { display: none; }
  .collection-page.filters-drawer-open .sidebar__scroll {
    display: block; flex: 1 1 auto; overflow-y: auto; padding: 8px 24px 24px;
  }
  .collection-page.filters-drawer-open .side-filters {
    display: block; margin: 0; padding: 0; background: transparent; border: 0;
  }
  .collection-page.filters-drawer-open .side-filters-head { display: none; }

  .collection-page.filters-drawer-open .filters-bar {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    flex: 0 0 auto; padding: 20px 24px; border-bottom: .5px solid var(--rule);
  }
  .collection-page.filters-drawer-open .filters-close {
    display: grid; place-items: center; width: 30px; height: 30px; color: inherit;
    position: relative; order: 2;
  }
  .collection-page.filters-drawer-open .filters-bar__title { color: inherit; }

  .collection-page.filters-drawer-open .side-section,
  .collection-page.filters-drawer-open .side-accordion { border-color: var(--rule); }
  .collection-page.filters-drawer-open .side-main-link,
  .collection-page.filters-drawer-open .facet,
  .collection-page.filters-drawer-open .side-toggle { color: inherit; opacity: 1; }
  .collection-page.filters-drawer-open .facet:hover { color: inherit; opacity: .74; }
  .collection-page.filters-drawer-open .facet-count { color: inherit; opacity: .55; }
  .collection-page.filters-drawer-open .facet input { accent-color: var(--ink); }
  .collection-page.filters-drawer-open .facet-price input,
  .collection-page.filters-drawer-open .facet-range__track { border-color: var(--rule); background-color: transparent; }
  .collection-page.filters-drawer-open .facet-price input { color: inherit; }
  .collection-page.filters-drawer-open .facet-range__track { background: var(--rule); }
  .collection-page.filters-drawer-open .facet-range__fill { background: var(--ink); }
  .collection-page.filters-drawer-open .facet-price-sep { color: inherit; opacity: .6; }

  .collection-page.filters-drawer-open .filters-foot {
    display: flex; align-items: center; gap: 16px; flex: 0 0 auto;
    padding: 16px 24px; border-top: .5px solid var(--rule);
  }
  .collection-page.filters-drawer-open .filters-reset {
    flex: 0 0 auto; font-size: 10px; letter-spacing: .16em; text-transform: uppercase;
    color: inherit; opacity: .72; text-decoration: underline; text-underline-offset: 3px;
  }
  .collection-page.filters-drawer-open .filters-reset:hover { opacity: 1; }
  .collection-page.filters-drawer-open .filters-apply {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    flex: 1 1 auto; min-height: 48px; background: var(--ink); color: var(--paper);
    font-size: 10px; letter-spacing: .18em; text-transform: uppercase;
  }
  .collection-page.filters-drawer-open .filters-apply__count {
    font-family: var(--serif); font-size: 14px; letter-spacing: .02em; text-transform: none;
  }
}

/* Facets (snippets/collection-filters.liquid) — same accordion shell as the chapter tree
   below, but read as a control panel rather than navigation: boxed on the faint ground,
   headings in full ink. The nav keeps its plain editorial list. */
/* Sin resultados */
.collection-page .collection-empty {
  display: grid; justify-items: start; gap: 16px;
  padding: 64px 0 72px; border-top: .5px solid var(--rule);
}
.collection-page .collection-empty__title {
  margin: 0; font-family: var(--serif); font-size: clamp(26px, 3vw, 38px); line-height: 1.1;
}
.collection-page .collection-empty__body {
  margin: 0; max-width: 46ch; color: var(--muted); font-size: 13px; line-height: 1.75;
}
.collection-page .collection-empty + .products:empty { display: none; }

.collection-page .side-filters {
  margin: 0 0 30px; padding: 15px 15px 4px;
  background: var(--ink-faint-08); border: .5px solid var(--rule);
}
/* La cabecera es un <button>: ocupa el ancho para que el rótulo sea pulsable. */
.collection-page .side-filters .side-section-head {
  width: 100%; padding: 0; background: transparent;
  color: inherit; font: inherit; text-align: left; cursor: pointer;
}
.collection-page .side-filters .side-section-head:focus-visible { outline: 1px solid var(--ink); outline-offset: 2px; }
.collection-page .side-filters .side-section-head:hover .side-main-link { color: inherit; }
.collection-page .side-filters .side-accordion { border-top: .5px solid var(--rule); }
.collection-page .side-filters .side-section:last-child { border-bottom: none; }
.collection-page .side-filters .side-main-link { color: inherit; opacity: 1; letter-spacing: .2em; }
.collection-page .side-filters .side-section.is-open .side-panel { padding-bottom: 12px; }
.collection-page .side-filters-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
.collection-page .side-filters-title { font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); }
.collection-page .side-filters-clear { font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
.collection-page .side-filters-clear:hover { color: var(--ink); }
.collection-page .facet { display: flex; align-items: center; gap: 10px; padding: 6px 0; cursor: pointer; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.collection-page .facet:hover { color: var(--ink); }
.collection-page .facet input { width: 13px; height: 13px; flex: 0 0 13px; margin: 0; accent-color: var(--ink); cursor: pointer; }
.collection-page .facet-label { flex: 1 1 auto; min-width: 0; }
.collection-page .facet-count { font-size: 9px; opacity: .6; font-variant-numeric: tabular-nums; }
/* Unreachable value: visible (so the option list keeps its shape) but inert. */
.collection-page .facet.is-dead { opacity: .38; cursor: default; }
.collection-page .facet.is-dead:hover { color: var(--muted); }
.collection-page .facet-price { display: flex; align-items: center; gap: 8px; padding: 8px 0 2px; }
.collection-page .facet-price input {
  width: 100%; min-width: 0; height: 34px; padding: 0 9px; background: transparent;
  border: .5px solid var(--rule); color: var(--ink); font-family: var(--sans); font-size: 11px;
}
.collection-page .facet-price input:focus-visible { outline: 1px solid var(--ink); outline-offset: -1px; }

/* Barra, pie y chips de orden: sólo existen dentro del cajón móvil. En escritorio
   `display: contents` deja el scroll y el sticky donde estaban, en `.sidebar`. */
.collection-page .filters-bar,
.collection-page .filters-foot,
.collection-page .side-sort { display: none; }
.collection-page .sidebar__scroll { display: contents; }

/* Doble slider de precio (snippets/collection-filters.liquid). Se revela sólo con JS. */
.collection-page .facet-range { position: relative; height: 34px; display: flex; align-items: center; margin: 4px 0 2px; }
.collection-page .facet-range__track { position: absolute; left: 0; right: 0; height: 2px; background: var(--rule); }
.collection-page .facet-range__fill { position: absolute; height: 2px; background: var(--ink); }
.collection-page .facet-range input[type="range"] {
  position: absolute; left: 0; width: 100%; height: 2px; margin: 0;
  background: none; pointer-events: none; -webkit-appearance: none; appearance: none;
}
.collection-page .facet-range input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none; appearance: none; width: 22px; height: 22px; border-radius: 50%;
  background: var(--paper); border: 1.5px solid var(--ink);
  box-shadow: 0 2px 8px rgba(15, 26, 46, .22); cursor: pointer; pointer-events: auto;
}
.collection-page .facet-range input[type="range"]::-moz-range-thumb {
  width: 22px; height: 22px; border-radius: 50%;
  background: var(--paper); border: 1.5px solid var(--ink);
  box-shadow: 0 2px 8px rgba(15, 26, 46, .22); cursor: pointer; pointer-events: auto;
}
.collection-page .facet-price-sep { font-size: 11px; color: var(--muted); }
/* The submit is the no-JS path; the enhanced path applies on change. */
.collection-page .side-filters-apply { margin-top: 16px; width: 100%; }
.js-facets .collection-page .side-filters-apply { display: none; }

/* Active-filter chips */
.collection-page .facet-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: -14px 0 30px; }
.collection-page .facet-chip {
  display: inline-flex; align-items: center; gap: 8px; padding: 7px 11px;
  border: .5px solid var(--rule); font-size: 9.5px; letter-spacing: .1em;
  text-transform: uppercase; color: var(--ink-soft); transition: border-color 200ms var(--ease), color 200ms var(--ease);
}
.collection-page .facet-chip:hover { border-color: var(--ink); color: var(--ink); }
.collection-page .facet-chip-x { font-size: 13px; line-height: 1; opacity: .55; }
.collection-page .facet-chips-clear { font-size: 9.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
.collection-page .facet-chips-clear:hover { color: var(--ink); }

/* Whole section dims while a facet fetch is in flight — same idea as .load-more.is-loading. */
.collection-page.is-filtering .products,
.collection-page.is-filtering .side-filters { opacity: .45; pointer-events: none; transition: opacity 160ms var(--ease); }

/* Desktop has the sidebar; the drawer trigger and its close button are mobile-only
   (see the 780px block). */
.collection-page .filters-open,
.collection-page .filters-close { display: none; }

/* Toolbar */
.collection-page .toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 34px; }
.collection-page .view-toggle { display: flex; gap: 10px; align-items: center; }
.collection-page .view-btn { width: 24px; height: 24px; display: grid; place-items: center; color: var(--muted); }
.collection-page .view-btn.active { color: var(--ink); }
.collection-page .view-icon.grid { width: 17px; height: 13px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
.collection-page .view-icon.grid i, .collection-page .view-icon.list i { display: block; background: currentColor; height: 100%; }
.collection-page .view-icon.list { width: 18px; display: grid; gap: 3px; }
.collection-page .view-icon.list i { height: 1px; }
.collection-page .sort-wrap { position: relative; }
.collection-page .sort-btn { height: 40px; border: .5px solid var(--rule); padding: 0 16px; font-size: 10px; letter-spacing: .14em; text-transform: uppercase; min-width: 124px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.collection-page .sort-menu { position: absolute; right: 0; top: calc(100% + 6px); width: 205px; background: var(--paper); border: .5px solid var(--rule); box-shadow: 0 18px 50px rgba(15, 26, 46, .08); padding: 12px 0; opacity: 0; visibility: hidden; transform: translateY(-8px); transition: all 240ms var(--ease); z-index: 10; }
.collection-page .sort-wrap.open .sort-menu { opacity: 1; visibility: visible; transform: translateY(0); }
.collection-page .sort-menu a { display: block; width: 100%; text-align: left; padding: 12px 18px; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); }
.collection-page .sort-menu a:hover,
.collection-page .sort-menu a[aria-current="true"] { background: var(--ink-faint-20); color: var(--ink); }

/* Budget mode ("Sets para regalo"): the price leads the card instead of trailing it. */
.collection-page--budget .product-info { align-items: baseline; }
.collection-page--budget .price { font-family: var(--serif); font-size: clamp(15px, 1.4vw, 19px); line-height: 1.1; }
@media (max-width: 780px) { .collection-page--budget .price { font-size: 14px; } }

/* Product grid (base card styles are shared in assets/critical.css) */
.collection-page .products { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 52px 22px; transition: opacity 220ms var(--ease); }
.collection-page--emblemas .product-media img.main { background: transparent; }
.collection-page .products.is-list { grid-template-columns: 1fr; gap: 28px; }

/* List view */
.collection-page .products.is-list .product { display: grid; grid-template-columns: 120px 1fr auto auto; align-items: center; gap: 28px; }
.collection-page .products.is-list .product-media { width: 120px; aspect-ratio: 1; }
.collection-page .products.is-list .product-info { display: contents; }
.collection-page .products.is-list .product-info h3 { font-size: 13px; }
.collection-page .products.is-list .product-info p { font-size: 11px; }
.collection-page .products.is-list .price { min-width: 80px; text-align: left; }
.collection-page .products.is-list .fav { right: auto; left: 88px; top: 8px; }

/* Editorial insert */
.collection-page .editorial-insert { grid-column: 1 / -1; margin: 66px 0 34px; display: block; }
.collection-page .editorial-insert img { width: 100%; height: min(46vw, 640px); object-fit: cover; background: var(--ink-faint-20); }
.collection-page .editorial-insert p { font-family: var(--sans); font-size: 12px; line-height: 1.7; letter-spacing: .02em; color: #747b88; max-width: 560px; margin: 16px 0 0; }
/* Sin pie de texto la foto corre más baja (mock: subcoleccion-gifts-decor). */
.collection-page .editorial-insert.editorial-photo-only img { height: min(39vw, 560px); object-position: center; }

.collection-page .load-more { display: flex; flex-direction: column; align-items: center; gap: 18px; margin: 70px 0 126px; grid-column: 1 / -1; }
.collection-page .load-more .ghost-btn { min-width: 220px; }
.collection-page .load-count { font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); margin: 0; }
.collection-page .load-more.is-loading .ghost-btn { opacity: .45; pointer-events: none; }
.collection-page .extra-product.is-hidden { display: none !important; }

@media (max-width: 1180px) {
  .collection-page .products { gap: 42px 16px; }
}
@media (max-width: 1000px) {
  .collection-page .shop-layout { grid-template-columns: 1fr; }
  .collection-page .shop-main { grid-column: 1; }
  .collection-page .sidebar { margin-top: 0; position: relative; top: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .collection-page .side-panel { grid-template-rows: 1fr; }
  .collection-page .products { grid-template-columns: repeat(2, 1fr); }
  .collection-page .products.is-list { grid-template-columns: 1fr; }
  .collection-page .products.is-list .product { grid-template-columns: 88px 1fr; gap: 18px; }
  .collection-page .products.is-list .product-media { width: 88px; }
  .collection-page .products.is-list .price { grid-column: 2; }
}
@media (max-width: 620px) {
  .collection-page .sidebar { grid-template-columns: 1fr; }
  .collection-page .products { grid-template-columns: repeat(2, 1fr); gap: 30px 10px; }
  .collection-page .product-info { grid-template-columns: 1fr; }
  .collection-page .price { text-align: left; }
  .collection-page .collection-intro h1 { font-size: 42px; }
  .collection-page .products.is-list .product { grid-template-columns: 76px 1fr; }
  .collection-page .products.is-list .product-media { width: 76px; }
  .collection-page .products.is-list .fav { left: 54px; }
}

/* ==========================================================================
   v96 / v98 — listado en móvil.
   El sidebar (que es la nav facetada) se oculta y la barra de herramientas pasa
   a sticky bajo la cabecera; la rejilla se fija a 2 columnas.
   Nota: el drawer de filtros que v96 introdujo quedó desactivado en el propio
   v96 (`if(false)` en su JS + display:none), así que no se porta.
   ========================================================================== */
@media (max-width: 780px) {
  .collection-page { width: 100% !important; max-width: 100% !important; overflow-x: clip !important; }
  .collection-page .shop-layout { width: calc(100% - 28px) !important; display: block !important; margin: 0 auto !important; }
  .collection-page .sidebar { display: none !important; }

  /* Filters drawer. The sidebar is the drawer — it slides in with the facets and the
     chapter tree both, rather than duplicating either into a second markup tree. */
  .collection-page .filters-open {
    display: inline-flex !important; align-items: center; gap: 7px; height: 42px; padding: 0 13px;
    border: .5px solid var(--rule); font-size: 8px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink);
  }
  .collection-page .filters-open-count {
    display: inline-grid; place-items: center; min-width: 15px; height: 15px; padding: 0 4px;
    background: var(--ink); color: var(--paper); font-size: 8px; border-radius: 999px;
  }
  /* Cajón de filtros a pantalla completa (mockup `filtros movil`). La barra y el pie
     quedan fijos y sólo el centro rueda, así "Mostrar resultados" siempre está a mano. */
  /* El cajón queda por encima de la cabecera móvil (z 130) y de la ayuda (z 70). */
  .collection-page.filters-drawer-open .sidebar {
    display: flex !important; flex-direction: column; position: fixed; inset: 0; z-index: 160;
    width: 100%; max-height: none; margin: 0 !important; padding: 0;
    background: var(--paper); overflow: hidden; overscroll-behavior: contain;
    animation: facets-in 260ms var(--ease);
  }
  @media (min-width: 620px) {
    .collection-page.filters-drawer-open .sidebar {
      inset: 0 0 0 auto; width: min(460px, 100vw);
      border-left: .5px solid var(--rule); box-shadow: -20px 0 60px rgba(15, 26, 46, .16);
    }
    .collection-page.filters-drawer-open::after {
      content: ''; position: fixed; inset: 0; z-index: 155; background: rgba(15, 26, 46, .3);
    }
  }
  @keyframes facets-in { from { transform: translateX(100%); } to { transform: translateX(0); } }

  .collection-page.filters-drawer-open .sidebar__scroll {
    display: block; flex: 1 1 auto; overflow-y: auto;
    -webkit-overflow-scrolling: touch; padding: 8px 0 24px;
  }

  /* Barra superior: cerrar · Filtrar · Limpiar */
  .collection-page.filters-drawer-open .filters-bar {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    flex: 0 0 auto; padding: 18px 20px; border-bottom: .5px solid var(--rule);
  }
  .collection-page .filters-bar__title { font-family: var(--serif); font-size: 23px; letter-spacing: .01em; }
  .collection-page .filters-bar__clear {
    font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted);
  }
  .collection-page.filters-drawer-open .filters-close {
    display: grid; place-items: center; width: 30px; height: 30px; margin-left: -6px;
    position: relative; color: var(--ink);
  }
  .collection-page .filters-close span,
  .collection-page .filters-close span::before {
    content: ""; position: absolute; width: 20px; height: 1.3px; background: currentColor;
  }
  .collection-page .filters-close span { transform: rotate(45deg); }
  .collection-page .filters-close span::before { left: 0; transform: rotate(-90deg); }

  /* Pie fijo */
  .collection-page.filters-drawer-open .filters-foot {
    display: flex; align-items: center; gap: 14px; flex: 0 0 auto;
    padding: 16px 20px calc(16px + env(safe-area-inset-bottom, 0px));
    border-top: .5px solid var(--rule); box-shadow: 0 -8px 24px rgba(15, 26, 46, .05);
  }
  .collection-page .filters-reset {
    flex: 0 0 auto; font-size: 11px; letter-spacing: .16em; text-transform: uppercase;
    color: var(--muted); text-decoration: underline; text-underline-offset: 3px;
  }
  .collection-page .more-filters { display: none; }
  .collection-page .filters-apply {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    flex: 1 1 auto; min-height: 56px; background: var(--ink); color: var(--paper);
    font-size: 12px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase;
    transition: background 240ms var(--ease);
  }
  .collection-page .filters-apply:hover { background: var(--accent-1); }
  .collection-page .filters-apply__count {
    font-family: var(--serif); font-size: 15px; font-weight: 400;
    letter-spacing: .02em; text-transform: none;
  }

  /* Ordenar por: chips deslizables */
  .collection-page.filters-drawer-open .side-sort {
    display: block; padding: 24px 20px; border-bottom: .5px solid var(--rule);
  }
  .collection-page .side-sort__label {
    display: block; margin-bottom: 18px;
    font-size: 11px; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; color: var(--ink);
  }
  .collection-page .side-sort__chips {
    display: flex; gap: 10px; flex-wrap: nowrap; overflow-x: auto;
    scrollbar-width: none; margin: 0 -20px; padding: 2px 20px;
  }
  .collection-page .side-sort__chips::-webkit-scrollbar { display: none; }
  .collection-page .fchip {
    display: inline-flex; align-items: center; min-height: 44px; padding: 0 20px;
    border: .5px solid var(--rule); border-radius: 999px;
    font-size: 13px; color: var(--ink-soft); white-space: nowrap;
    transition: background 220ms var(--ease), color 220ms var(--ease), border-color 220ms var(--ease);
  }
  .collection-page .fchip.is-on { background: var(--ink); border-color: var(--ink); color: var(--paper); }

  /* El panel de facetas pierde la caja: en el cajón cada faceta es una sección propia. */
  .collection-page.filters-drawer-open .side-filters {
    margin: 0; padding: 0; background: transparent; border: 0;
  }
  .collection-page.filters-drawer-open .side-filters-head { display: none; }
  .collection-page.filters-drawer-open .side-filters .side-accordion,
  .collection-page.filters-drawer-open .side-accordion { border-top: 0; }
  .collection-page.filters-drawer-open .side-section { padding: 24px 20px; border-bottom: .5px solid var(--rule); }
  .collection-page.filters-drawer-open .side-main-link {
    font-size: 11px; font-weight: 500; letter-spacing: .2em; color: var(--ink); opacity: 1;
  }
  .collection-page.filters-drawer-open .side-section.is-open .side-panel { padding-bottom: 0; }

  /* Cada valor es una pastilla con casilla, en dos columnas.
     ponytail: el mockup usaba chips redondas para Disponibilidad y pastillas para Tipo
     de producto. Una sola forma para todas las facetas evita ramificar por etiqueta,
     que se rompe en cuanto el cliente añade un filtro nuevo. */
  .collection-page.filters-drawer-open .side-panel > div {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 10px; padding-top: 4px;
  }
  .collection-page.filters-drawer-open .side-panel > div > .facet-price,
  .collection-page.filters-drawer-open .side-panel > div > .facet-range { grid-column: 1 / -1; }
  .collection-page.filters-drawer-open .facet {
    display: flex; align-items: center; gap: 8px; min-height: 48px; padding: 0 10px;
    border: .5px solid var(--rule); text-transform: none; letter-spacing: .01em;
    font-size: 13px; color: var(--ink);
    transition: border-color 200ms var(--ease);
  }
  .collection-page.filters-drawer-open .facet:has(input:checked) { border-color: var(--ink); }
  .collection-page.filters-drawer-open .facet input { width: 18px; height: 18px; flex: 0 0 18px; }
  /* Sin min-width:0 la etiqueta en nowrap fija el minimo del item flex, la columna
     deja de caber en su 1fr y la pastilla se sale del cajon: el contador quedaba
     fuera de pantalla. El puntos suspensivos solo recorta si puede encoger. */
  .collection-page.filters-drawer-open .facet-label {
    min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
  }
  .collection-page.filters-drawer-open .facet-count { font-size: 11px; color: var(--muted); }
  .collection-page.filters-drawer-open .facet-price { display: flex; gap: 14px; padding: 0 0 6px; }
  .collection-page.filters-drawer-open .facet-price input { height: 52px; font-size: 15px; padding: 0 12px; }

  /* El cajón se cierra con "Mostrar resultados": el submit deja de tener sitio. */
  .js-facets .collection-page .side-filters-apply { display: none; }
  /* Sin JS no hay cajón ni pie, así que el submit vuelve a ser la única salida. */
  .collection-page .side-filters-apply { display: block; }
  .collection-page .collection-intro { width: 100% !important; padding-top: 28px !important; margin-bottom: 24px !important; gap: 20px !important; }
  .collection-page .collection-intro h1 { font-size: clamp(42px, 12vw, 62px) !important; }
  .collection-page .collection-intro > p { font-size: 11px !important; line-height: 1.65 !important; text-align: left !important; }
  .collection-page .breadcrumbs { font-size: 9px !important; }

  .collection-page .toolbar {
    position: sticky !important;
    top: calc(var(--header-h) + env(safe-area-inset-top, 0px)) !important;
    z-index: 35 !important;
    width: 100% !important;
    background: rgba(255, 255, 255, 0.96) !important;
    -webkit-backdrop-filter: blur(14px) !important; backdrop-filter: blur(14px) !important;
    margin: 0 -2px 18px !important;
    padding: 10px 2px !important;
    border-bottom: 1px solid rgba(15, 26, 46, 0.08) !important;
  }

  .collection-page .view-toggle { gap: 6px !important; }
  .collection-page .view-btn { width: 40px !important; height: 40px !important; }
  .collection-page .sort-btn { height: 42px !important; min-width: 105px !important; padding: 0 11px !important; font-size: 8px !important; }

  .collection-page .products { width: 100% !important; grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 28px 10px !important; }
  .collection-page .products.is-list { grid-template-columns: 1fr !important; }
  .collection-page .product,
  .collection-page .product-media,
  .collection-page .product-info { min-width: 0 !important; max-width: 100% !important; }
  .collection-page .product-media { aspect-ratio: 4 / 5 !important; }
  .collection-page .product-media img { max-width: 100% !important; }
  .collection-page .product-info { margin-top: 9px !important; gap: 4px 8px !important; font-size: 10px !important; }
  .collection-page .product-info h3 { font-size: 10px !important; line-height: 1.32 !important; }
  .collection-page .product-info p { font-size: 8px !important; line-height: 1.35 !important; }
  .collection-page .price { font-size: 10px !important; }
  .collection-page .fav { width: 32px !important; height: 32px !important; right: 6px !important; top: 5px !important; }
  .collection-page .badge { font-size: 7px !important; padding: 5px 7px !important; top: 7px !important; left: 7px !important; }

  .collection-page .editorial-insert { width: 100% !important; max-width: 100% !important; margin: 34px 0 16px !important; overflow: hidden !important; }
  .collection-page .editorial-insert img { width: 100% !important; max-width: 100% !important; height: 58vw !important; }
}

@media (max-width: 760px) {
  .collection-page { padding-top: calc(var(--header-h) + 24px) !important; overflow-x: hidden !important; }
  .collection-page .collection-intro { display: flex !important; flex-direction: column !important; gap: 16px !important; margin: 0 0 28px !important; }
  .collection-page .collection-intro > div,
  .collection-page .collection-intro > p { width: 100% !important; max-width: 100% !important; }
  .collection-page .breadcrumbs { font-size: 8.5px !important; line-height: 1.5 !important; margin-bottom: 18px !important; white-space: normal !important; }
  .collection-page .collection-kicker { font-size: 9px !important; margin-bottom: 12px !important; }
  .collection-page .collection-intro h1 { font-size: clamp(44px, 14vw, 62px) !important; line-height: 0.94 !important; overflow-wrap: anywhere; }
  .collection-page .collection-intro p { font-size: 11.5px !important; line-height: 1.65 !important; margin: 0 !important; color: var(--ink-soft) !important; overflow-wrap: anywhere; }
  .collection-page .toolbar { margin: 0 0 22px !important; padding: 0 !important; gap: 12px !important; }
  .collection-page .sort-btn { padding: 0 14px !important; }

  .collection-page .product-media { overflow: hidden !important; }
  .collection-page .product-media img.main { width: 100% !important; height: 100% !important; object-fit: cover !important; object-position: center !important; }
  .collection-page .product-info { display: grid !important; grid-template-columns: minmax(0, 1fr) auto !important; gap: 3px 7px !important; padding-top: 8px !important; }
  .collection-page .product-info h3 { font-size: 9.2px !important; overflow-wrap: anywhere !important; }
  .collection-page .product-info p { grid-column: 1 !important; margin: 0 !important; }
  .collection-page .product-info .price { font-size: 9px !important; grid-column: 2 !important; grid-row: 1 !important; white-space: nowrap !important; }
  .collection-page .editorial-insert { grid-column: 1 / -1 !important; margin: 0 !important; }
  .collection-page .editorial-insert img { height: auto !important; object-fit: cover !important; }
}

@media (max-width: 420px) {
  .collection-page .products { gap: 24px 8px !important; }
  .collection-page .product-info h3 { font-size: 9.5px !important; }
}

/* En táctil no hay hover: la segunda foto de la tarjeta nunca debe aparecer. */
@media (hover: none) and (pointer: coarse) {
  .product:hover .product-media img.main { opacity: 1 !important; transform: none !important; }
  .product:hover .product-media img.hover { opacity: 0 !important; transform: none !important; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  function init(root) {
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';

    // Sidebar accordion — one panel open at a time, facets and chapter tree sharing the
    // same rule. The column is sticky and capped to the viewport height, so every extra
    // open panel pushes the ones below out of reach with no page scroll left to recover
    // them; closing the previous panel is what keeps them all reachable.
    var side = root.querySelector('.sidebar');

    function openOnly(section) {
      if (!side) return;
      side.querySelectorAll('.side-section').forEach(function (s) {
        var on = s === section;
        s.classList.toggle('is-open', on);
        var t = s.querySelector('[data-side-toggle]') || s.querySelector('.side-toggle');
        if (t) t.setAttribute('aria-expanded', on ? 'true' : 'false');
      });
    }

    // Server-rendered state can open more than one (an active facet *and* the current
    // chapter), so collapse down to the first before anyone touches it.
    if (side) openOnly(side.querySelector('.side-section.is-open'));

    root.querySelectorAll('.side-toggle, [data-side-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault(); e.stopPropagation();
        var s = btn.closest('.side-section');
        if (!s) return;
        openOnly(s.classList.contains('is-open') ? null : s); // null closes everything
      });
    });

    // (Product-media hover carousel is handled globally in assets/theme.js.)

    var grid = root.querySelector('#productGrid');

    function placeItems(items) {
      var editorial = grid.querySelector('.editorial-insert');
      var editorialAfter = parseInt(grid.dataset.editorialAfter, 10) || 6;
      items.forEach(function (item) { grid.appendChild(item); });
      if (editorial) grid.insertBefore(editorial, items[editorialAfter] || null);
      var loadMore = grid.querySelector('.load-more');
      if (loadMore) grid.appendChild(loadMore);
    }

    // View toggle
    root.querySelectorAll('.view-btn').forEach(function (b) {
      b.addEventListener('click', function () {
        root.querySelectorAll('.view-btn').forEach(function (x) { x.classList.remove('active'); });
        b.classList.add('active');
        if (grid) grid.classList.toggle('is-list', b.dataset.view === 'list');
      });
    });

    // El corazón lo gestiona el handler global de assets/theme.js, que además lo guarda.

    // Budget mode fallback. Normal sort options are real links and Shopify orders the
    // complete collection before pagination. This local sorter only protects the first
    // visit to sets-regalo until its default order is confirmed in the admin.
    function applySort(mode) {
      if (!grid) return;
      var items = [].slice.call(grid.querySelectorAll('.product'));
      items.sort(function (a, c) {
        return mode === 'new' ? (+c.dataset.new - +a.dataset.new)
          : mode === 'high' ? (+c.dataset.price - +a.dataset.price)
          : mode === 'low' ? (+a.dataset.price - +c.dataset.price) : 0;
      });
      placeItems(items);
    }

    var sw = root.querySelector('.sort-wrap');
    if (sw) {
      var sb = sw.querySelector('.sort-btn');
      if (sb) sb.addEventListener('click', function () { sw.classList.toggle('open'); });
    }

    // Resultados intercalados: baraja por tipo para que no salgan las tres palanganas
    // seguidas. Va APAGADO salvo que se marque en los ajustes de la sección, y aun así
    // no se activa si el orden de la colección es «Manual» o si el comprador ha elegido
    // uno: colocar las piezas a mano en el admin es una decisión y manda sobre esto.
    function interleave() {
      if (!grid || !root.dataset.interleave) return;
      if (root.dataset.sortMode === 'manual') return;
      if (location.search.indexOf('sort_by=') > -1) return;
      var items = [].slice.call(grid.querySelectorAll('.product'));
      if (items.length < 6) return;

      var buckets = [];
      var byKey = {};
      items.forEach(function (el) {
        var key = el.dataset.type || '';
        if (!byKey[key]) { byKey[key] = []; buckets.push(byKey[key]); }
        byKey[key].push(el);
      });
      if (buckets.length < 2) return;

      var mixed = [];
      for (var round = 0; mixed.length < items.length; round++) {
        buckets.forEach(function (b) { if (b[round]) mixed.push(b[round]); });
      }

      placeItems(mixed);
    }

    // Budget mode ("Sets para regalo"): price ascending without touching the sort menu.
    // ponytail: this only reorders what is already in the DOM — the collection's own
    // "Price: low to high" order in the admin is what sorts the whole collection across
    // pages. This is the backup for when that admin setting drifts.
    var defaultSort = root.dataset.defaultSort;
    if (defaultSort) applySort(defaultSort); else interleave();

    // Facets — progressive enhancement only. The <form method="get"> in
    // snippets/collection-filters.liquid already filters on its own (Shopify does the
    // work server-side), so everything here is about not reloading the page.
    //
    // The swap replaces the whole section root rather than patching pieces of it: the
    // fetched node carries no stale listeners and init() re-runs on it from scratch, so
    // the accordion, sort, load-more and budget mode all come back wired without a
    // second code path. Any failure falls through to a real navigation.
    var form = root.querySelector('[data-filters]');
    if (form) {
      document.documentElement.classList.add('js-facets');
      var busy = false;

      function facetUrl() {
        // An empty price box must not travel: `filter.v.price.gte=` pins the range to 0
        // and returns nothing.
        var qs = new URLSearchParams();
        new FormData(form).forEach(function (v, k) { if (String(v).trim() !== '') qs.append(k, v); });
        var q = qs.toString();
        return location.pathname + (q ? '?' + q : '');
      }

      // Dos puertas al mismo cajón: «Filtrar» en la barra (móvil) y «+ Filtros» en
      // el lateral (escritorio). Ambas llevan data-filters-open, así que el aria hay
      // que devolverlo en las dos.
      function closeDrawer() {
        root.classList.remove('filters-drawer-open');
        root.querySelectorAll('[data-filters-open]').forEach(function (t) {
          t.setAttribute('aria-expanded', 'false');
        });
        document.body.style.overflow = '';
      }

      function go(url) {
        if (busy) return;
        busy = true;
        root.classList.add('is-filtering');
        // El cajón sobrevive al re-render: el nodo se sustituye entero, así que su
        // estado abierto hay que volver a ponerlo o cada clic lo cerraría de golpe.
        var wasOpen = root.classList.contains('filters-drawer-open');
        var sid = root.dataset.sectionId;
        fetch(url + (url.indexOf('?') > -1 ? '&' : '?') + 'section_id=' + encodeURIComponent(sid))
          .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
          .then(function (html) {
            var next = new DOMParser().parseFromString(html, 'text/html').querySelector('.collection-grid');
            if (!next) return Promise.reject('no section');
            history.replaceState({}, '', url);
            root.replaceWith(next);
            if (wasOpen) {
              next.classList.add('filters-drawer-open');
              var opener = next.querySelector('[data-filters-open]');
              if (opener) opener.setAttribute('aria-expanded', 'true');
            } else {
              document.body.style.overflow = '';
            }
            init(next);
            // ponytail: same trick as load-more — let theme.js rewire the reveal observer.
            next.dispatchEvent(new CustomEvent('shopify:section:load', { bubbles: true }));
          })
          .catch(function () { location.assign(url); })
          .then(function () { busy = false; });
      }

      // También en el cajón: el pie dice "Mostrar resultados (246)" y ese número tiene
      // que ser el de verdad, así que cada marca se aplica y vuelve con el recuento nuevo.
      form.addEventListener('change', function () { go(facetUrl()); });
      form.addEventListener('submit', function (e) { e.preventDefault(); go(facetUrl()); });

      // Chips, "clear" and the sidebar's clear link are ordinary <a href> — intercept
      // them so they take the same in-place path instead of a full reload.
      root.addEventListener('click', function (e) {
        var a = e.target.closest('.facet-chip, .facet-chips-clear, [data-filters-clear], [data-facet-link]');
        if (a && a.getAttribute('href')) { e.preventDefault(); go(a.getAttribute('href')); return; }

        if (e.target.closest('[data-filters-open]')) {
          root.classList.add('filters-drawer-open');
          root.querySelectorAll('[data-filters-open]').forEach(function (t) {
            t.setAttribute('aria-expanded', 'true');
          });
          document.body.style.overflow = 'hidden';
          return;
        }
        if (e.target.closest('[data-filters-close]')) { closeDrawer(); return; }
        // Tap on the scrim (the ::after covers the page, so the hit lands on root itself).
        if (e.target === root && root.classList.contains('filters-drawer-open')) closeDrawer();
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && root.classList.contains('filters-drawer-open')) closeDrawer();
      });

      // Doble slider de precio. Sólo escribe en los dos inputs numéricos, que son los
      // que llevan `name`; al soltar dispara el mismo `change` que cualquier faceta.
      var range = root.querySelector('[data-price-range]');
      if (range) {
        var low = range.querySelector('[data-range-low]');
        var high = range.querySelector('[data-range-high]');
        var fill = range.querySelector('[data-range-fill]');
        var numMin = root.querySelector('[data-price-min]');
        var numMax = root.querySelector('[data-price-max]');
        var cap = parseInt(range.dataset.cap, 10) || 0;
        range.hidden = false;

        function paint() {
          if (!cap) return;
          fill.style.left = (low.value / cap * 100) + '%';
          fill.style.width = ((high.value - low.value) / cap * 100) + '%';
        }

        function pull(fromSlider) {
          var a = parseInt(low.value, 10);
          var b = parseInt(high.value, 10);
          if (a > b) { if (fromSlider === low) { a = b; low.value = b; } else { b = a; high.value = a; } }
          // Un extremo pegado al tope no es un filtro: se deja vacío para no mandarlo.
          numMin.value = a > 0 ? a : '';
          numMax.value = b < cap ? b : '';
          paint();
        }

        [low, high].forEach(function (el) {
          el.addEventListener('input', function () { pull(el); });
          el.addEventListener('change', function () {
            pull(el);
            numMax.dispatchEvent(new Event('change', { bubbles: true }));
          });
        });

        // Teclear en los números mueve los tiradores.
        [numMin, numMax].forEach(function (el, i) {
          el.addEventListener('input', function () {
            var v = parseInt(el.value, 10);
            if (isNaN(v)) v = i === 0 ? 0 : cap;
            (i === 0 ? low : high).value = Math.min(Math.max(v, 0), cap);
            paint();
          });
        });

        paint();
      }
    }

    // Load more (demo reveal)
    var lm = root.querySelector('#loadMore');
    if (lm) lm.addEventListener('click', function () {
      root.querySelectorAll('.extra-product.is-hidden').forEach(function (el) { el.classList.remove('is-hidden'); el.classList.add('is-visible'); });
      lm.style.display = 'none';
    });

    // Load more (real path) — append the next paginated page instead of navigating to it,
    // and auto-fire when the block scrolls into view. The <a href> stays a real link, so
    // no-JS and crawlers keep the normal ?page=N flow.
    var more = root.querySelector('.load-more[data-total]');
    var link = more && more.querySelector('a[rel="next"]');
    if (grid && link) {
      var count = more.querySelector('.load-count');
      var observer = null;
      var loading = false;

      function done() {
        if (observer) { observer.disconnect(); observer = null; }
        link.remove();
        link = null;
      }

      function loadNext() {
        if (loading || !link) return;
        loading = true;
        more.classList.add('is-loading');
        // Section Rendering API: returns just this section, not the whole document.
        var sid = root.dataset.sectionId;
        fetch(link.href + (sid ? '&section_id=' + encodeURIComponent(sid) : ''))
          .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
          .then(function (html) {
            var next = new DOMParser().parseFromString(html, 'text/html').querySelector('#productGrid');
            if (!next) return done();
            // Only .product nodes: the next page renders its own .editorial-insert, which
            // must not be duplicated mid-grid.
            next.querySelectorAll('.product').forEach(function (el) { grid.insertBefore(el, more); });
            if (defaultSort) applySort(defaultSort); else interleave(); // mantiene el criterio al paginar
            var nextCount = next.querySelector('.load-count');
            if (count && nextCount) count.textContent = nextCount.textContent;
            var nextLink = next.querySelector('.load-more a[rel="next"]');
            if (nextLink) link.href = nextLink.href; else done();
            // ponytail: let theme.js's shopify:section:load handler pick up the new cards
            // (reveal observer) instead of re-implementing it here. init() is guarded by
            // root.dataset.init, so the section's own listener re-entry is a no-op.
            root.dispatchEvent(new CustomEvent('shopify:section:load', { bubbles: true }));
          })
          .catch(function () { if (link) link.removeAttribute('data-ajax'); }) // fall back to plain navigation
          .then(function () { loading = false; more.classList.remove('is-loading'); });
      }

      link.dataset.ajax = '1';
      link.addEventListener('click', function (e) {
        if (!link.dataset.ajax) return; // a failed fetch reverts to normal navigation
        e.preventDefault();
        loadNext();
      });

      if ('IntersectionObserver' in window) {
        observer = new IntersectionObserver(function (entries) {
          if (entries.some(function (en) { return en.isIntersecting; })) loadNext();
        }, { rootMargin: '600px' });
        observer.observe(more);
      }
    }
  }

  document.querySelectorAll('.collection-grid').forEach(init);
  document.addEventListener('shopify:section:load', function (e) {
    e.target.querySelectorAll('.collection-grid').forEach(init);
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "link_list", "id": "sidebar_menu", "label": "Sidebar navigation menu", "info": "Nested menu (chapters → subcollections). Falls back to a demo tree when empty." },
    { "type": "url", "id": "link_novedades", "label": "Sidebar link: Novedades", "info": "Defaults to /collections/novedades." },
    { "type": "url", "id": "link_fin_existencias", "label": "Sidebar link: Fin de existencias", "info": "Defaults to /collections/fin-de-existencias." },
    { "type": "text", "id": "kicker", "label": "Kicker", "info": "Small label above the title, e.g. 'Capítulo 01'. Overridden by the collection metafield custom.chapter." },
    { "type": "text", "id": "title", "label": "Title override", "info": "Falls back to the collection title." },
    { "type": "richtext", "id": "intro_copy", "label": "Intro copy", "info": "Falls back to the collection description." },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 12, "max": 48, "step": 6, "default": 24 },
    { "type": "checkbox", "id": "interleave_results", "label": "Intercalar resultados por tipo", "info": "Baraja la página para que no salgan varias piezas iguales seguidas. No se aplica si la colección está ordenada a mano ni si el comprador elige un orden.", "default": false },
    { "type": "checkbox", "id": "budget_mode", "label": "Budget mode (price-first, low\u2192high)", "info": "For gift-set style listings. Set the collection's own sort order to \"Price: lowest to highest\" in the admin so every page is ordered.", "default": false },
    { "type": "header", "content": "Editorial insert (mid-grid)" },
    { "type": "range", "id": "editorial_after", "label": "Insert after card #", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "image_picker", "id": "editorial_image", "label": "Editorial image" },
    { "type": "text", "id": "editorial_demo_image", "label": "Editorial demo image (asset filename)", "info": "Used when no editorial image is selected, e.g. collection-aurora.webp" },
    { "type": "richtext", "id": "editorial_text", "label": "Editorial caption" },
    { "type": "header", "content": "Demo (when the collection has no products yet)" },
    { "type": "range", "id": "demo_initial_count", "label": "Demo cards shown before 'Load more'", "min": 3, "max": 24, "step": 1, "default": 12 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Demo product",
      "settings": [
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "demo_title", "label": "Title" },
        { "type": "text", "id": "demo_price", "label": "Price (e.g. 68 €)" },
        { "type": "text", "id": "demo_meta", "label": "Meta line (e.g. subcollection)" },
        { "type": "text", "id": "demo_image", "label": "Image (asset filename)" },
        { "type": "checkbox", "id": "badge", "label": "Show 'Novedad' badge", "default": false },
        { "type": "header", "content": "Sort / filter data" },
        { "type": "number", "id": "data_price", "label": "Sort price (number)" },
        { "type": "number", "id": "data_new", "label": "Is new (1/0)" },
        { "type": "text", "id": "data_type", "label": "Product type slug" }
      ]
    }
  ]
}
{% endschema %}
