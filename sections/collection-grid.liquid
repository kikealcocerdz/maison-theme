{%- comment -%}
  Collection grid — the storefront PLP. One flexible section that renders any
  collection (chapter / subcollection / product-type) plus the curated "Emblemas"
  page. Layout: left sidebar nav accordion + intro + toolbar (grid/list view,
  client-side sort) + product grid with a mid-grid editorial insert + load more.

  Real path: renders collection.products (paginated). Demo path (pre-catalog):
  renders `product` blocks with demo images/titles/prices (CLAUDE.md §7).
{%- endcomment -%}

{%- liquid
  assign has_products = false
  if collection.products.size > 0
    assign has_products = true
  endif
  assign editorial_after = section.settings.editorial_after | default: 6
  assign per_page = section.settings.products_per_page | default: 24
  assign initial_count = section.settings.demo_initial_count | default: 12

  # Editorial insert: per-collection via metafields, falling back to section settings.
  # Chapter collections carry custom.editorial_image / custom.editorial_text; sub-collection
  # and product-type pages have neither, so the mid-grid insert is suppressed for them.
  assign ed_asset = collection.metafields.custom.editorial_image.value
  if ed_asset == blank
    assign ed_asset = section.settings.editorial_demo_image
  endif
  assign ed_text = collection.metafields.custom.editorial_text.value
  if ed_text == blank
    assign ed_text = section.settings.editorial_text
  endif
  assign ed_picker = section.settings.editorial_image
  assign has_editorial = false
  if ed_picker != blank or ed_asset != blank or ed_text != blank
    assign has_editorial = true
  endif

  assign intro_kicker = collection.metafields.custom.chapter | metafield_text
  if intro_kicker == blank
    assign intro_kicker = section.settings.kicker
  endif
  assign intro_title = section.settings.title | default: collection.title
  assign intro_copy = section.settings.intro_copy
  if intro_copy == blank and collection.description != blank
    assign intro_copy = collection.description
  endif
-%}

<div class="collection-grid collection-page{% if section.settings.budget_mode %} collection-page--budget{% endif %}" data-section-id="{{ section.id }}"{% if section.settings.budget_mode %} data-default-sort="low"{% endif %}>
  <section class="shop-layout">
    {% render 'collection-nav' %}

    <div class="shop-main">
      <section class="collection-intro">
        <div>
          <div class="breadcrumbs">
            <a href="{{ routes.root_url }}">{{ 'sections.collection.home' | t }}</a> /
            <a href="{{ routes.collections_url }}">{{ 'collections.title' | t }}</a>
            {%- if intro_title != blank %} / {{ intro_title | escape }}{% endif -%}
          </div>
          {%- if intro_kicker != blank -%}<div class="collection-kicker">{{ intro_kicker | escape }}</div>{%- endif -%}
          {%- if intro_title != blank -%}<h1>{{ intro_title | escape }}</h1>{%- endif -%}
        </div>
        {%- comment -%}
          `intro_copy` ya viene en HTML (richtext o collection.description): envolverlo
          en otro <p> hace que el parser cierre el de fuera y cuele dos <p> vacíos como
          hijos extra del grid. strip_html deja un único hijo, como en el mock.
        {%- endcomment -%}
        {%- assign intro_copy_text = intro_copy | strip_html | strip -%}
        {%- if intro_copy_text != blank -%}<p>{{ intro_copy_text }}</p>{%- endif -%}
      </section>

      <div class="toolbar">
        {%- comment -%}
          Mobile-only door to the sidebar: below 780px `.sidebar` is display:none, so
          without this the facets would be unreachable on a phone. Hidden when the store
          exposes no filters — the chapter tree alone doesn't warrant a drawer.
        {%- endcomment -%}
        {%- if collection.filters.size > 0 -%}
          <button class="filters-open" type="button" data-filters-open aria-expanded="false">
            {{ 'sections.collection.filters_open' | t }}
            {%- assign active_count = 0 -%}
            {%- for filter in collection.filters -%}{%- assign active_count = active_count | plus: filter.active_values.size -%}{%- endfor -%}
            {%- if active_count > 0 -%}<span class="filters-open-count">{{ active_count }}</span>{%- endif -%}
          </button>
        {%- endif -%}
        <div class="view-toggle" aria-label="{{ 'sections.collection.view_toggle' | t }}">
          <button class="view-btn active" type="button" data-view="grid" aria-label="{{ 'sections.collection.view_grid' | t }}"><span class="view-icon grid"><i></i><i></i><i></i></span></button>
          <button class="view-btn" type="button" data-view="list" aria-label="{{ 'sections.collection.view_list' | t }}"><span class="view-icon list"><i></i><i></i><i></i></span></button>
        </div>
        <div class="sort-wrap">
          <button class="sort-btn" type="button">{{ 'sections.collection.sort' | t }} <span aria-hidden="true">⌄</span></button>
          <div class="sort-menu">
            <button type="button" data-sort="new">{{ 'sections.collection.sort_new' | t }}</button>
            <button type="button" data-sort="high">{{ 'sections.collection.sort_high' | t }}</button>
            <button type="button" data-sort="low">{{ 'sections.collection.sort_low' | t }}</button>
          </div>
        </div>
      </div>

      {%- comment -%}
        Active-filter chips. Each one is a real link to `url_to_remove`, so removing a
        filter works with JS off; the facet JS intercepts them like any other filter
        change. The price chip is a single chip for the whole range, which is how
        Shopify models it (`min_value` / `max_value` share one `url_to_remove`).
      {%- endcomment -%}
      {%- assign has_active = false -%}
      {%- for filter in collection.filters -%}
        {%- if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value -%}{%- assign has_active = true -%}{%- endif -%}
      {%- endfor -%}
      {%- if has_active -%}
        <div class="facet-chips" data-facet-chips>
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <a class="facet-chip" href="{{ value.url_to_remove }}" aria-label="{{ 'sections.collection.filter_remove' | t: name: value.label }}">
                <span>{{ value.label | escape }}</span><span class="facet-chip-x" aria-hidden="true">×</span>
              </a>
            {%- endfor -%}
            {%- if filter.type == 'price_range' and filter.min_value.value or filter.type == 'price_range' and filter.max_value.value -%}
              {%- liquid
                assign price_lo = filter.min_value.value | default: 0 | money
                assign price_hi = filter.max_value.value | default: filter.range_max | money
                assign price_label = price_lo | append: ' – ' | append: price_hi
              -%}
              <a class="facet-chip" href="{{ filter.url_to_remove }}" aria-label="{{ 'sections.collection.filter_remove' | t: name: price_label }}">
                <span>{{ price_label }}</span><span class="facet-chip-x" aria-hidden="true">×</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
          <a class="facet-chips-clear" href="{{ collection.url }}">{{ 'sections.collection.filter_clear' | t }}</a>
        </div>
      {%- endif -%}

      <div class="products" id="productGrid">
        {%- if has_products -%}
          {%- paginate collection.products by per_page -%}
            {%- for product in collection.products -%}
              {%- liquid
                assign p_img1 = product.featured_image | image_url: width: 720
                assign p_w = product.featured_image.width | default: 1000
                assign p_h = product.featured_image.height | default: 1250
                assign p_price = product.price | money
                assign p_new = 0
                if product.tags contains 'novedad' or product.tags contains 'new'
                  assign p_new = 1
                endif
              -%}
              {% render 'collection-card', product: product,
                card_url: product.url, title: product.title,
                price: p_price, meta: product.type,
                img1: p_img1, img_w: p_w, img_h: p_h,
                badge: p_new, data_price: product.price, data_new: p_new, data_type: product.type %}
              {%- if forloop.index == editorial_after and has_editorial -%}{% render 'collection-editorial-insert', ed_picker: ed_picker, ed_asset: ed_asset, ed_text: ed_text %}{%- endif -%}
            {%- endfor -%}

            {%- if paginate.pages > 1 -%}
              {%- assign shown = paginate.current_offset | plus: collection.products.size -%}
              <div class="load-more" data-total="{{ collection.products_count }}">
                <p class="load-count">{{ 'sections.collection.showing' | t: shown: shown, total: collection.products_count }}</p>
                {%- if paginate.next -%}
                  <a class="ghost-btn" href="{{ paginate.next.url }}" rel="next">{{ 'sections.collection.load_more' | t }}&nbsp;→</a>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endpaginate -%}
        {%- else -%}
          {%- assign has_extra = false -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'product' -%}
              {%- liquid
                assign d_img1 = block.settings.demo_image | asset_url
                assign is_extra = false
                if forloop.index > initial_count
                  assign is_extra = true
                  assign has_extra = true
                endif
              -%}
              {% render 'collection-card',
                card_url: block.settings.link, title: block.settings.demo_title,
                price: block.settings.demo_price, meta: block.settings.demo_meta,
                img1: d_img1, badge: block.settings.badge,
                data_price: block.settings.data_price, data_new: block.settings.data_new,
                data_type: block.settings.data_type, extra: is_extra %}
              {%- if forloop.index == editorial_after and has_editorial -%}{% render 'collection-editorial-insert', ed_picker: ed_picker, ed_asset: ed_asset, ed_text: ed_text %}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if has_extra -%}
            <div class="load-more"><button class="ghost-btn" type="button" id="loadMore">{{ 'sections.collection.load_more' | t }}&nbsp;→</button></div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </section>
</div>

{% stylesheet %}
.collection-page { padding-top: calc(var(--header-h) + 64px); }
.collection-page .breadcrumbs { font-size: 10px; color: var(--muted); letter-spacing: .08em; margin-bottom: 28px; }
.collection-page .breadcrumbs a:hover { color: var(--ink); }

.collection-page .shop-layout {
  width: var(--content); margin: 0 auto;
  display: grid; grid-template-columns: minmax(190px, 230px) minmax(0, 1fr);
  gap: min(4vw, 64px); align-items: start;
}
.collection-page .shop-main { min-width: 0; }

/* Intro a dos columnas (mock v21): título a la izquierda, copy abajo a la derecha. */
.collection-page .collection-intro {
  width: 100%; margin: 0 0 46px;
  display: grid; grid-template-columns: minmax(260px, 1fr) minmax(320px, .78fr);
  gap: min(6vw, 90px); align-items: end;
}
.collection-page .collection-intro h1 {
  font-family: var(--serif); font-weight: 400; font-size: clamp(48px, 4.8vw, 84px);
  line-height: .95; margin: 0; color: var(--ink); font-variant: small-caps; letter-spacing: .02em;
}
.collection-page .collection-intro > p {
  justify-self: end; text-align: right; color: #777f8d; max-width: 540px;
  margin: 0 0 4px auto; font-size: 14px; line-height: 1.8;
}
.collection-page .collection-kicker {
  font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); margin-bottom: 18px;
}

@media (max-width: 1000px) {
  .collection-page .collection-intro { grid-template-columns: 1fr; gap: 20px; align-items: start; }
  .collection-page .collection-intro > p { justify-self: start; text-align: left; margin: 0; }
}

/* Sidebar accordion */
.collection-page .sidebar { margin-top: 205px; position: sticky; top: calc(var(--header-h) + 22px); }
.collection-page .side-accordion { display: grid; border-top: .5px solid var(--rule); }
.collection-page .side-section { border-bottom: .5px solid var(--rule); }
.collection-page .side-section-head { display: flex; align-items: center; justify-content: space-between; gap: 14px; min-height: 42px; }
.collection-page .side-main-link { font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--ink-soft); opacity: .86; }
.collection-page .side-main-link.active { color: var(--ink); opacity: 1; }
.collection-page .side-toggle { position: relative; width: 28px; height: 28px; flex: 0 0 28px; color: var(--ink); opacity: .74; }
.collection-page .side-toggle::before, .collection-page .side-toggle::after {
  content: ""; position: absolute; left: 8px; right: 8px; top: 50%; height: .5px; background: currentColor;
  transition: transform 240ms var(--ease), opacity 240ms var(--ease);
}
.collection-page .side-toggle::after { transform: rotate(90deg); }
.collection-page .side-section.is-open .side-toggle::after { transform: rotate(0deg); opacity: 0; }
.collection-page .side-panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 360ms var(--ease), padding 360ms var(--ease); padding: 0; }
.collection-page .side-panel > div { overflow: hidden; }
.collection-page .side-section.is-open .side-panel { grid-template-rows: 1fr; padding: 0 0 16px; }
.collection-page .side-panel a { display: block; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); padding: 6px 0; opacity: .82; }
.collection-page .side-panel a.active, .collection-page .side-panel a:hover { color: var(--ink); opacity: 1; }

/* Facets (snippets/collection-filters.liquid) — same accordion shell as the nav above,
   so only the controls inside .side-panel need their own rules. */
.collection-page .side-filters { margin-top: 34px; }
.collection-page .side-filters-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.collection-page .side-filters-title { font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); }
.collection-page .side-filters-clear { font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
.collection-page .side-filters-clear:hover { color: var(--ink); }
.collection-page .facet { display: flex; align-items: center; gap: 10px; padding: 6px 0; cursor: pointer; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
.collection-page .facet:hover { color: var(--ink); }
.collection-page .facet input { width: 13px; height: 13px; flex: 0 0 13px; margin: 0; accent-color: var(--ink); cursor: pointer; }
.collection-page .facet-label { flex: 1 1 auto; min-width: 0; }
.collection-page .facet-count { font-size: 9px; opacity: .6; font-variant-numeric: tabular-nums; }
/* Unreachable value: visible (so the option list keeps its shape) but inert. */
.collection-page .facet.is-dead { opacity: .38; cursor: default; }
.collection-page .facet.is-dead:hover { color: var(--muted); }
.collection-page .facet-price { display: flex; align-items: center; gap: 8px; padding: 8px 0 2px; }
.collection-page .facet-price input {
  width: 100%; min-width: 0; height: 34px; padding: 0 9px; background: transparent;
  border: .5px solid var(--rule); color: var(--ink); font-family: var(--sans); font-size: 11px;
}
.collection-page .facet-price input:focus-visible { outline: 1px solid var(--ink); outline-offset: -1px; }
.collection-page .facet-price-sep { font-size: 11px; color: var(--muted); }
/* The submit is the no-JS path; the enhanced path applies on change. */
.collection-page .side-filters-apply { margin-top: 16px; width: 100%; }
.js-facets .collection-page .side-filters-apply { display: none; }

/* Active-filter chips */
.collection-page .facet-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: -14px 0 30px; }
.collection-page .facet-chip {
  display: inline-flex; align-items: center; gap: 8px; padding: 7px 11px;
  border: .5px solid var(--rule); font-size: 9.5px; letter-spacing: .1em;
  text-transform: uppercase; color: var(--ink-soft); transition: border-color 200ms var(--ease), color 200ms var(--ease);
}
.collection-page .facet-chip:hover { border-color: var(--ink); color: var(--ink); }
.collection-page .facet-chip-x { font-size: 13px; line-height: 1; opacity: .55; }
.collection-page .facet-chips-clear { font-size: 9.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); text-decoration: underline; text-underline-offset: 3px; }
.collection-page .facet-chips-clear:hover { color: var(--ink); }

/* Whole section dims while a facet fetch is in flight — same idea as .load-more.is-loading. */
.collection-page.is-filtering .products,
.collection-page.is-filtering .side-filters { opacity: .45; pointer-events: none; transition: opacity 160ms var(--ease); }

/* Desktop has the sidebar; the drawer trigger and its close button are mobile-only
   (see the 780px block). */
.collection-page .filters-open,
.collection-page .filters-close { display: none; }

/* Toolbar */
.collection-page .toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 34px; }
.collection-page .view-toggle { display: flex; gap: 10px; align-items: center; }
.collection-page .view-btn { width: 24px; height: 24px; display: grid; place-items: center; color: var(--muted); }
.collection-page .view-btn.active { color: var(--ink); }
.collection-page .view-icon.grid { width: 17px; height: 13px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
.collection-page .view-icon.grid i, .collection-page .view-icon.list i { display: block; background: currentColor; height: 100%; }
.collection-page .view-icon.list { width: 18px; display: grid; gap: 3px; }
.collection-page .view-icon.list i { height: 1px; }
.collection-page .sort-wrap { position: relative; }
.collection-page .sort-btn { height: 40px; border: .5px solid var(--rule); padding: 0 16px; font-size: 10px; letter-spacing: .14em; text-transform: uppercase; min-width: 124px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.collection-page .sort-menu { position: absolute; right: 0; top: calc(100% + 6px); width: 205px; background: var(--paper); border: .5px solid var(--rule); box-shadow: 0 18px 50px rgba(15, 26, 46, .08); padding: 12px 0; opacity: 0; visibility: hidden; transform: translateY(-8px); transition: all 240ms var(--ease); z-index: 10; }
.collection-page .sort-wrap.open .sort-menu { opacity: 1; visibility: visible; transform: translateY(0); }
.collection-page .sort-menu button { display: block; width: 100%; text-align: left; padding: 12px 18px; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-soft); }
.collection-page .sort-menu button:hover { background: var(--ink-faint-20); }

/* Budget mode ("Sets para regalo"): the price leads the card instead of trailing it. */
.collection-page--budget .product-info { align-items: baseline; }
.collection-page--budget .price { font-family: var(--serif); font-size: clamp(15px, 1.4vw, 19px); line-height: 1.1; }
@media (max-width: 780px) { .collection-page--budget .price { font-size: 14px; } }

/* Product grid (base card styles are shared in assets/critical.css) */
.collection-page .products { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 52px 22px; transition: opacity 220ms var(--ease); }
.collection-page .products.is-list { grid-template-columns: 1fr; gap: 28px; }

/* List view */
.collection-page .products.is-list .product { display: grid; grid-template-columns: 120px 1fr auto auto; align-items: center; gap: 28px; }
.collection-page .products.is-list .product-media { width: 120px; aspect-ratio: 1; }
.collection-page .products.is-list .product-info { display: contents; }
.collection-page .products.is-list .product-info h3 { font-size: 13px; }
.collection-page .products.is-list .product-info p { font-size: 11px; }
.collection-page .products.is-list .price { min-width: 80px; text-align: left; }
.collection-page .products.is-list .fav { right: auto; left: 88px; top: 8px; }

/* Editorial insert */
.collection-page .editorial-insert { grid-column: 1 / -1; margin: 66px 0 34px; display: block; }
.collection-page .editorial-insert img { width: 100%; height: min(46vw, 640px); object-fit: cover; background: var(--ink-faint-20); }
.collection-page .editorial-insert p { font-family: var(--sans); font-size: 12px; line-height: 1.7; letter-spacing: .02em; color: #747b88; max-width: 560px; margin: 16px 0 0; }
/* Sin pie de texto la foto corre más baja (mock: subcoleccion-gifts-decor). */
.collection-page .editorial-insert.editorial-photo-only img { height: min(39vw, 560px); object-position: center; }

.collection-page .load-more { display: flex; flex-direction: column; align-items: center; gap: 18px; margin: 70px 0 126px; grid-column: 1 / -1; }
.collection-page .load-more .ghost-btn { min-width: 220px; }
.collection-page .load-count { font-size: 10px; letter-spacing: .18em; text-transform: uppercase; color: var(--muted); margin: 0; }
.collection-page .load-more.is-loading .ghost-btn { opacity: .45; pointer-events: none; }
.collection-page .extra-product.is-hidden { display: none !important; }

@media (max-width: 1180px) {
  .collection-page .products { gap: 42px 16px; }
}
@media (max-width: 1000px) {
  .collection-page .shop-layout { grid-template-columns: 1fr; }
  .collection-page .sidebar { margin-top: 0; position: relative; top: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .collection-page .side-panel { grid-template-rows: 1fr; }
  .collection-page .products { grid-template-columns: repeat(2, 1fr); }
  .collection-page .products.is-list { grid-template-columns: 1fr; }
  .collection-page .products.is-list .product { grid-template-columns: 88px 1fr; gap: 18px; }
  .collection-page .products.is-list .product-media { width: 88px; }
  .collection-page .products.is-list .price { grid-column: 2; }
}
@media (max-width: 620px) {
  .collection-page .sidebar { grid-template-columns: 1fr; }
  .collection-page .products { grid-template-columns: repeat(2, 1fr); gap: 30px 10px; }
  .collection-page .product-info { grid-template-columns: 1fr; }
  .collection-page .price { text-align: left; }
  .collection-page .collection-intro h1 { font-size: 42px; }
  .collection-page .products.is-list .product { grid-template-columns: 76px 1fr; }
  .collection-page .products.is-list .product-media { width: 76px; }
  .collection-page .products.is-list .fav { left: 54px; }
}

/* ==========================================================================
   v96 / v98 — listado en móvil.
   El sidebar (que es la nav facetada) se oculta y la barra de herramientas pasa
   a sticky bajo la cabecera; la rejilla se fija a 2 columnas.
   Nota: el drawer de filtros que v96 introdujo quedó desactivado en el propio
   v96 (`if(false)` en su JS + display:none), así que no se porta.
   ========================================================================== */
@media (max-width: 780px) {
  .collection-page { width: 100% !important; max-width: 100% !important; overflow-x: clip !important; }
  .collection-page .shop-layout { width: calc(100% - 28px) !important; display: block !important; margin: 0 auto !important; }
  .collection-page .sidebar { display: none !important; }

  /* Filters drawer. The sidebar is the drawer — it slides in with the facets and the
     chapter tree both, rather than duplicating either into a second markup tree. */
  .collection-page .filters-open {
    display: inline-flex !important; align-items: center; gap: 7px; height: 42px; padding: 0 13px;
    border: .5px solid var(--rule); font-size: 8px; letter-spacing: .16em; text-transform: uppercase; color: var(--ink);
  }
  .collection-page .filters-open-count {
    display: inline-grid; place-items: center; min-width: 15px; height: 15px; padding: 0 4px;
    background: var(--ink); color: var(--paper); font-size: 8px; border-radius: 999px;
  }
  .collection-page.filters-drawer-open .sidebar {
    display: block !important; position: fixed; inset: 0 0 0 auto; z-index: 60;
    width: min(86vw, 340px); margin: 0 !important; padding: 22px 20px 100px;
    background: var(--paper); overflow-y: auto; overscroll-behavior: contain;
    box-shadow: -20px 0 60px rgba(15, 26, 46, .16);
    animation: facets-in 260ms var(--ease);
  }
  @keyframes facets-in { from { transform: translateX(100%); } to { transform: translateX(0); } }
  .collection-page.filters-drawer-open::after {
    content: ''; position: fixed; inset: 0; z-index: 55; background: rgba(15, 26, 46, .3);
  }
  .collection-page .filters-close {
    display: block; width: 100%; margin-bottom: 18px; text-align: right;
    font-size: 9px; letter-spacing: .16em; text-transform: uppercase; color: var(--muted);
  }
  /* On mobile the drawer closes on apply, so the submit earns its place back. */
  .js-facets .collection-page .side-filters-apply { display: block; }
  .collection-page .collection-intro { width: 100% !important; padding-top: 28px !important; margin-bottom: 24px !important; gap: 20px !important; }
  .collection-page .collection-intro h1 { font-size: clamp(42px, 12vw, 62px) !important; }
  .collection-page .collection-intro > p { font-size: 11px !important; line-height: 1.65 !important; text-align: left !important; }
  .collection-page .breadcrumbs { font-size: 9px !important; }

  .collection-page .toolbar {
    position: sticky !important;
    top: calc(var(--header-h) + env(safe-area-inset-top, 0px)) !important;
    z-index: 35 !important;
    width: 100% !important;
    background: rgba(255, 255, 255, 0.96) !important;
    backdrop-filter: blur(14px) !important;
    margin: 0 -2px 18px !important;
    padding: 10px 2px !important;
    border-bottom: 1px solid rgba(15, 26, 46, 0.08) !important;
  }

  .collection-page .view-toggle { gap: 6px !important; }
  .collection-page .view-btn { width: 40px !important; height: 40px !important; }
  .collection-page .sort-btn { height: 42px !important; min-width: 105px !important; padding: 0 11px !important; font-size: 8px !important; }

  .collection-page .products { width: 100% !important; grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 28px 10px !important; }
  .collection-page .products.is-list { grid-template-columns: 1fr !important; }
  .collection-page .product,
  .collection-page .product-media,
  .collection-page .product-info { min-width: 0 !important; max-width: 100% !important; }
  .collection-page .product-media { aspect-ratio: 4 / 5 !important; }
  .collection-page .product-media img { max-width: 100% !important; }
  .collection-page .product-info { margin-top: 9px !important; gap: 4px 8px !important; font-size: 10px !important; }
  .collection-page .product-info h3 { font-size: 10px !important; line-height: 1.32 !important; }
  .collection-page .product-info p { font-size: 8px !important; line-height: 1.35 !important; }
  .collection-page .price { font-size: 10px !important; }
  .collection-page .fav { width: 32px !important; height: 32px !important; right: 6px !important; top: 5px !important; }
  .collection-page .badge { font-size: 7px !important; padding: 5px 7px !important; top: 7px !important; left: 7px !important; }

  .collection-page .editorial-insert { width: 100% !important; max-width: 100% !important; margin: 34px 0 16px !important; overflow: hidden !important; }
  .collection-page .editorial-insert img { width: 100% !important; max-width: 100% !important; height: 58vw !important; }
}

@media (max-width: 760px) {
  .collection-page { padding-top: calc(var(--header-h) + 24px) !important; overflow-x: hidden !important; }
  .collection-page .collection-intro { display: flex !important; flex-direction: column !important; gap: 16px !important; margin: 0 0 28px !important; }
  .collection-page .collection-intro > div,
  .collection-page .collection-intro > p { width: 100% !important; max-width: 100% !important; }
  .collection-page .breadcrumbs { font-size: 8.5px !important; line-height: 1.5 !important; margin-bottom: 18px !important; white-space: normal !important; }
  .collection-page .collection-kicker { font-size: 9px !important; margin-bottom: 12px !important; }
  .collection-page .collection-intro h1 { font-size: clamp(44px, 14vw, 62px) !important; line-height: 0.94 !important; overflow-wrap: anywhere; }
  .collection-page .collection-intro p { font-size: 11.5px !important; line-height: 1.65 !important; margin: 0 !important; color: var(--ink-soft) !important; overflow-wrap: anywhere; }
  .collection-page .toolbar { margin: 0 0 22px !important; padding: 0 !important; gap: 12px !important; }
  .collection-page .sort-btn { padding: 0 14px !important; }

  .collection-page .product-media { overflow: hidden !important; }
  .collection-page .product-media img.main { width: 100% !important; height: 100% !important; object-fit: cover !important; object-position: center !important; }
  .collection-page .product-info { display: grid !important; grid-template-columns: minmax(0, 1fr) auto !important; gap: 3px 7px !important; padding-top: 8px !important; }
  .collection-page .product-info h3 { font-size: 9.2px !important; overflow-wrap: anywhere !important; }
  .collection-page .product-info p { grid-column: 1 !important; margin: 0 !important; }
  .collection-page .product-info .price { font-size: 9px !important; grid-column: 2 !important; grid-row: 1 !important; white-space: nowrap !important; }
  .collection-page .editorial-insert { grid-column: 1 / -1 !important; margin: 0 !important; }
  .collection-page .editorial-insert img { height: auto !important; object-fit: cover !important; }
}

@media (max-width: 420px) {
  .collection-page .products { gap: 24px 8px !important; }
  .collection-page .product-info h3 { font-size: 9.5px !important; }
}

/* En táctil no hay hover: la segunda foto de la tarjeta nunca debe aparecer. */
@media (hover: none) and (pointer: coarse) {
  .product:hover .product-media img.main { opacity: 1 !important; transform: none !important; }
  .product:hover .product-media img.hover { opacity: 0 !important; transform: none !important; }
}
