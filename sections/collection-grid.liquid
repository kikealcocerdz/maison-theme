{% javascript %}
(function () {
  function init(root) {
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';

    // Sidebar accordion
    root.querySelectorAll('.side-toggle').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault(); e.stopPropagation();
        var s = btn.closest('.side-section');
        if (s) { var open = s.classList.toggle('is-open'); btn.setAttribute('aria-expanded', open); }
      });
    });

    // (Product-media hover carousel is handled globally in assets/theme.js.)

    var grid = root.querySelector('#productGrid');

    // View toggle
    root.querySelectorAll('.view-btn').forEach(function (b) {
      b.addEventListener('click', function () {
        root.querySelectorAll('.view-btn').forEach(function (x) { x.classList.remove('active'); });
        b.classList.add('active');
        if (grid) grid.classList.toggle('is-list', b.dataset.view === 'list');
      });
    });

    // Favourite toggle (visual only) — delegated so cards appended by "load more" work too
    root.addEventListener('click', function (e) {
      var f = e.target.closest('.fav');
      if (!f) return;
      e.preventDefault(); e.stopPropagation();
      f.classList.toggle('active');
    });

    // Sort — reorders the cards currently in the DOM.
    function applySort(mode) {
      if (!grid) return;
      var items = [].slice.call(grid.querySelectorAll('.product'));
      items.sort(function (a, c) {
        return mode === 'new' ? (+c.dataset.new - +a.dataset.new)
          : mode === 'high' ? (+c.dataset.price - +a.dataset.price)
          : mode === 'low' ? (+a.dataset.price - +c.dataset.price) : 0;
      });
      var editorial = grid.querySelector('.editorial-insert');
      items.forEach(function (item, i) {
        if (editorial && i === 6) grid.insertBefore(editorial, item);
        grid.appendChild(item);
      });
      var lmEl = grid.querySelector('.load-more');
      if (lmEl) grid.appendChild(lmEl); // keep the load-more block last after re-ordering
    }

    var sw = root.querySelector('.sort-wrap');
    if (sw) {
      var sb = sw.querySelector('.sort-btn');
      if (sb) sb.addEventListener('click', function () { sw.classList.toggle('open'); });
      sw.querySelectorAll('.sort-menu button').forEach(function (b) {
        b.addEventListener('click', function () {
          applySort(b.dataset.sort);
          sw.classList.remove('open');
        });
      });
    }

    // Budget mode ("Sets para regalo"): price ascending without touching the sort menu.
    // ponytail: this only reorders what is already in the DOM — the collection's own
    // "Price: low to high" order in the admin is what sorts the whole collection across
    // pages. This is the backup for when that admin setting drifts.
    var defaultSort = root.dataset.defaultSort;
    if (defaultSort) applySort(defaultSort);

    // Facets — progressive enhancement only. The <form method="get"> in
    // snippets/collection-filters.liquid already filters on its own (Shopify does the
    // work server-side), so everything here is about not reloading the page.
    //
    // The swap replaces the whole section root rather than patching pieces of it: the
    // fetched node carries no stale listeners and init() re-runs on it from scratch, so
    // the accordion, sort, load-more and budget mode all come back wired without a
    // second code path. Any failure falls through to a real navigation.
    var form = root.querySelector('[data-filters]');
    if (form) {
      document.documentElement.classList.add('js-facets');
      var busy = false;

      function facetUrl() {
        // An empty price box must not travel: `filter.v.price.gte=` pins the range to 0
        // and returns nothing.
        var qs = new URLSearchParams();
        new FormData(form).forEach(function (v, k) { if (String(v).trim() !== '') qs.append(k, v); });
        var q = qs.toString();
        return location.pathname + (q ? '?' + q : '');
      }

      function closeDrawer() {
        root.classList.remove('filters-drawer-open');
        var t = root.querySelector('[data-filters-open]');
        if (t) t.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      function go(url) {
        if (busy) return;
        busy = true;
        root.classList.add('is-filtering');
        var sid = root.dataset.sectionId;
        fetch(url + (url.indexOf('?') > -1 ? '&' : '?') + 'section_id=' + encodeURIComponent(sid))
          .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
          .then(function (html) {
            var next = new DOMParser().parseFromString(html, 'text/html').querySelector('.collection-grid');
            if (!next) return Promise.reject('no section');
            history.replaceState({}, '', url);
            document.body.style.overflow = '';
            root.replaceWith(next);
            init(next);
            // ponytail: same trick as load-more — let theme.js rewire the reveal observer.
            next.dispatchEvent(new CustomEvent('shopify:section:load', { bubbles: true }));
          })
          .catch(function () { location.assign(url); })
          .then(function () { busy = false; });
      }

      form.addEventListener('change', function () {
        // In the mobile drawer the shopper ticks several boxes before committing, so
        // there the "Apply" submit is what fires. On desktop, change is the commit.
        if (root.classList.contains('filters-drawer-open')) return;
        go(facetUrl());
      });
      form.addEventListener('submit', function (e) { e.preventDefault(); go(facetUrl()); });

      // Chips, "clear" and the sidebar's clear link are ordinary <a href> — intercept
      // them so they take the same in-place path instead of a full reload.
      root.addEventListener('click', function (e) {
        var a = e.target.closest('.facet-chip, .facet-chips-clear, [data-filters-clear]');
        if (a && a.getAttribute('href')) { e.preventDefault(); go(a.getAttribute('href')); return; }

        if (e.target.closest('[data-filters-open]')) {
          root.classList.add('filters-drawer-open');
          e.target.closest('[data-filters-open]').setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
          return;
        }
        if (e.target.closest('[data-filters-close]')) { closeDrawer(); return; }
        // Tap on the scrim (the ::after covers the page, so the hit lands on root itself).
        if (e.target === root && root.classList.contains('filters-drawer-open')) closeDrawer();
      });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && root.classList.contains('filters-drawer-open')) closeDrawer();
      });
    }

    // Load more (demo reveal)
    var lm = root.querySelector('#loadMore');
    if (lm) lm.addEventListener('click', function () {
      root.querySelectorAll('.extra-product.is-hidden').forEach(function (el) { el.classList.remove('is-hidden'); el.classList.add('is-visible'); });
      lm.style.display = 'none';
    });

    // Load more (real path) — append the next paginated page instead of navigating to it,
    // and auto-fire when the block scrolls into view. The <a href> stays a real link, so
    // no-JS and crawlers keep the normal ?page=N flow.
    var more = root.querySelector('.load-more[data-total]');
    var link = more && more.querySelector('a[rel="next"]');
    if (grid && link) {
      var count = more.querySelector('.load-count');
      var observer = null;
      var loading = false;

      function done() {
        if (observer) { observer.disconnect(); observer = null; }
        link.remove();
        link = null;
      }

      function loadNext() {
        if (loading || !link) return;
        loading = true;
        more.classList.add('is-loading');
        // Section Rendering API: returns just this section, not the whole document.
        var sid = root.dataset.sectionId;
        fetch(link.href + (sid ? '&section_id=' + encodeURIComponent(sid) : ''))
          .then(function (r) { return r.ok ? r.text() : Promise.reject(r.status); })
          .then(function (html) {
            var next = new DOMParser().parseFromString(html, 'text/html').querySelector('#productGrid');
            if (!next) return done();
            // Only .product nodes: the next page renders its own .editorial-insert, which
            // must not be duplicated mid-grid.
            next.querySelectorAll('.product').forEach(function (el) { grid.insertBefore(el, more); });
            if (defaultSort) applySort(defaultSort); // keep budget mode ordered across pages
            var nextCount = next.querySelector('.load-count');
            if (count && nextCount) count.textContent = nextCount.textContent;
            var nextLink = next.querySelector('.load-more a[rel="next"]');
            if (nextLink) link.href = nextLink.href; else done();
            // ponytail: let theme.js's shopify:section:load handler pick up the new cards
            // (reveal observer) instead of re-implementing it here. init() is guarded by
            // root.dataset.init, so the section's own listener re-entry is a no-op.
            root.dispatchEvent(new CustomEvent('shopify:section:load', { bubbles: true }));
          })
          .catch(function () { if (link) link.removeAttribute('data-ajax'); }) // fall back to plain navigation
          .then(function () { loading = false; more.classList.remove('is-loading'); });
      }

      link.dataset.ajax = '1';
      link.addEventListener('click', function (e) {
        if (!link.dataset.ajax) return; // a failed fetch reverts to normal navigation
        e.preventDefault();
        loadNext();
      });

      if ('IntersectionObserver' in window) {
        observer = new IntersectionObserver(function (entries) {
          if (entries.some(function (en) { return en.isIntersecting; })) loadNext();
        }, { rootMargin: '600px' });
        observer.observe(more);
      }
    }
  }

  document.querySelectorAll('.collection-grid').forEach(init);
  document.addEventListener('shopify:section:load', function (e) {
    e.target.querySelectorAll('.collection-grid').forEach(init);
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "link_list", "id": "sidebar_menu", "label": "Sidebar navigation menu", "info": "Nested menu (chapters → subcollections). Falls back to a demo tree when empty." },
    { "type": "text", "id": "kicker", "label": "Kicker", "info": "Small label above the title, e.g. 'Capítulo 01'. Overridden by the collection metafield custom.chapter." },
    { "type": "text", "id": "title", "label": "Title override", "info": "Falls back to the collection title." },
    { "type": "richtext", "id": "intro_copy", "label": "Intro copy", "info": "Falls back to the collection description." },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 12, "max": 48, "step": 6, "default": 24 },
    { "type": "checkbox", "id": "budget_mode", "label": "Budget mode (price-first, low\u2192high)", "info": "For gift-set style listings. Set the collection's own sort order to \"Price: lowest to highest\" in the admin so every page is ordered.", "default": false },
    { "type": "header", "content": "Editorial insert (mid-grid)" },
    { "type": "range", "id": "editorial_after", "label": "Insert after card #", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "image_picker", "id": "editorial_image", "label": "Editorial image" },
    { "type": "text", "id": "editorial_demo_image", "label": "Editorial demo image (asset filename)", "info": "Used when no editorial image is selected, e.g. collection-aurora.webp" },
    { "type": "richtext", "id": "editorial_text", "label": "Editorial caption" },
    { "type": "header", "content": "Demo (when the collection has no products yet)" },
    { "type": "range", "id": "demo_initial_count", "label": "Demo cards shown before 'Load more'", "min": 3, "max": 24, "step": 1, "default": 12 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Demo product",
      "settings": [
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "demo_title", "label": "Title" },
        { "type": "text", "id": "demo_price", "label": "Price (e.g. 68 €)" },
        { "type": "text", "id": "demo_meta", "label": "Meta line (e.g. subcollection)" },
        { "type": "text", "id": "demo_image", "label": "Image (asset filename)" },
        { "type": "checkbox", "id": "badge", "label": "Show 'Novedad' badge", "default": false },
        { "type": "header", "content": "Sort / filter data" },
        { "type": "number", "id": "data_price", "label": "Sort price (number)" },
        { "type": "number", "id": "data_new", "label": "Is new (1/0)" },
        { "type": "text", "id": "data_type", "label": "Product type slug" }
      ]
    }
  ]
}
{% endschema %}
