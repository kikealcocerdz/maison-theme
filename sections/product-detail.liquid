    scrollbar-width: none;
    margin: 0 -14px; padding: 0 14px;
  }
  .product-page .product-related .related-grid::-webkit-scrollbar { display: none; }
  .product-page .product-related .related-grid > * { scroll-snap-align: start; }
}
