  .product-page:not(.product-page--set) .product-price-row {
    justify-content: flex-start; margin-bottom: 18px;
  }
  .product-page:not(.product-page--set) .product-price-large { font-size: 26px !important; }
  .product-page:not(.product-page--set) .add-to-bag {
    width: 100% !important; min-height: 54px !important;
