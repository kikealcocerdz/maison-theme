{%- comment -%}
  Product detail (PDP) — 3-column layout: title/breadcrumbs (left, sticky) ·
  gallery with arrows + progress lines + fullscreen lightbox (centre) · accordions
  + price + add-to-cart (right, sticky). Real `product` object with demo fallback
  (CLAUDE.md §7) so it renders before catalog migration.
{%- endcomment -%}

{%- liquid
  assign has_product = false
  if product != blank and product.id
    assign has_product = true
  endif

  assign kicker = product.metafields.custom.kicker | metafield_text
  comment
    El mock rotula "Aurora · Flor de Lis": son las colecciones a las que pertenece
    la pieza. Sin `custom.kicker` se componen de las dos primeras, que es lo que el
    catálogo ya sabe hoy, en vez de dejar el rótulo vacío.
  endcomment
  if kicker == blank and product.collections.size > 0
    assign kicker_parts = ''
    for col in product.collections limit: 2
      if kicker_parts == blank
        assign kicker_parts = col.title
      else
        assign kicker_parts = kicker_parts | append: ' · ' | append: col.title
      endif
    endfor
    assign kicker = kicker_parts
  endif
  if kicker == blank
    assign kicker = section.settings.demo_kicker
  endif

  assign title = product.title | default: section.settings.demo_title
  assign short = product.metafields.custom.short_description | metafield_text
  if short == blank
    assign short = product.excerpt
  endif
  comment
    El mock pone una descripción corta bajo el título. Sin `custom.short_description`
    ni excerpt se toma el arranque de la descripción: recortar por palabras es
    preferible a dejar la columna izquierda coja en 438 fichas.
  endcomment
  if short == blank and product.description != blank
    assign short = product.description | strip_html | truncatewords: 40
  endif
  if short == blank
    assign short = section.settings.demo_short
  endif

  assign description = product.description | default: section.settings.demo_description

  if has_product
    assign price = product.price | money
    if product.compare_at_price > product.price
      assign price = product.compare_at_price | money | prepend: '<s>' | append: '</s> ' | append: price
    endif
  else
    assign price = section.settings.demo_price
  endif

  comment
    Build the gallery image list: real product images, else up to 3 demo assets.
  endcomment
  assign demo_imgs = section.settings.demo_images | default: 'aurora-plate.png,bellavista-plate.png,bone-white.png' | split: ','

  comment
    Set / vajilla layout: the piece-count selector is a plain variant switcher and the
    "Tu pack contiene" rail comes from the variant metafield custom.pack (list of
    `pack_item` metaobjects: producto + cantidad). Demo fallback: `demo_bundles`.
  endcomment
  assign is_set = false
  if section.settings.layout == 'set'
    assign is_set = true
  endif

  assign servicio = product.metafields.custom.servicio | metafield_text | default: section.settings.demo_servicio
  assign current_variant = product.selected_or_first_available_variant

  assign pieces_idx = -1
  assign color_idx = -1
  for opt in product.options_with_values
    assign oname = opt.name | downcase
    if oname contains 'pieza' or oname contains 'unidad'
      assign pieces_idx = opt.position | minus: 1
    endif
    if oname contains 'color'
      assign color_idx = opt.position | minus: 1
    endif
  endfor

  assign current_color = ''
  if color_idx >= 0
    assign current_color = current_variant.options[color_idx]
  endif

  comment
    El cliente pregunta qué es la «P» de «42 P.»: la etiqueta la escribe entera.
    Cuando en el admin renombren la opción, la cadena ya no encuentra nada que
    sustituir y el rótulo pasa tal cual.
  endcomment
  assign current_label = current_variant.title
  if pieces_idx >= 0
    assign current_label = current_variant.options[pieces_idx]
  endif
  assign current_label = current_label | replace: 'P.', 'piezas' | replace: 'p.', 'piezas' | replace: '  ', ' ' | strip

  comment
    Demo bundles (CLAUDE.md §7) — one line per pack:
    `42 piezas | 1.290 € | plato-llano-ceilan:12, sopera-ceilan:1`
  endcomment
  assign demo_bundles = ''
  if is_set and pieces_idx < 0 and section.settings.demo_bundles != blank
    assign demo_bundles = section.settings.demo_bundles | strip | newline_to_br | split: '<br />'
    assign first_bundle = demo_bundles[0] | split: '|'
    assign current_label = first_bundle[0] | replace: 'P.', 'piezas' | replace: 'p.', 'piezas' | replace: '  ', ' ' | strip
    assign price = first_bundle[1] | strip
  endif
-%}

{%- liquid
  assign crumb_collection = product.collections.first
  assign chapter = crumb_collection.metafields.custom.chapter

  comment
    Decorado propio de la pieza para «Descubre la colección» (misma regla que
    product-related, ver snippets/own-collection-handle).
  endcomment
  capture own_handle
    render 'own-collection-handle', product: product
  endcapture
  assign own_handle = own_handle | strip
  assign own_collection = collections[own_handle]
  if own_collection == blank
    assign own_collection = crumb_collection
  endif
-%}
{%- capture breadcrumbs_html -%}
  <div class="product-breadcrumbs">
    <a href="{{ routes.root_url }}">{{ 'sections.collection.home' | t }}</a> /
    <a href="{{ routes.collections_url }}">{{ 'collections.title' | t }}</a>
    {%- if chapter.value.title != blank -%}
      / <a href="{{ chapter.value.url }}">{{ chapter.value.title | escape }}</a>
    {%- elsif chapter != blank -%}
      / <span>{{ chapter | metafield_text | escape }}</span>
    {%- endif -%}
    {%- if crumb_collection != blank -%}
      / <a href="{{ crumb_collection.url }}">{{ crumb_collection.title | escape }}</a>
    {%- endif -%}
  </div>
{%- endcapture -%}

<div class="product-page{% if is_set %} product-page--set{% endif %}" data-section-id="{{ section.id }}" style="--pdp-desc-size: {{ section.settings.description_size | default: 15 }}px;">
  {%- if is_set -%}
    <div class="product-set-above-fold">
      <div class="product-set-breadcrumb-bar">{{ breadcrumbs_html }}</div>
  {%- else -%}
    <div class="product-breadcrumb-bar">{{ breadcrumbs_html }}</div>
  {%- endif -%}
  <section class="product-detail{% if is_set %} product-set-detail{% endif %}" data-product-gallery>

    <aside class="product-title-panel">
      <div class="product-title-sticky{% if is_set %} product-set-title{% endif %}">
        {%- if kicker != blank -%}<p class="product-kicker">{{ kicker | escape }}</p>{%- endif -%}
        {%- if title != blank -%}<h1>{{ title | escape }}</h1>{%- endif -%}
        {%- if short != blank -%}<p class="product-short">{{ short }}</p>{%- endif -%}
      </div>
    </aside>

    <section class="product-gallery-panel{% if is_set %} product-set-gallery{% endif %}" aria-label="{{ 'sections.product.gallery' | t }}">
      <div class="product-main-media">
        <button class="fav product-fav" type="button" data-fav-key="{{ product.url }}" aria-label="{{ 'sections.collection.favorite' | t }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.1c0 5.2-8.8 10.3-8.8 10.3S3.2 13.3 3.2 8.1A4.5 4.5 0 0 1 12 6.6a4.5 4.5 0 0 1 8.8 1.5Z"/></svg>
        </button>
        <button class="product-gallery-arrow prev" type="button" aria-label="{{ 'sections.product.prev' | t }}">‹</button>
        {%- if has_product -%}
          {%- comment -%}
            La foto de la variante elegida abre la galería: con un producto de
            variantes (el mug por letra) la primera imagen tiene que ser la suya.
          {%- endcomment -%}
          {%- assign variant_image_id = current_variant.featured_image.id -%}
          {%- if variant_image_id != blank -%}
            <img class="product-gallery-slide is-active" src="{{ current_variant.featured_image | image_url: width: 1200 }}" alt="{{ current_variant.featured_image.alt | default: product.title | escape }}" width="{{ current_variant.featured_image.width }}" height="{{ current_variant.featured_image.height }}" loading="eager" decoding="async">
          {%- endif -%}
          {%- for image in product.images limit: 6 -%}
            {%- if image.id == variant_image_id -%}{%- continue -%}{%- endif -%}
            <img class="product-gallery-slide{% if forloop.first and variant_image_id == blank %} is-active{% endif %}" src="{{ image | image_url: width: 1200 }}" alt="{{ image.alt | default: product.title | escape }}" width="{{ image.width }}" height="{{ image.height }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" decoding="async">
          {%- endfor -%}
        {%- else -%}
          {%- for img in demo_imgs -%}
            <img class="product-gallery-slide{% if forloop.first %} is-active{% endif %}" src="{{ img | strip | asset_url }}" alt="{{ title | escape }}" width="1200" height="1200" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" decoding="async">
          {%- endfor -%}
        {%- endif -%}
        <button class="product-gallery-arrow next" type="button" aria-label="{{ 'sections.product.next' | t }}">›</button>
        <div class="product-gallery-lines" aria-hidden="true">
          {%- if has_product -%}
            {%- if variant_image_id != blank -%}<span class="active"></span>{%- endif -%}
            {%- for image in product.images limit: 6 -%}
              {%- if image.id == variant_image_id -%}{%- continue -%}{%- endif -%}
              <span{% if forloop.first and variant_image_id == blank %} class="active"{% endif %}></span>
            {%- endfor -%}
          {%- else -%}
            {%- for img in demo_imgs -%}<span{% if forloop.first %} class="active"{% endif %}></span>{%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </section>

    <aside class="product-info-panel">
      <div class="product-info-sticky{% if is_set %} product-set-info{% endif %}">
        {%- if is_set -%}
          <div class="product-set-info-core">
        {%- else -%}
          <div class="product-info-core">
        {%- endif -%}

        {%- comment -%}
          Opciones que no son color ni número de piezas — la letra del mug, por
          ejemplo. Cada valor es un enlace a su variante, así que funciona sin JS
          y la galería abre ya con la foto de esa letra.
        {%- endcomment -%}
        {%- if has_product -%}
          {%- for opt in product.options_with_values -%}
            {%- assign opt_idx = opt.position | minus: 1 -%}
            {%- if opt_idx == color_idx or opt_idx == pieces_idx -%}{%- continue -%}{%- endif -%}
            {%- if opt.values.size < 2 -%}{%- continue -%}{%- endif -%}
            <div class="piece-option-row">
              <span>{{ opt.name | escape }}</span>
              {%- if opt.values.size > 8 -%}
                {%- comment -%}
                  Muchos valores (las 27 letras del mug): desplegable nativo. El form
                  navega a `?variant=` sin JS con el botón; con JS, al cambiar.
                {%- endcomment -%}
                <form class="piece-option-select" method="get" action="{{ product.url }}" data-option-select>
                  <select name="variant" aria-label="{{ opt.name | escape }}">
                    {%- for value in opt.values -%}
                      {%- assign vname = value.name | default: value -%}
                      <option value="{{ value.variant.id }}"{% if vname == current_variant.options[opt_idx] %} selected{% endif %}{% unless value.variant.id %} disabled{% endunless %}>{{ vname | escape }}</option>
                    {%- endfor -%}
                  </select>
                  <noscript><button class="ghost-btn" type="submit">{{ 'sections.product.pieces_selector' | t }}</button></noscript>
                </form>
              {%- else -%}
              <div class="piece-option-values" role="group" aria-label="{{ opt.name | escape }}">
                {%- for value in opt.values -%}
                  {%- assign vname = value.name | default: value -%}
                  {%- assign is_on = false -%}
                  {%- if vname == current_variant.options[opt_idx] -%}{%- assign is_on = true -%}{%- endif -%}
                  {%- if value.variant.id -%}
                    <a class="piece-option{% if is_on %} is-active{% endif %}" href="{{ product.url }}?variant={{ value.variant.id }}"{% if is_on %} aria-current="true"{% endif %}>{{ vname | escape }}</a>
                  {%- else -%}
                    <span class="piece-option is-dead">{{ vname | escape }}</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endif -%}

        {%- comment -%} Selector de color: cualquier producto con una opción "Color" (Flor de Lis azul/rosa…). {%- endcomment -%}
        {%- if color_idx >= 0 -%}
          <div class="piece-color-row">
            <span>{{ 'sections.product.color' | t }}</span>
            <div class="color-options">
              {%- for value in product.options_with_values[color_idx].values -%}
                {%- assign vname = value.name | default: value -%}
                {%- assign swatch = value.swatch.color | default: section.settings.demo_swatch | default: '#6f8797' -%}
                <button class="color-dot{% if vname == current_color %} active{% endif %}" type="button" aria-label="{{ vname | escape }}" style="--swatch: {{ swatch }}"{% if value.variant.id %} data-color-url="{{ product.url }}?variant={{ value.variant.id }}"{% endif %}></button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
        {%- comment -%}
          Piezas hermanas por color cuando cada color es un producto distinto
          (Flor de Lis Azul / Rosa): metafield `custom.color_siblings`
          (lista de referencias a producto) + `custom.swatch` (color o texto hex)
          en cada uno. Si el producto ya tiene opción "Color", manda la opción.
        {%- endcomment -%}
        {%- assign siblings = product.metafields.custom.color_siblings.value -%}
        {%- if color_idx < 0 and siblings != blank and siblings.size > 0 -%}
          {%- assign self_listed = false -%}
          {%- for sib in siblings -%}
            {%- if sib.id == product.id -%}{%- assign self_listed = true -%}{%- endif -%}
          {%- endfor -%}
          <div class="piece-color-row">
            <span>{{ 'sections.product.color' | t }}</span>
            <div class="color-options">
              {%- unless self_listed -%}
                {%- assign own_swatch = product.metafields.custom.swatch.value | default: section.settings.demo_swatch | default: '#6f8797' -%}
                <button class="color-dot active" type="button" aria-current="true" aria-label="{{ title | escape }}" style="--swatch: {{ own_swatch }}"></button>
              {%- endunless -%}
              {%- for sib in siblings -%}
                {%- assign sib_swatch = sib.metafields.custom.swatch.value | default: section.settings.demo_swatch | default: '#6f8797' -%}
                {%- if sib.id == product.id -%}
                  <button class="color-dot active" type="button" aria-current="true" aria-label="{{ sib.title | escape }}" style="--swatch: {{ sib_swatch }}"></button>
                {%- else -%}
                  <button class="color-dot" type="button" aria-label="{{ sib.title | escape }}" style="--swatch: {{ sib_swatch }}" data-color-url="{{ sib.url }}"></button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if is_set and servicio != blank -%}
          <div class="piece-dimension-row">
            <span>{{ 'sections.product.service' | t }}</span>
            <strong>{{ servicio | escape }}</strong>
          </div>
        {%- endif -%}

        {%- comment -%}
          El número de piezas del pack elegido, junto al resto de la ficha: pulsar
          «56 piezas» abajo tenía que verse también aquí (lo pidió el cliente).
        {%- endcomment -%}
        {%- if is_set and current_label != blank -%}
          <div class="piece-dimension-row piece-dimension-row--plain">
            <span>{{ 'sections.product.pieces' | t }}</span>
            <strong data-bundle-label>{{ current_label | escape }}</strong>
          </div>
        {%- endif -%}

        {%- comment -%}
          La medida se ve de primeras, en fila fija y en tinta (no en gris): es el dato
          que más se consulta. El acordeón «Dimensiones» del mismo metafield se salta
          más abajo para no repetirla.
        {%- endcomment -%}
        {%- assign dimensiones = product.metafields.custom.dimensiones -%}
        {%- if dimensiones != blank and dimensiones.value != blank -%}
          <div class="piece-dimension-row piece-dimension-row--plain">
            <span>{{ 'sections.product.dimensions' | t }}</span>
            <strong>{{ dimensiones | metafield_text }}</strong>
          </div>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion' -%}
            {%- liquid
              assign source_metafield = block.settings.source_metafield | strip
              assign source_parts = source_metafield | split: '.'
              assign accordion_metafield = blank
              if source_parts.size == 2 and has_product
                assign source_namespace = source_parts[0]
                assign source_key = source_parts[1]
                assign accordion_metafield = product.metafields[source_namespace][source_key]
              endif

              assign has_accordion_content = false
              if source_metafield == 'custom.dimensiones' and dimensiones != blank and dimensiones.value != blank
                # ya está arriba como fila fija
              elsif accordion_metafield != blank and accordion_metafield.value != blank
                assign has_accordion_content = true
              elsif block.settings.content != blank
                assign has_accordion_content = true
              elsif block.settings.show_description and description != blank
                assign has_accordion_content = true
              endif
            -%}
            {%- if has_accordion_content -%}
              <div class="product-accordion" {{ block.shopify_attributes }}>
                <button type="button">{{ block.settings.label | escape }} <span aria-hidden="true"></span></button>
                <div class="product-accordion__panel"><div class="product-accordion__content">
                  {%- if accordion_metafield != blank and accordion_metafield.value != blank -%}
                    {{ accordion_metafield | metafield_tag }}
                  {%- else -%}
                    {{ block.settings.content }}
                  {%- endif -%}
                  {%- if block.settings.show_description and description != blank -%}
                    <div class="product-description rte">{{ description }}</div>
                  {%- endif -%}
                </div></div>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- unless is_set -%}
          </div>{%- comment -%} /.product-info-core {%- endcomment -%}
        {%- endunless -%}

        {%- if is_set -%}
          </div>{%- comment -%} /.product-set-info-core {%- endcomment -%}

          {%- capture bundle_options_html -%}
            {%- if has_product and pieces_idx >= 0 -%}
              <div class="bundle-options" role="group" aria-label="{{ 'sections.product.pieces_selector' | t }}">
                {%- for v in product.variants -%}
                  {%- if color_idx < 0 or v.options[color_idx] == current_color -%}
                    {%- assign vlabel = v.title -%}
                    {%- if pieces_idx >= 0 -%}{%- assign vlabel = v.options[pieces_idx] -%}{%- endif -%}
                    {%- assign vlabel = vlabel | replace: 'P.', 'piezas' | replace: 'p.', 'piezas' | replace: '  ', ' ' | strip -%}
                    <button class="bundle-option{% if v.id == current_variant.id %} is-active{% endif %}" type="button" data-pack-key="{{ v.id }}" data-variant-id="{{ v.id }}" data-price="{{ v.price | money }}" data-label="{{ vlabel | escape }}"{% unless v.available %} disabled{% endunless %}>{{ vlabel | escape }}</button>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- elsif demo_bundles != blank -%}
              <div class="bundle-options" role="group" aria-label="{{ 'sections.product.pieces_selector' | t }}">
                {%- for row in demo_bundles -%}
                  {%- assign parts = row | split: '|' -%}
                  {%- assign vlabel = parts[0] | replace: 'P.', 'piezas' | replace: 'p.', 'piezas' | replace: '  ', ' ' | strip -%}
                  <button class="bundle-option{% if forloop.first %} is-active{% endif %}" type="button" data-pack-key="{{ vlabel | escape }}" data-variant-id="" data-price="{{ parts[1] | strip | escape }}" data-label="{{ vlabel | escape }}">{{ vlabel | escape }}</button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endcapture -%}

          {%- if has_product -%}
            {%- form 'product', product, class: 'product-buy-block product-set-bundle-footer' -%}
              <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>
              <div class="product-set-price-row">
                {{ bundle_options_html }}
                <span class="product-price-large" data-bundle-price>{{ price }}</span>
              </div>
              <button class="add-to-bag" type="submit" name="add"{% unless product.available %} disabled{% endunless %}>
                {%- if product.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
              </button>
            {%- endform -%}
          {%- else -%}
            <div class="product-buy-block product-set-bundle-footer">
              <div class="product-set-price-row">
                {{ bundle_options_html }}
                <span class="product-price-large" data-bundle-price>{{ price }}</span>
              </div>
              <button class="add-to-bag" type="button">{{ 'products.product.add_to_cart' | t }}</button>
            </div>
          {%- endif -%}
        {%- elsif has_product -%}
          {%- form 'product', product, class: 'product-buy-block' -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <div class="product-price-row">
              <span class="product-price-large">{{ price }}</span>
              <span class="product-price-note">{{ 'sections.product.tax_note' | t }}</span>
            </div>
            <button class="add-to-bag" type="submit" name="add"{% unless product.available %} disabled{% endunless %}>
              {%- if product.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
            </button>
          {%- endform -%}
        {%- else -%}
          <div class="product-buy-block">
            <span class="product-price-large">{{ price }}</span>
            <button class="add-to-bag" type="button">{{ 'products.product.add_to_cart' | t }}</button>
          </div>
        {%- endif -%}
      </div>
    </aside>
  </section>

  {%- if is_set -%}
    {%- comment -%}
      «Tu pack contiene» al estilo atelier del mock Ceilán: vista grande a la izquierda,
      rejilla de piezas a la derecha; pasar el cursor / enfocar / pulsar una pieza la
      lleva a la vista grande. Cada pack sigue en su `.product-set-includes-list`
      (`data-pack-for`) y el selector de piezas de arriba conmuta cuál se ve.
    {%- endcomment -%}
    <section class="product-set-pack" id="tu-pack" aria-label="{{ 'sections.product.pack_intro' | t | strip_html | escape }}" data-pack-atelier data-unit-one="{{ 'sections.product.pack_unit.one' | t | escape }}" data-unit-other="{{ 'sections.product.pack_unit.other' | t | escape }}">
      <header class="product-set-pack-head">
        <div>
          {%- if kicker != blank -%}<p class="product-set-pack-kicker">{{ kicker | escape }}</p>{%- endif -%}
          <h2>{{ 'sections.product.pack_intro' | t }}</h2>
        </div>
        {%- if own_collection != blank -%}
          <a class="ghost-btn" href="{{ own_collection.url }}">{{ 'sections.product.discover_collection' | t }}</a>
        {%- endif -%}
      </header>
      <div class="product-set-pack-layout">
        <figure class="product-set-pack-preview">
          <img alt="" width="900" height="900" data-pack-image>
          <figcaption aria-live="polite" aria-atomic="true">
            <a class="product-set-pack-preview-name" href="#" data-pack-name></a>
            <span class="product-set-pack-preview-qty" data-pack-qty></span>
          </figcaption>
        </figure>
        <div class="product-set-pack-grids">
      {%- if has_product and pieces_idx >= 0 -%}
        {%- for v in product.variants -%}
          {%- if color_idx < 0 or v.options[color_idx] == current_color -%}
            {%- assign items = v.metafields.custom.pack.value -%}
            {%- if items != blank -%}
              <div class="product-set-includes-list{% if v.id == current_variant.id %} is-visible{% endif %}" data-pack-for="{{ v.id }}">
                {%- for item in items -%}
                  {%- assign ip = item.producto.value -%}
                      <a class="product-set-include-card" href="{{ ip.url | default: '#' }}" aria-current="false" data-pack-piece data-src="{{ ip.featured_image | image_url: width: 900 }}" data-url="{{ ip.url | default: '#' }}" data-name="{{ ip.title | escape }}" data-qty="{{ item.cantidad.value }}">
                        {%- if ip.featured_image -%}
                          <img src="{{ ip.featured_image | image_url: width: 480 }}" alt="" width="{{ ip.featured_image.width }}" height="{{ ip.featured_image.height }}" loading="lazy" decoding="async">
                        {%- endif -%}
                        <span class="product-set-include-name">{{ ip.title | escape }}</span>
                        <span class="product-set-include-qty">× {{ item.cantidad.value }}</span>
                      </a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- elsif demo_bundles != blank -%}
        {%- for row in demo_bundles -%}
          {%- assign parts = row | split: '|' -%}
          {%- assign raw_items = parts[2] | default: '' | split: ',' -%}
          {%- comment -%} La clave tiene que coincidir con la del botón, ya reescrita a «piezas». {%- endcomment -%}
          {%- assign pack_key = parts[0] | replace: 'P.', 'piezas' | replace: 'p.', 'piezas' | replace: '  ', ' ' | strip -%}
          <div class="product-set-includes-list{% if forloop.first %} is-visible{% endif %}" data-pack-for="{{ pack_key | escape }}">
            {%- for raw in raw_items -%}
              {%- assign bits = raw | strip | split: ':' -%}
              {%- assign ip = all_products[bits[0]] -%}
                <a class="product-set-include-card" href="{{ ip.url | default: '#' }}" aria-current="false" data-pack-piece data-src="{{ ip.featured_image | image_url: width: 900 }}" data-url="{{ ip.url | default: '#' }}" data-name="{{ ip.title | default: bits[0] | escape }}" data-qty="{{ bits[1] | strip | default: 1 }}">
                  {%- if ip.featured_image -%}
                    <img src="{{ ip.featured_image | image_url: width: 480 }}" alt="" width="{{ ip.featured_image.width }}" height="{{ ip.featured_image.height }}" loading="lazy" decoding="async">
                  {%- endif -%}
                  <span class="product-set-include-name">{{ ip.title | default: bits[0] | escape }}</span>
                  <span class="product-set-include-qty">× {{ bits[1] | strip | default: 1 }}</span>
                </a>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
        </div>
      </div>
      <p class="product-set-pack-note"><span>{{ 'sections.product.pack_hint' | t }}</span><strong data-bundle-label>{{ current_label | escape }}</strong></p>
    </section>
    </div>{%- comment -%} /.product-set-above-fold {%- endcomment -%}
  {%- endif -%}

  {%- comment -%} Sticky add-to-cart: shows when the buy block scrolls out of view {%- endcomment -%}
  <div class="pdp-sticky-bar" aria-hidden="true" data-pdp-sticky>
    <div class="pdp-sticky-bar__inner">
      <div class="pdp-sticky-bar__info">
        {%- if title != blank -%}<span class="pdp-sticky-bar__title">{{ title | escape }}</span>{%- endif -%}
        <span class="pdp-sticky-bar__price" data-sticky-price>{{ price }}</span>
      </div>
      <button class="add-to-bag pdp-sticky-bar__btn" type="button" data-pdp-sticky-add{% if has_product and product.available == false %} disabled{% endif %}>
        {%- if has_product and product.available == false -%}{{ 'products.product.sold_out' | t }}{%- else -%}{{ 'products.product.add_to_cart' | t }}{%- endif -%}
      </button>
    </div>
  </div>
</div>

{%- comment -%} Fullscreen gallery lightbox {%- endcomment -%}
<div class="product-lightbox" id="productLightbox" aria-hidden="true">
  <button class="lightbox-close" type="button" aria-label="{{ 'sections.product.close' | t }}">{% render 'icon-close' %}</button>
  <aside class="lightbox-thumbs" aria-label="{{ 'sections.product.thumbs' | t }}">
    {%- if has_product -%}
      {%- for image in product.images limit: 6 -%}
        <button type="button" data-target="{{ forloop.index0 }}"{% if forloop.first %} class="active"{% endif %}><img src="{{ image | image_url: width: 160 }}" alt="" width="74" height="92" loading="lazy"></button>
      {%- endfor -%}
    {%- else -%}
      {%- for img in demo_imgs -%}
        <button type="button" data-target="{{ forloop.index0 }}"{% if forloop.first %} class="active"{% endif %}><img src="{{ img | strip | asset_url }}" alt="" width="74" height="92" loading="lazy"></button>
      {%- endfor -%}
    {%- endif -%}
  </aside>
  <div class="lightbox-scroll">
    {%- if has_product -%}
      {%- for image in product.images limit: 6 -%}
        <figure data-index="{{ forloop.index0 }}"><img src="{{ image | image_url: width: 1600 }}" alt="{{ image.alt | default: product.title | escape }}" width="{{ image.width }}" height="{{ image.height }}" loading="lazy"></figure>
      {%- endfor -%}
    {%- else -%}
      {%- for img in demo_imgs -%}
        <figure data-index="{{ forloop.index0 }}"><img src="{{ img | strip | asset_url }}" alt="{{ title | escape }}" width="1600" height="1600" loading="lazy"></figure>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.product-page { padding-top: var(--header-h); background: var(--paper); color: var(--ink); }
.product-detail { width: var(--content); margin: 0 auto; display: grid; grid-template-columns: minmax(220px, 25%) minmax(420px, 44%) minmax(280px, 31%); gap: min(4vw, 70px); align-items: start; padding-bottom: 6vh; }

.product-title-panel, .product-info-panel { display: flex; justify-content:center; height: 100%; }
.product-title-sticky { position: relative; top: auto; padding-top: 24vh; }
.product-breadcrumbs { position: absolute; top: 18px; left: 0; font-size: 10px; letter-spacing: .08em; color: var(--muted); white-space: nowrap; }
.product-breadcrumbs a { text-decoration: underline; text-underline-offset: 3px; }
.product-kicker { font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: var(--muted); margin: 0 0 18px; }
.product-title-panel h1 { font-family: var(--serif); font-weight: 400; font-size: clamp(46px, 4.7vw, 82px); line-height: .92; margin: 0; color: var(--ink); font-variant: small-caps; letter-spacing: .01em; }
.product-short { font-size: 14px; line-height: 1.7; color: var(--muted); max-width: 340px; margin: 22px 0 0; }

.product-gallery-panel { display: flex; align-items: center; justify-content: center; padding: 28px 0 38px; }
.product-main-media { position: relative; width: 100%; height: min(76vh, 780px); background: var(--product-bg); display: flex; align-items: center; justify-content: center; overflow: hidden; cursor: zoom-in; }
.product-main-media .product-gallery-slide { position: absolute; opacity: 0; transform: translateX(100%); transition: transform 620ms var(--ease-long), opacity 380ms var(--ease); will-change: transform, opacity; }
.product-main-media .product-gallery-slide.is-active { opacity: 1; transform: translateX(0); z-index: 1; }
.product-main-media .product-gallery-slide.is-prev { opacity: 0; transform: translateX(-100%); }
.product-fav { position: absolute; right: 18px; top: 16px; width: 32px; height: 32px; display: grid; place-items: center; color: var(--ink); opacity: .7; z-index: 5; }
.product-fav svg { width: 16px; height: 16px; stroke: currentColor; stroke-width: 1; fill: none; }
.product-fav.active svg { fill: currentColor; }
.product-gallery-arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 5; width: 34px; height: 34px; border-radius: 999px; background: rgba(255, 255, 255, .84); font-size: 18px; line-height: 1; display: grid; place-items: center; color: var(--ink); transition: background 260ms var(--ease); }
.product-gallery-arrow:hover { background: var(--paper); }
.product-gallery-arrow.prev { left: 18px; } .product-gallery-arrow.next { right: 18px; }
.product-gallery-lines { position: absolute; left: 0; right: 0; bottom: 18px; display: flex; justify-content: center; gap: 8px; z-index: 5; }
.product-gallery-lines span { width: 26px; height: 1px; background: rgba(15, 26, 46, .22); transition: background 220ms var(--ease), width 220ms var(--ease); }
.product-gallery-lines span.active { background: var(--ink); width: 34px; }

.product-info-sticky { position: relative; top: auto; padding-top: 18vh; display: flex; flex-direction: column; justify-content: flex-start; min-height: min(740px, calc(100vh - var(--header-h) - 18px)); transition: padding-top 360ms var(--ease-long); }
.product-detail.info-expanded .product-info-sticky { padding-top: 5vh; }
.product-description { margin: 0; color: var(--ink-soft); font-size: var(--pdp-desc-size, 15px); line-height: 1.7; }
.product-description > :first-child { margin-top: 0; }
.product-description > :last-child { margin-bottom: 0; }
.product-description p { margin: 0 0 12px; }
.product-description h1, .product-description h2, .product-description h3, .product-description h4 { font-family: var(--serif); font-weight: 400; color: var(--ink); line-height: 1.25; margin: 22px 0 10px; }
.product-description h2 { font-size: 21px; } .product-description h3 { font-size: 17px; } .product-description h4 { font-size: 14px; }
.product-description ul, .product-description ol { margin: 0 0 12px; padding-left: 18px; }
.product-description li { margin-bottom: 5px; }
.product-description a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
.product-description strong { color: var(--ink); }
.product-description img { max-width: 100%; height: auto; margin: 14px 0; }

.product-accordion { border-bottom: .5px solid var(--rule); }
.product-accordion:first-of-type { border-top: .5px solid var(--rule); }
.product-accordion button { width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 17px 0; font-size: 14px; color: var(--ink); }
.product-accordion button span { font-size: 0; width: 16px; height: 16px; display: grid; place-items: center; }
.product-accordion button span::before { content: "+"; font-size: 16px; line-height: 1; }
.product-accordion.is-open button span::before { content: "−"; font-size: 18px; }
.product-accordion__panel { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 320ms var(--ease); overflow: hidden; }
.product-accordion.is-open .product-accordion__panel { grid-template-rows: 1fr; }
.product-accordion__content { overflow: hidden; min-height: 0; padding-bottom: 0; transition: padding-bottom 320ms var(--ease); }
.product-accordion.is-open .product-accordion__content { padding-bottom: 14px; }
.product-accordion__content > * { margin: 0; font-size: 14px; line-height: 1.62; color: var(--muted); padding-right: 4px; }
.product-accordion__content > * + * { margin-top: 8px; }
.product-buy-block { margin-top: 22px; display: grid; gap: 18px; background: var(--paper); }
.product-price-large { font-family: var(--serif); font-size: 30px; line-height: 1; text-align: right; color: var(--ink); }
.add-to-bag { height: 54px; background: var(--ink); color: #fff; font-size: 10px; letter-spacing: .2em; text-transform: uppercase; width: 100%; transition: background 260ms var(--ease); }
.add-to-bag:hover { background: #24314a; }
.add-to-bag[disabled] { opacity: .5; cursor: default; }

/* Fullscreen lightbox */
.product-lightbox { position: fixed; inset: 0; background: var(--paper); z-index: 300; display: grid; grid-template-columns: 128px minmax(0, 1fr); opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 320ms var(--ease), visibility 0s linear 320ms; }
.product-lightbox.is-open { opacity: 1; visibility: visible; pointer-events: auto; transition: opacity 320ms var(--ease), visibility 0s linear 0s; }
.lightbox-close { position: fixed; top: 18px; right: 24px; z-index: 310; width: 44px; height: 44px; display: grid; place-items: center; color: var(--ink); }
.lightbox-close svg { width: 22px; height: 22px; }
.lightbox-thumbs { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; gap: 10px; align-items: center; justify-content: center; border-right: .5px solid var(--rule); background: var(--paper); z-index: 305; }
.lightbox-thumbs button { width: 74px; height: 92px; border: .5px solid transparent; background: var(--ink-faint-20); padding: 5px; opacity: .55; transition: opacity 220ms var(--ease), border-color 220ms var(--ease), transform 220ms var(--ease); }
.lightbox-thumbs button.active { opacity: 1; border-color: var(--ink); transform: translateX(5px); }
.lightbox-thumbs img { width: 100%; height: 100%; object-fit: contain; }
.lightbox-scroll { height: 100vh; overflow-y: auto; scroll-snap-type: y proximity; background: var(--paper); }
.lightbox-scroll figure { height: 100vh; margin: 0; display: grid; place-items: center; scroll-snap-align: start; background: #f6f7f8; }
.lightbox-scroll figure img { width: min(76vw, 1120px); height: 86vh; object-fit: contain; }

@media (max-width: 1180px) {
  .product-detail { grid-template-columns: 1fr; max-width: 900px; gap: 0; }
  .product-title-panel, .product-info-panel, .product-gallery-panel { min-height: auto; }
  .product-title-sticky, .product-info-sticky { position: relative; top: auto; padding-top: 0; min-height: auto; }
  .product-title-panel { padding-top: 72px; }
  .product-breadcrumbs { position: relative; top: auto; margin-bottom: 42px; white-space: normal; }
  .product-gallery-panel { padding: 42px 0; }
  .product-main-media { height: min(74vh, 720px); }
  .product-short { max-width: 560px; }
  .product-buy-block { margin-top: 34px; }
  .product-price-large { text-align: left; }
}
@media (max-width: 620px) {
  .product-detail { width: calc(100vw - 24px); }
  .product-title-panel h1 { font-size: 42px; }
  .product-main-media { height: 64vh; }
  .product-gallery-arrow { width: 30px; height: 30px; }
  .add-to-bag { height: 52px; }
  .product-buy-block { border-top: .5px solid var(--rule); padding: 16px 0 18px; background: var(--paper); }
  .product-lightbox { grid-template-columns: 72px 1fr; }
  .lightbox-thumbs button { width: 46px; height: 62px; }
  .lightbox-close { top: 14px; right: 18px; }
  .lightbox-scroll figure img { width: 82vw; height: 80vh; }
}

.pdp-sticky-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; background: var(--paper); border-top: .5px solid var(--rule); transform: translateY(100%); transition: transform 320ms var(--ease); pointer-events: none; }
.pdp-sticky-bar.is-visible { transform: translateY(0); pointer-events: auto; }
.pdp-sticky-bar__inner { width: var(--content); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 12px 0; }
.pdp-sticky-bar__info { display: flex; align-items: baseline; gap: 16px; min-width: 0; }
.pdp-sticky-bar__title { font-family: var(--serif); font-size: 17px; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pdp-sticky-bar__price { font-family: var(--serif); font-size: 17px; color: var(--ink); white-space: nowrap; }
.pdp-sticky-bar__btn { width: auto; min-width: 220px; height: 48px; padding: 0 32px; flex: none; }
@media (max-width: 620px) {
  .pdp-sticky-bar__inner { width: calc(100vw - 24px); gap: 12px; }
  .pdp-sticky-bar__title { display: none; }
  .pdp-sticky-bar__btn { flex: 1; min-width: 0; padding: 0 16px; }
}

/* ===== Set / vajilla layout (templates/product.set.json) ===== */
.product-set-breadcrumb-bar { width: var(--content); margin: 0 auto; padding: 18px 0 12px; }
.product-set-breadcrumb-bar .product-breadcrumbs { position: relative; top: auto; left: auto; font-size: 12px; letter-spacing: .04em; line-height: 1.4; }
.product-set-detail { width: var(--content); max-width: none; height: calc(100svh - var(--header-h) - 50px); min-height: min(630px, calc(100svh - var(--header-h) - 50px)); grid-template-columns: minmax(220px, 25%) minmax(420px, 44%) minmax(310px, 31%); align-items: center; padding-bottom: 0; }
.product-set-detail .product-title-panel, .product-set-detail .product-info-panel, .product-set-gallery { height: min(72vh, 735px); min-height: 0; }
.product-set-title, .product-set-info { position: relative; top: auto; padding: 0; width: 100%; height: 100%; box-sizing: border-box; }
.product-set-title { display: flex; flex-direction: column; justify-content: center; padding-right: min(2vw, 28px); }
.product-page--set .product-title-panel h1 { font-size: clamp(38px, 3.35vw, 58px); line-height: .96; }
.product-set-title .product-short { font-size: 14px; line-height: 1.78; max-width: 390px; margin-top: 18px; }
.product-set-gallery { padding: 0; display: flex; align-items: center; }
.product-set-gallery .product-main-media { height: min(72vh, 735px); width: 100%; margin: 0; }
.product-set-info { display: grid; grid-template-rows: minmax(0, 1fr) auto; gap: 14px; min-height: 0; }
.product-page--set .product-detail .product-info-sticky,
.product-page--set .product-detail.info-expanded .product-info-sticky { padding-top: 0; }
.product-set-info-core { min-height: 0; display: flex; flex-direction: column; justify-content: center; overflow: auto; scrollbar-width: none; padding-right: 2px; }
.product-set-info-core::-webkit-scrollbar { display: none; }
.product-set-info-core .product-accordion button { padding: 14px 0; }

.piece-color-row, .piece-dimension-row { display: grid; grid-template-columns: 110px 1fr; gap: 24px; padding: 14px 0; border-bottom: .5px solid var(--rule); font-size: 14px; align-items: center; }
.piece-color-row > span, .piece-dimension-row > span { font-weight: 400; }
.piece-dimension-row strong { font-weight: 300; text-align: right; color: var(--muted); }
/* Opciones sueltas (letra del mug…): pastillas que enlazan a su variante. */
.piece-option-row { display: grid; grid-template-columns: 110px 1fr; gap: 24px; padding: 14px 0; border-bottom: .5px solid var(--rule); font-size: 14px; align-items: center; }
.piece-option-values { display: flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; }
.piece-option {
  display: inline-flex; align-items: center; justify-content: center;
  min-width: 34px; min-height: 34px; padding: 0 10px;
  border: .5px solid var(--rule); font-size: 12px; color: var(--ink-soft);
  transition: border-color 200ms var(--ease), color 200ms var(--ease);
}
.piece-option:hover { border-color: var(--ink); color: var(--ink); }
.piece-option.is-active { background: var(--ink); border-color: var(--ink); color: var(--paper); }
.piece-option.is-dead { opacity: .35; }
.piece-option-select { display: flex; justify-content: flex-end; gap: 8px; }
.piece-option-select select {
  min-height: 38px; padding: 0 36px 0 12px; border: .5px solid var(--rule); border-radius: 0;
  background: var(--paper) url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8'><path d='M1 1l5 5 5-5' fill='none' stroke='%230F1A2E' stroke-width='1.2'/></svg>") no-repeat right 12px center;
  font: inherit; font-size: 13px; color: var(--ink); appearance: none; -webkit-appearance: none; cursor: pointer;
}
.piece-option-select select:focus-visible { outline: 1px solid var(--ink); outline-offset: 2px; }
@media (max-width: 1180px) {
  .piece-option-row { grid-template-columns: 1fr; gap: 8px; }
  .piece-option-values, .piece-option-select { justify-content: flex-start; }
  .piece-option-select select { width: 100%; }
}

/* La medida fija se lee de primeras: tinta, no gris. */
.piece-dimension-row--plain strong { color: var(--ink); }
.color-options { display: flex; gap: 10px; justify-content: flex-end; }
.color-dot { width: 24px; height: 24px; border-radius: 50%; border: 1px solid transparent; padding: 3px; background: var(--paper); }
.color-dot::before { content: ""; display: block; width: 100%; height: 100%; border-radius: 50%; background: var(--swatch); }
.color-dot.active { border-color: var(--ink); }

.product-set-bundle-footer { margin-top: 0; border-top: .5px solid var(--rule); padding-top: 12px; display: grid; gap: 14px; background: var(--paper); }
.product-set-bundle-footer > .add-to-bag { width: 100%; height: 44px; }
.product-set-price-row { display: grid; grid-template-columns: minmax(228px, auto) 1fr; align-items: center; gap: 18px; }
.product-set-price-row .bundle-options { grid-column: 1; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(108px, 1fr); gap: 8px; min-width: 244px; width: max-content; }
.product-set-price-row .product-price-large { grid-column: 2; justify-self: end; text-align: right; margin: 0; white-space: nowrap; }
.bundle-option { height: 42px; padding: 0 18px; border-radius: 999px; border: 1px solid rgba(8, 40, 107, .22); background: var(--paper); color: #08286b; font-size: 10px; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; transition: background 300ms var(--ease), color 300ms var(--ease), border-color 300ms var(--ease), transform 300ms var(--ease); }
.bundle-option:hover { border-color: #08286b; transform: translateY(-1px); }
.bundle-option.is-active { background: #08286b; border-color: #08286b; color: #fff; box-shadow: 0 10px 26px rgba(8, 40, 107, .16); }
.bundle-option[disabled] { opacity: .4; cursor: default; transform: none; }

.product-set-pack { width: var(--content); margin: 18px auto 88px; padding: 30px 0 0; border-top: .5px solid var(--rule); color: #08286b; }
.product-set-pack-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; margin: 0 0 20px; }
.product-set-pack-kicker { margin: 0 0 6px; font: 500 10px/1.4 var(--sans); letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
.product-set-pack-head h2 { margin: 0; font: 400 clamp(26px, 2.4vw, 36px)/1.1 var(--serif); letter-spacing: -.02em; color: var(--ink); }
.product-set-pack-layout { display: grid; grid-template-columns: minmax(220px, .9fr) minmax(0, 2.5fr); gap: 24px; }
.product-set-pack-preview { margin: 0; min-width: 0; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 16px 20px; background: #f4f5f7; border-radius: 4px; }
.product-set-pack-preview img { display: block; width: 100%; height: 220px; object-fit: contain; mix-blend-mode: multiply; }
.product-set-pack-preview img:not([src]) { visibility: hidden; }
.product-set-pack-preview figcaption { width: 100%; padding-top: 10px; text-align: center; }
.product-set-pack-preview-name { display: block; font: 400 26px/1.1 var(--serif); color: var(--ink); }
.product-set-pack-preview-qty { display: block; margin-top: 7px; font: 400 12px/1.5 var(--sans); color: var(--muted); }
.product-set-includes-list { display: none; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; align-content: start; }
.product-set-includes-list.is-visible { display: grid; }
.product-set-include-card { appearance: none; position: relative; min-width: 0; display: flex; flex-direction: column; align-items: center; padding: 12px 8px 10px; background: var(--paper); color: #08286b; border: 1px solid var(--rule); border-radius: 4px; cursor: pointer; text-align: center; transition: background 180ms var(--ease), border-color 180ms var(--ease), box-shadow 180ms var(--ease); }
