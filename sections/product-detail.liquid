  /* Especificaciones: etiqueta a la izquierda, valor a la derecha, con filete. */
  .product-page:not(.product-page--set) .piece-color-row,
  .product-page:not(.product-page--set) .piece-dimension-row {
    display: flex !important; align-items: center; justify-content: space-between;
    gap: 18px; padding: 16px 0 !important; border-bottom: .5px solid var(--rule);
  }
  .product-page:not(.product-page--set) .piece-color-row > span,
  .product-page:not(.product-page--set) .piece-dimension-row > span {
