    font-family: var(--sans); font-size: 13px; font-weight: 400;
  }

  /* Los trazos de la galería pasan a puntos, como en el mock móvil. */
  .product-page:not(.product-page--set) .product-gallery-lines span {
    width: 6px !important; height: 6px !important; border-radius: 50%;
  }

  /* La foto entra entera y pegada arriba: al cargar se veía recortada y con un
     hueco por encima. El fondo pasa a papel porque `contain` deja aire a los lados. */
  .product-page .product-detail { padding-top: 6px !important; gap: 12px !important; }
  .product-page .product-main-media { background: var(--product-bg) !important; }
  .product-page .product-main-media .product-gallery-slide { object-fit: contain !important; }
  .product-page:not(.product-page--set) .product-title-sticky { padding: 10px 2px 14px !important; }

