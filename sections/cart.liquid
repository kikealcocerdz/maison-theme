{
  "name": "t:general.cart",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Desde 1841" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Su cesta" },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Encuadre de la miniatura",
      "default": "contain",
      "info": "\"Pieza completa\" evita el recorte que el cliente señaló en las tarjetas de catálogo.",
      "options": [
        { "value": "contain", "label": "Pieza completa" },
        { "value": "cover", "label": "Recortada al marco" }
      ]
    },
    { "type": "header", "content": "Envío" },
    { "type": "checkbox", "id": "show_shipping", "label": "Mostrar la fila de envío", "default": true },
    { "type": "number", "id": "free_shipping_threshold", "label": "Envío gratuito a partir de (€)", "default": 150 },
    {
      "type": "number",
      "id": "shipping_flat_rate",
      "label": "Tarifa de envío peninsular (€)",
      "default": 7,
      "info": "Escribe la tarifa real: hoy la tienda publica 6,99 €. Si no coincide con Configuración → Envíos, el total de la cesta no cuadrará con el del checkout. (El valor por defecto es 7 porque Shopify solo admite un decimal en los defaults de schema.)"
    },
    { "type": "header", "content": "Envoltorio de regalo" },
    {
      "type": "product",
      "id": "gift_wrap_product",
      "label": "Producto de envoltorio",
      "info": "Se cobra como una línea más. Sin producto asignado, la opción no se muestra."
    },
    { "type": "header", "content": "Nota del resumen" },
    {
      "type": "richtext",
      "id": "summary_note",
      "label": "Nota",
      "default": "<p>Envío gratuito a partir de 150 €. Entrega en 7 días hábiles si la pieza está en stock; entre 15 y 21 si está en producción.</p><p><strong>Devoluciones</strong> durante 14 días naturales. Cada pieza viaja embalada a mano.</p>"
    },
    { "type": "header", "content": "Cesta vacía" },
    {
      "type": "inline_richtext",
      "id": "empty_heading",
      "label": "Titular",
      "default": "La cesta está <em>vacía.</em>"
    }
  ]
