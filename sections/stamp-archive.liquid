{%- comment -%}
  Archivo histórico de sellos (/pages/identifica-tu-sello).

  Port de mock_final/Cartuja/identifica-tu-sello.html + styles/sellos.css.
  El coverflow es scroll-driven (patrón de CLAUDE.md §9): la sección crece hasta
  window.innerHeight + scrollDistance y un bucle rAF coloca las 80 tarjetas en 3D
  según el progreso. Los datos y la lógica viven en assets/sellos.js — son ~57 KB
  que solo usa esta página, así que no entran en el bundle global de secciones.
{%- endcomment -%}

<main
  class="stamp-page"
  data-stamp-archive
  data-section-id="{{ section.id }}"
  data-asset-base="{{ 'stamp-01.webp' | asset_url | split: 'stamp-01.webp' | first }}"
  data-archive-src="{{ 'sellos.js' | asset_url }}"
  data-label-seal="{{ 'sections.stamps.seal' | t }}"
  data-label-decade="{{ 'sections.stamps.go_to_decade' | t }}"
  data-label-zoom-in="{{ 'sections.stamps.zoom_in' | t }}"
  data-label-zoom-out="{{ 'sections.stamps.zoom_out' | t }}"
>
  <section class="stamp-hero-premium">
    <div class="stamp-hero-copy">
      {%- if section.settings.heading != blank -%}<h1>{{ section.settings.heading | escape }}</h1>{%- endif -%}
      {%- if section.settings.intro != blank -%}<p class="stamp-intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
    </div>
    <div class="stamp-hero-stage" aria-hidden="true">
      <span class="stamp-year y1">{{ section.settings.year_from | escape }}</span>
      <span class="stamp-year y2">{{ section.settings.year_to | escape }}</span>
      {%- comment -%} Tres sellos sueltos como decorado; viajan en /assets. {%- endcomment -%}
      {%- assign hero_seals = '03,13,15' | split: ',' -%}
      {%- for n in hero_seals -%}
        <div class="hero-seal-card hs{{ forloop.index }}">
          <span>{{ n }}</span>
          <img src="{{ 'stamp-' | append: n | append: '.webp' | asset_url }}" alt="" width="500" height="500" loading="lazy" decoding="async">
        </div>
      {%- endfor -%}
      <div class="stamp-orbit-line"></div>
    </div>
  </section>

  <section class="stamp-horizontal-story" id="archivo" aria-label="{{ 'sections.stamps.archive_label' | t }}">
    <div class="stamp-scroll-pin">
      <div class="stamp-archive-head">
        <div class="stamp-archive-title">
          {%- if section.settings.archive_kicker != blank -%}<p>{{ section.settings.archive_kicker | escape }}</p>{%- endif -%}
          {%- if section.settings.archive_heading != blank -%}<h2>{{ section.settings.archive_heading | escape }}</h2>{%- endif -%}
        </div>
        <nav class="stamp-era-menu" id="stampEraMenu" aria-label="{{ 'sections.stamps.jump_decade' | t }}"></nav>
        <div class="stamp-archive-status">
          <span id="stampCurrentEra"></span>
          <small><b id="stampCurrentIndex">01</b> / <span id="stampTotal">00</span></small>
        </div>
      </div>

      <div class="stamp-coverflow-viewport" id="stampViewport" tabindex="0" aria-label="{{ 'sections.stamps.viewport_hint' | t }}">
        <div class="stamp-coverflow-track" id="stampTrack" aria-live="polite"></div>
        <div class="stamp-active-caption" id="stampActiveCaption" aria-live="polite">
          <p class="stamp-caption-period" id="stampCaptionPeriod"></p>
          <p class="stamp-caption-desc" id="stampCaptionDesc"></p>
        </div>
      </div>

      <div class="stamp-timeline-wrap" aria-label="{{ 'sections.stamps.timeline_label' | t }}">
        <div class="stamp-timeline-labels">
          <span id="timelineStart"></span>
          <strong id="timelineCurrent"></strong>
          <span id="timelineEnd"></span>
        </div>
        <button class="stamp-progress-track" id="stampProgressTrack" type="button" aria-label="{{ 'sections.stamps.timeline_seek' | t }}">
          <span class="stamp-progress-fill" id="stampProgressFill"></span>
          <i class="stamp-progress-thumb" id="stampProgressThumb"></i>
          <span class="stamp-timeline-ticks" id="stampTimelineTicks"></span>
        </button>
      </div>

      <div class="stamp-scroll-cue">
        <span>{{ 'sections.stamps.scroll' | t }}</span><i></i><em>{{ 'sections.stamps.scroll_hint' | t }}</em>
      </div>
    </div>
  </section>
</main>

<div class="stamp-modal" id="stampDrawer" aria-hidden="true">
  <div class="stamp-modal-backdrop" id="stampBackdrop"></div>
  <article class="stamp-modal-card">
    <button class="stamp-close" id="stampClose" aria-label="{{ 'general.accessibility.close' | t }}">&times;</button>
    <div class="stamp-modal-left">
      <div class="big-no" id="drawerNo"></div>
      <button class="stamp-modal-image" id="stampZoomTrigger" type="button" aria-label="{{ 'sections.stamps.zoom_in' | t }}" aria-expanded="false">
        <img id="drawerImage" alt="" width="500" height="500" decoding="async">
        <span class="stamp-zoom-hint">{{ 'sections.stamps.zoom_in' | t }}</span>
      </button>
    </div>
    <div class="stamp-modal-copy">
      <p class="modal-kicker">{{ 'sections.stamps.modal_kicker' | t }}</p>
      <h2 id="drawerTitle"></h2>
      <div class="period" id="drawerPeriod"></div>
      <div class="modal-rule"></div>
      <p class="desc" id="drawerDesc"></p>
      <div class="modal-nav">
        <button type="button" id="stampPrev">&larr; {{ 'general.accessibility.previous' | t }}</button>
        <button type="button" id="stampNext">{{ 'general.accessibility.next' | t }} &rarr;</button>
      </div>
    </div>
  </article>
</div>

{% stylesheet %}
:root{
  --seal-blue:#08286b;
  --seal-deep:#061b4d;
  --seal-deeper:#04163e;
  --seal-paper:#f4f3ef;
  --seal-line:rgba(255,255,255,.18);
  --seal-card-w:clamp(270px,22vw,350px);
}.stamp-page{padding-top:var(--header-h);background:#fff;color:var(--ink)}/* HERO RESTAURADO */
.stamp-hero-premium{min-height:calc(100vh - var(--header-h));display:grid;grid-template-columns:42% 58%;overflow:hidden;border-bottom:.5px solid var(--rule)}.stamp-hero-copy{padding:10vh 5vw 8vh 7vw;display:flex;flex-direction:column;justify-content:center}.stamp-kicker,.stamp-modal .modal-kicker{font:400 10px/1 var(--sans);letter-spacing:.2em;text-transform:uppercase;color:#63708e}.stamp-hero-copy h1{font:400 clamp(72px,8vw,150px)/.82 var(--serif);letter-spacing:-.045em;margin:24px 0 34px;color:#071c50}.stamp-intro{font:300 15px/1.85 var(--sans);max-width:520px;color:#5b6270}.stamp-hero-link{margin-top:50px;width:max-content;border-bottom:1px solid #08286b;padding-bottom:8px;font:400 11px/1 var(--sans);letter-spacing:.08em;text-transform:uppercase;color:#08286b}.stamp-hero-link span{margin-left:18px}.stamp-hero-stage{position:relative;background:var(--seal-paper);overflow:hidden;isolation:isolate}.stamp-hero-stage:before{content:"";position:absolute;inset:8%;border:1px solid rgba(8,40,107,.12);border-radius:50%;transform:scale(1.1)}.stamp-orbit-line{position:absolute;left:50%;top:50%;width:72%;aspect-ratio:1;border:1px solid rgba(8,40,107,.16);border-radius:50%;transform:translate(-50%,-50%)}.stamp-year{position:absolute;font:400 clamp(90px,11vw,210px)/1 var(--serif);color:rgba(8,40,107,.055);z-index:-1}.stamp-year.y1{left:2%;top:4%}.stamp-year.y2{right:-3%;bottom:2%}.stamp-page .hero-seal-card{position:absolute;background:#fff;box-shadow:0 30px 80px rgba(10,25,55,.11);display:grid;place-items:center;transition:transform .8s cubic-bezier(.2,.8,.2,1)}.stamp-page .hero-seal-card img{width:72%;height:72%;object-fit:contain;filter:grayscale(1) contrast(1.05)}.stamp-page .hero-seal-card span{position:absolute;left:14px;top:12px;font:500 9px/1 var(--sans);letter-spacing:.16em;color:#8d95a5}.stamp-page .hs1{width:28%;aspect-ratio:.84;left:13%;top:18%;transform:rotate(-8deg)}.stamp-page .hs2{width:33%;aspect-ratio:.84;left:39%;top:29%;z-index:2;transform:rotate(3deg)}.stamp-page .hs3{width:25%;aspect-ratio:.84;right:7%;top:12%;transform:rotate(10deg)}.stamp-hero-stage:hover .hs1{transform:rotate(-11deg) translate(-8px,-8px)}.stamp-hero-stage:hover .hs2{transform:rotate(1deg) translateY(-12px)}.stamp-hero-stage:hover .hs3{transform:rotate(13deg) translate(8px,-6px)}/* SCROLL STORY: vertical page scroll -> horizontal archive */
.stamp-horizontal-story{position:relative;background:var(--seal-deep);color:#fff;--story-distance:6000px}.stamp-scroll-pin{position:sticky;top:0;height:100svh;overflow:hidden;isolation:isolate;padding-top:var(--header-h);background:
  radial-gradient(circle at 18% 30%,rgba(42,83,159,.17),transparent 33%),
  radial-gradient(circle at 82% 62%,rgba(25,64,132,.16),transparent 38%),
  linear-gradient(180deg,var(--seal-deep),var(--seal-deeper));
}.stamp-scroll-pin:before{content:"";position:absolute;inset:var(--header-h) 0 0;pointer-events:none;z-index:0;background-image:linear-gradient(rgba(255,255,255,.016) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.012) 1px,transparent 1px);background-size:82px 82px;mask-image:linear-gradient(to bottom,transparent,rgba(0,0,0,.6) 16%,rgba(0,0,0,.45) 84%,transparent)}.stamp-scroll-pin:after{content:"";position:absolute;z-index:12;inset:var(--header-h) 0 0;pointer-events:none;box-shadow:inset 8vw 0 8vw -8vw rgba(1,10,35,.88),inset -8vw 0 8vw -8vw rgba(1,10,35,.88)}.stamp-archive-head{position:absolute;z-index:30;left:4.5vw;right:4.5vw;top:calc(var(--header-h) + 20px);display:grid;grid-template-columns:minmax(260px,.72fr) 1.3fr minmax(160px,.42fr);gap:34px;align-items:end;pointer-events:none}.stamp-archive-title p{margin:0 0 5px;font:500 7px/1 var(--sans);letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.48)}.stamp-archive-title h2{margin:0;font:400 clamp(30px,3.1vw,52px)/.95 var(--serif);letter-spacing:-.028em;color:#fff}.stamp-era-menu{pointer-events:auto;display:flex;justify-content:center;align-items:center;gap:2px;min-width:0;overflow-x:auto;scrollbar-width:none}.stamp-era-menu::-webkit-scrollbar{display:none}.stamp-era-menu button{position:relative;flex:0 0 auto;border:0;background:transparent;color:rgba(255,255,255,.42);padding:10px 9px;font:500 7px/1 var(--sans);letter-spacing:.11em;cursor:pointer;transition:color .25s,transform .25s}.stamp-era-menu button:after{content:"";position:absolute;left:50%;bottom:2px;width:0;height:1px;background:#fff;transform:translateX(-50%);transition:width .25s}.stamp-era-menu button:hover,.stamp-era-menu button.active{color:#fff;transform:translateY(-1px)}.stamp-era-menu button.active:after{width:18px}.stamp-archive-status{justify-self:end;text-align:right;display:grid;gap:5px}.stamp-archive-status>span{font:400 16px/1.05 var(--serif);color:#fff}.stamp-archive-status small{font:500 7px/1 var(--sans);letter-spacing:.14em;color:rgba(255,255,255,.42)}.stamp-archive-status b{font-weight:500;color:#fff}.stamp-coverflow-viewport{position:absolute;z-index:5;left:0;right:0;top:calc(var(--header-h) + 104px);bottom:112px;overflow:hidden;outline:none;perspective:calc(var(--seal-card-w) * 3);perspective-origin:50% 48%;touch-action:pan-y;cursor:grab}.stamp-coverflow-viewport.is-dragging{cursor:grabbing;user-select:none}.stamp-coverflow-track{position:absolute;left:0;top:50%;display:flex;align-items:center;gap:clamp(42px,5.2vw,92px);width:max-content;transform:translate3d(0,-47%,0);transform-style:preserve-3d;will-change:transform;padding-block:32px}.stamp-item{position:relative;flex:0 0 var(--seal-card-w);width:var(--seal-card-w);transform-style:preserve-3d;z-index:1;will-change:transform,opacity;outline:none}.stamp-item:focus-visible .stamp-seal-card{outline:1px solid #fff;outline-offset:7px}.stamp-seal-card{position:relative;width:100%;aspect-ratio:1;display:grid;place-items:center;background:#f7f7f4;border:1px solid rgba(255,255,255,.16);box-shadow:0 24px 70px rgba(0,0,0,.27);overflow:hidden;transform-style:preserve-3d;will-change:transform;transition:box-shadow .32s ease,background .32s ease}.stamp-seal-card:before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,.38),transparent 30%,transparent 68%,rgba(8,40,107,.05));pointer-events:none}.stamp-seal-card:after{content:"";position:absolute;width:72%;height:72%;border:1px solid rgba(8,40,107,.06);border-radius:50%;pointer-events:none}.stamp-seal-card img{position:relative;z-index:2;width:67%;height:67%;object-fit:contain;filter:grayscale(1) contrast(1.08);transition:transform .4s ease,filter .3s ease}.stamp-item:hover{z-index:220!important}.stamp-item:hover .stamp-seal-card{box-shadow:0 38px 95px rgba(0,0,0,.42)}.stamp-item:hover .stamp-seal-card img{transform:scale(1.055);filter:grayscale(.88) contrast(1.1)}.stamp-item-no{position:absolute;z-index:4;left:14px;top:13px;font:500 7px/1 var(--sans);letter-spacing:.16em;color:#7d8798}.stamp-item-copy{padding-top:15px;min-height:158px;will-change:opacity,transform;transition:opacity .15s linear}.stamp-item-row{display:flex;justify-content:space-between;gap:18px;align-items:flex-start;padding-bottom:11px;border-bottom:1px solid rgba(255,255,255,.17)}.stamp-item-period{font:400 17px/1.12 var(--serif);color:#fff;max-width:76%}.stamp-item-index{font:500 7px/1 var(--sans);letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.42);white-space:nowrap;padding-top:4px}.stamp-item-dimensions{margin:10px 0 0;font:500 7px/1.45 var(--sans);letter-spacing:.08em;text-transform:uppercase;color:rgba(255,255,255,.58)}.stamp-item-desc{margin:8px 0 0;font:300 9px/1.65 var(--sans);color:rgba(255,255,255,.64);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.stamp-item:focus .stamp-item-desc,.stamp-item:hover .stamp-item-desc{-webkit-line-clamp:5;color:rgba(255,255,255,.86)}.stamp-timeline-wrap{position:absolute;z-index:32;left:4.5vw;right:4.5vw;bottom:25px}.stamp-timeline-labels{display:grid;grid-template-columns:70px 1fr 70px;align-items:end;margin-bottom:8px;font:500 7px/1 var(--sans);letter-spacing:.12em;color:rgba(255,255,255,.42)}.stamp-timeline-labels strong{text-align:center;font:400 13px/1 var(--serif);letter-spacing:0;color:#fff}.stamp-timeline-labels>span:last-child{text-align:right}.stamp-progress-track{position:relative;width:100%;height:28px;border:0;background:transparent;padding:0;cursor:pointer}.stamp-progress-track:before{content:"";position:absolute;left:0;right:0;top:50%;height:1px;background:rgba(255,255,255,.2)}.stamp-progress-fill{position:absolute;left:0;top:50%;height:1px;width:0;background:#fff}.stamp-progress-thumb{position:absolute;top:50%;left:0;width:9px;height:9px;border:1px solid #fff;background:var(--seal-deep);border-radius:50%;transform:translate(-50%,-50%);transition:box-shadow .2s}.stamp-progress-track:hover .stamp-progress-thumb{box-shadow:0 0 0 5px rgba(255,255,255,.08)}.stamp-timeline-ticks{position:absolute;inset:0;pointer-events:none}.stamp-timeline-tick{position:absolute;top:50%;width:3px;height:3px;border-radius:50%;background:rgba(255,255,255,.45);transform:translate(-50%,-50%)}.stamp-scroll-cue{position:absolute;z-index:34;left:4.5vw;bottom:67px;display:flex;align-items:center;gap:9px;font:500 6px/1 var(--sans);letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.35)}.stamp-scroll-cue>span{color:rgba(255,255,255,.78)}.stamp-scroll-cue i{width:36px;height:1px;background:rgba(255,255,255,.32);position:relative;overflow:hidden}.stamp-scroll-cue i:after{content:"";position:absolute;inset:0;background:#fff;transform:translateX(-100%);animation:sealCue 1.9s ease-in-out infinite}.stamp-scroll-cue em{font-style:normal}@keyframes sealCue{0%,12%{transform:translateX(-100%)}65%,100%{transform:translateX(100%)}}/* Modal */
.stamp-modal{position:fixed;inset:0;z-index:400;opacity:0;visibility:hidden;pointer-events:none;transition:.35s}.stamp-modal.open{opacity:1;visibility:visible;pointer-events:auto}.stamp-modal-backdrop{position:absolute;inset:0;background:rgba(3,14,40,.78);backdrop-filter:blur(12px)}.stamp-modal-card{position:absolute;left:50%;top:50%;transform:translate(-50%,-47%) scale(.985);width:min(86vw,930px);min-height:520px;background:#fff;display:grid;grid-template-columns:47% 53%;box-shadow:0 38px 120px rgba(0,0,0,.38);transition:transform .45s cubic-bezier(.2,.8,.2,1);overflow:hidden}.stamp-modal.open .stamp-modal-card{transform:translate(-50%,-50%) scale(1)}.stamp-modal-left{background:#f1f1ee;position:relative;display:grid;place-items:center;overflow:hidden}.stamp-modal-left:after{content:"";position:absolute;width:74%;aspect-ratio:1;border:1px solid rgba(8,40,107,.08);border-radius:50%}.stamp-modal .big-no{position:absolute;left:22px;top:20px;font:500 8px/1 var(--sans);letter-spacing:.16em;color:#72809a;z-index:2}.stamp-modal-image{width:78%;aspect-ratio:1;display:grid;place-items:center;z-index:2}.stamp-modal-image img{width:78%;height:78%;object-fit:contain;filter:grayscale(1) contrast(1.08)}.stamp-modal-copy{padding:50px 48px;display:flex;flex-direction:column;justify-content:center}.stamp-modal-copy h2{font:400 clamp(46px,4.5vw,68px)/.95 var(--serif);margin:16px 0 8px;color:#071c50}.stamp-modal .period{font:400 20px/1.1 var(--serif);color:#68738b}.stamp-modal .modal-dimensions{font:500 8px/1.45 var(--sans);letter-spacing:.08em;text-transform:uppercase;color:#8991a0;margin-top:11px}.stamp-modal .modal-rule{height:1px;background:#dfe2e8;margin:28px 0}.stamp-modal .desc{font:300 14px/1.8 var(--sans);color:#4f5868}.stamp-modal .source{font:300 9px/1.65 var(--sans);color:#9399a4;margin-top:24px}.stamp-modal .modal-nav{display:flex;justify-content:space-between;margin-top:auto;padding-top:34px}.stamp-modal .modal-nav button{border:0;background:none;padding:0;font:500 8px/1 var(--sans);letter-spacing:.12em;text-transform:uppercase;color:#08286b;cursor:pointer}.stamp-modal .modal-nav button:disabled{opacity:.2;cursor:default}.stamp-close{position:absolute;right:17px;top:13px;border:0;background:transparent;font:300 29px/1 var(--sans);z-index:5;cursor:pointer;color:#08286b}body.stamp-modal-lock{overflow:hidden}

@media(max-width:980px){:root{--seal-card-w:clamp(240px,34vw,320px)}.stamp-hero-premium{grid-template-columns:1fr;min-height:0}.stamp-hero-copy{min-height:65vh}.stamp-hero-stage{height:62vh}.stamp-archive-head{grid-template-columns:1fr auto;gap:12px 18px;top:calc(var(--header-h) + 18px)}.stamp-era-menu{grid-column:1/-1;grid-row:2;justify-content:flex-start}.stamp-archive-status{grid-column:2;grid-row:1}.stamp-coverflow-viewport{top:calc(var(--header-h) + 115px)}
}
