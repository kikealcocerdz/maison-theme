}
@media(max-height:720px) and (min-width:701px){.stamp-coverflow-viewport{top:calc(var(--header-h) + 88px);bottom:88px}.stamp-archive-head{top:calc(var(--header-h) + 11px)}.stamp-item-copy{min-height:125px}.stamp-item-desc{-webkit-line-clamp:2}.stamp-timeline-wrap{bottom:13px}.stamp-scroll-cue{bottom:52px}}/* v82 — Coverflow cronológico basado en el componente de referencia */
.stamp-horizontal-story{
  --seal-card-w:clamp(188px,17.5vw,270px);
  background:var(--seal-deep);
}.stamp-scroll-pin{
  background:
    radial-gradient(circle at 50% 42%,rgba(26,67,131,.22),transparent 38%),
    linear-gradient(180deg,#071b48 0%,#061737 100%)!important;
}.stamp-scroll-pin:before{opacity:.36}.stamp-scroll-pin:after{box-shadow:inset 11vw 0 10vw -9vw rgba(2,11,32,.86),inset -11vw 0 10vw -9vw rgba(2,11,32,.86)!important}.stamp-archive-head{
  top:calc(var(--header-h) + 23px)!important;
  grid-template-columns:minmax(215px,.5fr) minmax(0,1.8fr) minmax(145px,.38fr)!important;
  align-items:center!important;
}.stamp-archive-title h2{font-size:clamp(27px,2.5vw,42px)!important}.stamp-era-menu{
  gap:9px!important;
  padding:2px 4px 4px!important;
  justify-content:center!important;
}.stamp-era-menu button{
  min-width:58px!important;
  height:34px!important;
  padding:0 13px!important;
  border:1px solid rgba(255,255,255,.18)!important;
  border-radius:999px!important;
  background:rgba(255,255,255,.035)!important;
  color:rgba(255,255,255,.67)!important;
