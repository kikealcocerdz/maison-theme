    { "type": "textarea", "id": "intro", "label": "Entradilla", "default": "Encuentra la marca que aparece bajo tu pieza y descubre cuándo se utilizó y qué nos cuenta sobre su origen." },
    { "type": "text", "id": "year_from", "label": "Año inicial (decorativo)", "default": "1841" },
    { "type": "text", "id": "year_to", "label": "Año final (decorativo)", "default": "HOY" },
    { "type": "header", "content": "Archivo" },
    { "type": "text", "id": "archive_kicker", "label": "Antetítulo", "default": "Archivo cronológico" },
    { "type": "text", "id": "archive_heading", "label": "Titular del archivo", "default": "Los sellos, en el tiempo" }
  ],
  "presets": [{ "name": "Archivo de sellos" }]
}
{% endschema %}
