/* El track se ancla al 29% y el pie al 64% del visor, pero la tarjeta medía en
   px: por debajo de ~1065px de alto de ventana el sello invadía el texto. Se
   acota la tarjeta a la banda libre entre ambos anclajes. Los restos (189px,
   195px, 140px) son el top+bottom del visor en cada breakpoint. */
.stamp-horizontal-story {
  --seal-card-w: max(120px, min(clamp(188px, 17.5vw, 270px), calc((100svh - var(--header-h) - 189px) * 0.33)));
