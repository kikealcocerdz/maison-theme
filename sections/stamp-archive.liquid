{% javascript %}
(function () {
  // El archivo pesa ~57 KB entre datos y lógica, así que se carga solo aquí.
  function load() {
    var root = document.querySelector('[data-stamp-archive]');
    if (!root || root.dataset.archiveLoaded) return;
    root.dataset.archiveLoaded = '1';
    var s = document.createElement('script');
    s.src = root.dataset.archiveSrc;
    s.defer = true;
    document.head.appendChild(s);
  }
  load();
  document.addEventListener('shopify:section:load', load);
})();
{% endjavascript %}

