{%- comment -%}
  Página «Mis favoritos». Los favoritos viven en localStorage (`cartuja:favs`, ver
  assets/theme.js): una lista de URLs de producto. Cada tarjeta se pide ya pintada a
  sections/fav-card por Section Rendering API, así es la misma que en las colecciones.
  ponytail: sólo en este navegador; entre dispositivos haría falta cuenta + app.
{%- endcomment -%}
<section class="favorites" data-favorites>
  <header class="favorites__head">
    {%- if section.settings.kicker != blank -%}<p class="eyebrow">{{ section.settings.kicker | escape }}</p>{%- endif -%}
    <h1 class="favorites__title">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.intro != blank -%}<div class="favorites__intro">{{ section.settings.intro }}</div>{%- endif -%}
  </header>

  <div class="favorites__grid" data-favorites-grid aria-live="polite"></div>

  <div class="favorites__empty" data-favorites-empty hidden>
    <p>{{ section.settings.empty_text | escape }}</p>
    {%- if section.settings.cta_label != blank -%}
      <a class="ghost-btn" href="{{ section.settings.cta_link | default: routes.collections_url }}">{{ section.settings.cta_label | escape }}&nbsp;→</a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.favorites { width: var(--content); margin: 0 auto; padding: calc(var(--header-h) + 56px) 0 110px; }
.favorites__head { max-width: 640px; margin-bottom: 48px; }
.favorites__title { margin: 10px 0 0; font-family: var(--serif); font-weight: 400; font-size: clamp(38px, 4vw, 58px); line-height: 1.02; }
.favorites__intro { margin-top: 16px; color: var(--muted); font-size: 14px; line-height: 1.7; }
.favorites__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 52px 22px; }
.favorites__grid:empty { display: none; }
.favorites__empty { display: grid; justify-items: start; gap: 22px; color: var(--muted); font-size: 14px; }
.favorites__empty[hidden] { display: none; }
@media (max-width: 1000px) { .favorites__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
@media (max-width: 760px) {
  .favorites { width: calc(100% - 28px); padding-top: calc(var(--header-h) + 30px); }
  .favorites__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 34px 12px; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  var KEY = 'cartuja:favs';
  function read() { try { var l = JSON.parse(localStorage.getItem(KEY) || '[]'); return Array.isArray(l) ? l : []; } catch (e) { return []; } }
  function write(l) { try { localStorage.setItem(KEY, JSON.stringify(l)); } catch (e) {} }

  function init(root) {
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';
    var grid = root.querySelector('[data-favorites-grid]');
    var empty = root.querySelector('[data-favorites-empty]');
    function toggleEmpty() { empty.hidden = grid.children.length > 0; }

    var favs = read().filter(function (u) { return /^\/products\//.test(u); });
    if (!favs.length) { toggleEmpty(); return; }

    Promise.all(favs.map(function (url) {
      return fetch(url.split('?')[0] + '?section_id=fav-card')
        .then(function (r) { return r.ok ? r.text() : ''; })
        .catch(function () { return ''; });
    })).then(function (htmls) {
      var alive = [];
      htmls.forEach(function (html, i) {
        var tmp = document.createElement('div');
        tmp.innerHTML = html;
        var card = tmp.querySelector('.product');
        if (!card) return; // producto borrado o sin publicar: se cae de la lista
        card.classList.add('is-visible');
        grid.appendChild(card);
        alive.push(favs[i]);
      });
      if (alive.length !== favs.length) write(alive);
      toggleEmpty();
      grid.querySelectorAll('.fav').forEach(function (b) { b.classList.add('active'); b.setAttribute('aria-pressed', 'true'); });
    });

    // Quitar el corazón aquí saca la pieza de la página (theme.js ya la quitó de la lista).
    grid.addEventListener('click', function (e) {
      var btn = e.target.closest('.fav');
      if (!btn) return;
      setTimeout(function () {
        if (read().indexOf(btn.dataset.favKey) === -1) { btn.closest('.product').remove(); toggleEmpty(); }
      }, 0);
    });
  }

  document.querySelectorAll('[data-favorites]').forEach(init);
  document.addEventListener('shopify:section:load', function (e) { init(e.target.querySelector('[data-favorites]')); });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Favoritos",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "Tu selección" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Tus favoritos" },
    { "type": "richtext", "id": "intro", "label": "Introducción", "default": "<p>Las piezas que has marcado con el corazón. Se guardan en este navegador.</p>" },
    { "type": "text", "id": "empty_text", "label": "Texto sin favoritos", "default": "Todavía no has guardado ninguna pieza. Pulsa el corazón en cualquier producto para tenerlo aquí." },
    { "type": "text", "id": "cta_label", "label": "Botón sin favoritos", "default": "Ver las colecciones" },
    { "type": "url", "id": "cta_link", "label": "Enlace del botón" }
  ],
  "presets": [{ "name": "Favoritos" }]
}
{% endschema %}
