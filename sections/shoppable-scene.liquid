{%- liquid
  assign products = section.blocks | where: 'type', 'product'
-%}
<section class="table-scene scene-redesign hairline" id="tables-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="scene-layout">
    {%- if section.settings.heading != blank or section.settings.eyebrow != blank or section.settings.description != blank -%}
      <div class="scene-copy reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow | escape }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.description != blank -%}<p>{{ section.settings.description }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="scene-interactive reveal">
      <div class="scene-left-image">
        {%- if section.settings.image != blank -%}
          {% render 'image-responsive', image: section.settings.image, alt: section.settings.image.alt, sizes: '(max-width: 1000px) 100vw, 55vw' %}
        {%- else -%}
          {%- comment -%} Demo fallback (shipped in /assets) until a scene image is set. {%- endcomment -%}
          <img src="{{ 'mesa_ochavada_negro_vistas.webp' | asset_url }}" alt="{{ section.settings.heading | escape }}" width="1800" height="1343" loading="lazy" decoding="async">
        {%- endif -%}
        {%- for block in products -%}
          {%- liquid
            assign p = all_products[block.settings.product]
            assign p_name = block.settings.demo_title
            if p != blank
              assign p_name = p.title
            endif
          -%}
          <button class="scene-hotspot{% if forloop.first %} active{% endif %}" style="left: {{ block.settings.hotspot_x }}%; top: {{ block.settings.hotspot_y }}%;" data-scene-hotspot="{{ forloop.index0 }}" aria-label="Ver {{ p_name | escape }}" {{ block.shopify_attributes }}></button>
        {%- endfor -%}
      </div>

      <aside class="scene-product-view" aria-live="polite">
        <button class="scene-nav prev" data-scene-prev type="button" aria-label="{{ 'general.accessibility.previous' | t }}">&lsaquo;</button>
        <div class="scene-product-inner" data-scene-product></div>
        <button class="scene-nav next" data-scene-next type="button" aria-label="{{ 'general.accessibility.next' | t }}">&rsaquo;</button>
        <div class="scene-dots" data-scene-dots></div>
      </aside>
    </div>

    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <div class="center reveal scene-cta-row">
        <a href="{{ section.settings.cta_link }}" class="ghost-btn">{{ section.settings.cta_label | escape }}</a>
        {%- if section.settings.cta2_label != blank and section.settings.cta2_link != blank -%}
          <a href="{{ section.settings.cta2_link }}" class="ghost-btn">{{ section.settings.cta2_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Product data consumed by JS to render the right-side panel. {%- endcomment -%}
    {%- liquid
      assign set1 = all_products[section.settings.set1_product]
      assign set2 = all_products[section.settings.set2_product]
    -%}
    <script type="application/json" data-scene-data>
      {
        "cartUrl": {{ routes.cart_add_url | json }},
        "addLabel": {{ section.settings.add_label | default: '' | json }},
        "sets": [
          {%- if section.settings.set1_label != blank -%}
            { "label": {{ section.settings.set1_label | json }}, "variant": {{ set1.selected_or_first_available_variant.id | json }} }{%- if section.settings.set2_label != blank -%},{%- endif -%}
          {%- endif -%}
          {%- if section.settings.set2_label != blank -%}
            { "label": {{ section.settings.set2_label | json }}, "variant": {{ set2.selected_or_first_available_variant.id | json }} }
          {%- endif -%}
        ],
        "items": [
        {%- for block in products -%}
          {%- liquid
            assign p = all_products[block.settings.product]
            assign p_name = block.settings.demo_title
            assign p_meta = block.settings.meta_line
            assign p_price = block.settings.demo_price
            assign p_url = block.settings.link
            assign p_img = ''
            assign p_variant = nil
            if block.settings.demo_image != blank
              assign p_img = block.settings.demo_image | asset_url
            endif
            if p != blank
              assign p_name = p.title
              assign p_url = p.url
              assign p_price = p.price | money
              assign p_variant = p.selected_or_first_available_variant.id
              if p.featured_image != blank
                assign p_img = p.featured_image | image_url: width: 840
              endif
            endif
          -%}
          {
            "name": {{ p_name | default: '' | json }},
            "meta": {{ p_meta | default: '' | json }},
            "price": {{ p_price | default: '' | json }},
            "img": {{ p_img | default: '' | json }},
            "url": {{ p_url | default: '#' | json }},
            "variant": {{ p_variant | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
        ]
      }
    </script>
  </div>
</section>

{% stylesheet %}
.table-scene.scene-redesign { padding: 132px 0 180px; background: var(--paper); }
.scene-redesign .scene-layout { width: var(--content); margin: 0 auto; display: block; }
.scene-redesign .scene-copy { text-align: center; margin: 0 auto 46px; max-width: 740px; }
.scene-redesign .scene-copy h2 {
  font-family: var(--serif); font-size: var(--fs-h2); line-height: 1.12;
  font-weight: 400; margin: 0 0 16px;
}
.scene-redesign .scene-copy p {
  font-size: 12px; line-height: 1.85; color: var(--ink-soft); max-width: 580px; margin: 0 auto;
}
.scene-interactive {
  display: grid; grid-template-columns: 1.08fr 0.92fr;
  gap: min(5vw, 72px); align-items: stretch;
}
.scene-left-image {
  position: relative; min-height: 620px;
  background: var(--ink-faint-20); overflow: hidden;
}
.scene-left-image img { width: 100%; height: 100%; object-fit: cover; transition: transform 1100ms var(--ease-long); }
.scene-left-image:hover img { transform: scale(1.025); }
.scene-hotspot {
  position: absolute; width: 18px; height: 18px;
  border: 0.5px solid var(--ink); background: var(--paper);
  border-radius: 999px; box-shadow: 0 0 0 9px rgba(255, 255, 255, 0.48);
  transition: transform 260ms var(--ease), background 260ms var(--ease), color 260ms var(--ease);
}
.scene-hotspot:hover, .scene-hotspot.active { transform: scale(1.24); background: var(--ink); color: var(--paper); }
.scene-hotspot::after { content: ""; position: absolute; inset: 6px; border-radius: 999px; background: currentColor; }
.scene-product-view {
  position: relative; min-height: 620px; background: var(--paper);
  display: flex; align-items: center; justify-content: center;
  border-top: 0.5px solid var(--rule); border-bottom: 0.5px solid var(--rule);
  /* Grid item. Its column is minmax(auto, .92fr), and the slide track below is a
     non-wrapping flex row, so its min-content is the SUM of all 5 slides (~1400px).
     Without this the column claims that as its minimum and squeezes the sibling
     .scene-left-image — which has overflow:hidden, so it collapses to zero — off screen. */
  min-width: 0;
}

/* Native scroll-snap track: the finger drags the slide itself, with momentum,
   trackpad and keyboard for free. Arrows/dots/hotspots just scrollTo() into it. */
.scene-product-inner {
  width: 100%; min-width: 0; display: flex; overflow-x: auto;
  scroll-snap-type: x mandatory; scroll-behavior: smooth;
  overscroll-behavior-x: contain; scrollbar-width: none;
}
.scene-product-inner::-webkit-scrollbar { display: none; }
/* -webkit- prefix still needed for Safari < 17, which is plenty of Mac traffic. */
.scene-product-inner.is-dragging { cursor: grabbing; -webkit-user-select: none; user-select: none; }
/* min-width:0 keeps a slide exactly one track wide; let it grow to its min-content
   on a narrow phone and the scrollTo(i * clientWidth) maths drifts out of step. */
.scene-slide {
  flex: 0 0 100%; min-width: 0; scroll-snap-align: start;
  text-align: center; padding: 46px 72px;
}
.scene-product-inner img {
  height: min(48vh, 420px); width: 100%; object-fit: contain; margin: 0 auto 34px;
  transition: transform 700ms var(--ease-long), opacity 360ms var(--ease);
}
.scene-product-inner h3 {
  font-family: var(--serif); font-weight: 400; font-size: 26px; line-height: 1.12;
  margin: 0 0 7px; color: var(--ink);
}
.scene-product-inner p {
  font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--muted); margin: 0 0 10px;
}
.scene-product-inner .scene-price { font-size: 13px; color: var(--ink); }
.scene-nav {
  position: absolute; top: 50%; transform: translateY(-50%);
  width: 42px; height: 42px; display: grid; place-items: center;
  color: var(--ink); font-size: 28px; line-height: 1; opacity: 0.82;
  transition: opacity 220ms var(--ease), transform 220ms var(--ease);
  background: transparent; border: 0; cursor: pointer;
}
.scene-nav:hover { opacity: 1; transform: translateY(-50%) scale(1.06); }
.scene-nav.prev { left: 18px; }
.scene-nav.next { right: 18px; }
.scene-dots {
  position: absolute; left: 0; right: 0; bottom: 28px;
  display: flex; justify-content: center; gap: 8px;
}
.scene-dots span { width: 26px; height: 1px; background: rgba(15, 26, 46, 0.22); transition: background 220ms var(--ease), width 220ms var(--ease); }
.scene-dots span.active { background: var(--ink); width: 36px; }

.scene-redesign .center { text-align: center; margin-top: 72px; }
.scene-cta-row { display: flex; justify-content: center; gap: 18px; flex-wrap: wrap; }
.scene-cta-row .ghost-btn { min-width: 220px; }

.scene-image-open { display: block; width: 100%; background: transparent; border: 0; padding: 0; margin: 0 auto 34px; cursor: zoom-in; }
.scene-image-open img { height: min(48vh, 420px) !important; margin: 0 auto !important; }
.scene-actions { display: grid; gap: 10px; margin: 26px auto 0; width: min(100%, 360px); }
.scene-actions form { display: contents; }
.ghost-btn.small-cart { height: 42px; padding: 0 18px; font-size: 10px; letter-spacing: 0.18em; width: 100%; }
.ghost-btn.small-cart.alt { background: transparent; color: var(--ink); }

.quick-image-lightbox {
  position: fixed; inset: 0; z-index: 9999; background: rgba(15, 26, 46, 0.82);
  display: grid; place-items: center; opacity: 0; transition: opacity 260ms var(--ease);
}
.quick-image-lightbox.is-open { opacity: 1; }
.quick-image-lightbox img { max-width: 82vw; max-height: 82vh; object-fit: contain; background: var(--paper); padding: min(4vw, 42px); }
.quick-image-lightbox button { position: absolute; right: 34px; top: 24px; color: var(--paper); font-family: var(--serif); font-size: 42px; line-height: 1; background: transparent; border: 0; cursor: pointer; }

@media (max-width: 1000px) {
  .scene-interactive { grid-template-columns: 1fr; }
  .scene-left-image, .scene-product-view { min-height: 520px; }
  .scene-product-inner img { height: 320px; }
}
@media (max-width: 680px) {
  .scene-left-image, .scene-product-view { min-height: 420px; }
  .scene-slide { padding: 38px 48px; }
  .scene-product-inner img { height: 260px; }
  .scene-nav.prev { left: 6px; }
  .scene-nav.next { right: 6px; }
  .scene-actions { width: 100%; }
  .scene-cta-row { display: grid; gap: 12px; }
  .scene-cta-row .ghost-btn { min-width: 0; width: 100%; }
}
@media (prefers-reduced-motion: reduce) {
  .scene-left-image img, .scene-hotspot, .scene-product-inner img { transition: none; }
  .scene-product-inner { scroll-behavior: auto; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  document.querySelectorAll('.scene-redesign:not([data-init])').forEach(initScene);

  function initScene(root) {
    root.dataset.init = '1';
    const dataEl = root.querySelector('[data-scene-data]');
    const panel = root.querySelector('[data-scene-product]');
    const dots = root.querySelector('[data-scene-dots]');
    const hotspots = [...root.querySelectorAll('[data-scene-hotspot]')];
    if (!dataEl || !panel || !dots) return;

    let data = {};
    try { data = JSON.parse(dataEl.textContent.trim()); } catch (e) { data = {}; }
    const items = data.items || [];
    const sets = data.sets || [];
    const cartUrl = data.cartUrl || '/cart/add';
    if (!items.length) return;

    let current = 0;

    // Real variant -> /cart/add form (intercepted globally by the cart drawer); demo -> inert button.
    function actionBtn(label, variant, alt) {
      if (!label) return '';
      const cls = 'ghost-btn small-cart' + (alt ? ' alt' : '');
      if (variant) {
        return `<form method="post" action="${cartUrl}"><input type="hidden" name="id" value="${variant}"><button class="${cls}" type="submit">${label}</button></form>`;
      }
      return `<button class="${cls}" type="button">${label}</button>`;
    }

    function slideHtml(p) {
      const imgHtml = p.img
        ? `<a class="scene-image-open" href="${p.url || '#'}"><img src="${p.img}" alt="${p.name || ''}" loading="lazy" decoding="async"></a>`
        : '';
      return `<article class="scene-slide">` +
        imgHtml +
        (p.meta ? `<p>${p.meta}</p>` : '') +
        `<h3>${p.name || ''}</h3>` +
        (p.price ? `<span class="scene-price">${p.price}</span>` : '') +
        `<div class="scene-actions">` +
        actionBtn(data.addLabel, p.variant, false) +
        sets.map(s => actionBtn(s.label, s.variant, true)).join('') +
        `</div>` +
      `</article>`;
    }

    const N = items.length;
    const loop = N > 1;

    // Three identical copies of the strip. A drag can run off either end and be
    // silently recentred onto the middle one — the content there is the same, so
    // the jump is invisible and the loop never hits a wall.
    panel.innerHTML = Array.from({ length: loop ? 3 : 1 }, () => items.map(slideHtml).join('')).join('');
    dots.innerHTML = items.map((_, i) => `<span class="${i === 0 ? 'active' : ''}"></span>`).join('');
    hotspots.forEach((h, i) => h.classList.toggle('active', i === 0));

    let down = false, startX = 0, startLeft = 0, moved = false;
    let vx = 0, lastX = 0, lastT = 0, ticking = false, idle = 0, resizeT = 0;

    const width = () => panel.clientWidth || 1;
    const rawIndex = () => Math.round(panel.scrollLeft / width());
    const realIndex = (raw) => ((raw % N) + N) % N;

    // Reposition with no animation and no snap interference.
    function jumpTo(px) {
      const snap = panel.style.scrollSnapType;
      panel.style.scrollSnapType = 'none';
      panel.style.scrollBehavior = 'auto';
      panel.scrollLeft = px;
      panel.style.scrollSnapType = snap;
      panel.style.scrollBehavior = '';
    }

    function glideTo(raw) {
      panel.style.scrollBehavior = '';   // back to the CSS smooth glide
      panel.scrollTo({ left: raw * width() });
    }

    function sync() {
      const i = realIndex(rawIndex());
      if (i === current) return;
      current = i;
      [...dots.children].forEach((d, n) => d.classList.toggle('active', n === current));
      hotspots.forEach((h, n) => h.classList.toggle('active', n === current));
    }

    // Once movement stops: let snap take over again, then slide the scroll
    // position back into the middle copy if it wandered into an outer one.
    function onIdle() {
      if (down) return;
      panel.style.scrollSnapType = '';
      panel.style.scrollBehavior = '';
      if (!loop) return;
      const raw = rawIndex();
      if (raw < N || raw >= 2 * N) jumpTo((N + realIndex(raw)) * width());
    }

    panel.addEventListener('scroll', () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(() => { ticking = false; sync(); });
      }
      clearTimeout(idle);
      idle = setTimeout(onIdle, 140);
    }, { passive: true });

    // Arrows step from wherever we are, so crossing the seam costs one slide.
    const step = (d) => glideTo(rawIndex() + d);

    // Dots and hotspots target whichever copy of that slide is nearest.
    function goToIndex(j) {
      if (!loop) return glideTo(j);
      const raw = rawIndex();
      const base = Math.floor(raw / N) * N;
      glideTo([base - N + j, base + j, base + N + j]
        .reduce((a, b) => (Math.abs(b - raw) < Math.abs(a - raw) ? b : a)));
    }

    hotspots.forEach(h => h.addEventListener('click', () => goToIndex(Number(h.dataset.sceneHotspot))));
    root.querySelector('[data-scene-prev]')?.addEventListener('click', () => step(-1));
    root.querySelector('[data-scene-next]')?.addEventListener('click', () => step(1));

    dots.addEventListener('click', e => {
      const span = e.target.closest('span');
      if (!span) return;
      goToIndex([...dots.children].indexOf(span));
    });

    // Start on the middle copy so there is runway in both directions.
    requestAnimationFrame(() => { if (loop) jumpTo(N * width()); });
    window.addEventListener('resize', () => {
      clearTimeout(resizeT);
      resizeT = setTimeout(() => jumpTo(((loop ? N : 0) + current) * width()), 150);
    });

    // Native scrolling covers touch, trackpad, shift+wheel and keyboard. Mouse
    // click-drag is the one gesture no scroll container gives you, so add just
    // that and let the scroller keep owning the position.
    panel.addEventListener('pointerdown', e => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      down = true; moved = false;
      startX = lastX = e.clientX; startLeft = panel.scrollLeft;
      lastT = e.timeStamp; vx = 0;
      // user-select:none alone doesn't stop a selection the browser has already
      // begun on mousedown; preventDefault does. Form controls keep their default
      // so focus and clicks still behave.
      if (!e.target.closest('button, input, select, textarea')) e.preventDefault();
      // Snap fights a drag in progress, and smooth would animate every step.
      clearTimeout(idle);
      panel.style.scrollSnapType = 'none';
      panel.style.scrollBehavior = 'auto';
      panel.classList.add('is-dragging');
    });
    panel.addEventListener('pointermove', e => {
      if (!down) return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 3) moved = true;
      const dt = e.timeStamp - lastT;
      if (dt > 0) vx = (e.clientX - lastX) / dt;  // px/ms, positive = dragging right
      lastX = e.clientX; lastT = e.timeStamp;
      panel.scrollLeft = startLeft - dx;
    });
    function endDrag() {
      if (!down) return;
      down = false;
      panel.classList.remove('is-dragging');

      // Re-enabling snap here would jump, not glide, so pick the slide ourselves.
      // A fast flick carries to the next one even if it barely travelled;
      // otherwise the nearest wins, which is the usual past-halfway rule.
      const at = panel.scrollLeft / width();
      let target = Math.abs(vx) > 0.4 ? (vx < 0 ? Math.ceil(at) : Math.floor(at)) : Math.round(at);
      if (!loop) target = Math.max(0, Math.min(N - 1, target));
      glideTo(target);
      // A release with no movement fires no scroll event, so arm onIdle by hand
      // or snap would stay switched off.
      clearTimeout(idle);
      idle = setTimeout(onIdle, 160);
    }
    panel.addEventListener('pointerup', endDrag);
    panel.addEventListener('pointercancel', endDrag);
    panel.addEventListener('pointerleave', endDrag);
    // Dragging an <img> or <a> starts a native HTML5 drag and eats the gesture.
    panel.addEventListener('dragstart', e => e.preventDefault());
    // Swallow the click that ends a drag so it doesn't open the product link.
    panel.addEventListener('click', e => {
      if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; }
    }, true);
  }

  document.addEventListener('shopify:section:load', (e) => {
    e.target.querySelectorAll('.scene-redesign:not([data-init])').forEach(initScene);
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "Shoppable scene",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "product",
      "name": "Hotspot product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "meta_line", "label": "Collection label (e.g. 'Aurora Collection')" },
        { "type": "url", "id": "link", "label": "Link (used for demo / image open)" },
        { "type": "range", "id": "hotspot_x", "label": "Hotspot X position (%)", "min": 2, "max": 98, "step": 1, "default": 50 },
        { "type": "range", "id": "hotspot_y", "label": "Hotspot Y position (%)", "min": 2, "max": 98, "step": 1, "default": 50 },
        { "type": "header", "content": "Demo (when no product selected)" },
        { "type": "text", "id": "demo_image", "label": "Demo image (asset filename)", "info": "e.g. aurora_202_plato.png" },
        { "type": "text", "id": "demo_title", "label": "Demo title" },
        { "type": "text", "id": "demo_price", "label": "Demo price", "default": "Consultar" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Nuestras mesas" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Una escena, cada pieza." },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "image_picker", "id": "image", "label": "Scene image (left side)" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Descubre nuestras mesas" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "text", "id": "cta2_label", "label": "Second CTA label", "default": "Aprende a vestir tu mesa" },
    { "type": "url", "id": "cta2_link", "label": "Second CTA link" },
    { "type": "header", "content": "Product panel actions" },
    { "type": "text", "id": "add_label", "label": "Add-to-cart label (shown piece)", "default": "Añadir pieza" },
    { "type": "product", "id": "set1_product", "label": "Set 1 product (e.g. full vajilla)" },
    { "type": "text", "id": "set1_label", "label": "Set 1 button label", "default": "Añadir vajilla · 42 platos" },
    { "type": "product", "id": "set2_product", "label": "Set 2 product" },
    { "type": "text", "id": "set2_label", "label": "Set 2 button label", "default": "Añadir vajilla · 56 platos" }
  ],
  "presets": [
    {
      "name": "Shoppable scene",
      "blocks": [
        { "type": "product", "settings": { "hotspot_x": 32, "hotspot_y": 42 } },
        { "type": "product", "settings": { "hotspot_x": 57, "hotspot_y": 51 } },
        { "type": "product", "settings": { "hotspot_x": 71, "hotspot_y": 34 } },
        { "type": "product", "settings": { "hotspot_x": 43, "hotspot_y": 67 } },
        { "type": "product", "settings": { "hotspot_x": 79, "hotspot_y": 61 } }
      ]
    }
  ]
}
{% endschema %}
