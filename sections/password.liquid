{%- comment -%}
  Página de contraseña mientras la tienda está cerrada: foto de mesa + panel con el
  logo, mensaje y formulario. Escritorio a dos columnas; móvil, foto en banda arriba.
  Se pinta con layout/password.liquid (sin cabecera ni pie del tema).
{%- endcomment -%}

<main class="password-page">
  <div class="password-page__media">
    <img
      src="{{ 'mesa_bodegon_lujo_el_renacer.webp' | asset_url }}"
      alt=""
      width="2048"
      height="1529"
      fetchpriority="high"
    >
  </div>

  <div class="password-page__panel">
    <div class="password-page__inner">
      <img
        class="password-page__logo"
        src="{{ 'logo-navy.png' | asset_url }}"
        alt="{{ shop.name | escape }}"
        width="220"
        height="344"
      >

      <p class="password-page__kicker">{{ 'password.kicker' | t }}</p>
      <h1 class="password-page__title">{{ 'password.title' | t }}</h1>

      {%- if shop.password_message != blank -%}
        <p class="password-page__text">{{ shop.password_message }}</p>
      {%- else -%}
        <p class="password-page__text">{{ 'password.intro' | t }}</p>
      {%- endif -%}

      {% form 'storefront_password', class: 'password-page__form' %}
        {%- if form.errors -%}
          <div class="password-page__error" role="alert">{{ 'password.error' | t }}</div>
        {%- endif -%}

        <label class="password-page__label" for="password-input">{{ 'password.password' | t }}</label>
        <div class="password-page__row">
          <input
            class="password-page__input"
            type="password"
            name="password"
            id="password-input"
            autocomplete="current-password"
            required
            {% if form.errors %}aria-invalid="true"{% endif %}
          >
          <button class="password-page__button" type="submit">{{ 'password.enter' | t }}</button>
        </div>
      {% endform %}

      <p class="password-page__foot">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
        <span aria-hidden="true">·</span>
        <a href="/admin">{{ 'password.owner' | t }}</a>
      </p>
    </div>
  </div>
</main>

{% stylesheet %}

  .password-page {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    min-height: 100vh;
    min-height: 100svh;
  }

  .password-page__media { position: relative; overflow: hidden; background: var(--product-bg); }
  .password-page__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .password-page__panel {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 64px 56px;
  }
  .password-page__inner { width: 100%; max-width: 420px; text-align: center; }

  .password-page__logo { width: 64px; height: auto; margin: 0 auto 40px; display: block; }

  .password-page__kicker {
    margin: 0 0 18px;
    font: 500 11px/1.4 var(--sans);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .password-page__title {
    margin: 0 0 20px;
    font: 400 clamp(2rem, 3.4vw, 2.875rem)/1.1 var(--serif);
    letter-spacing: -0.005em;
    color: var(--brand);
  }

  .password-page__text {
    margin: 0 auto 40px;
    max-width: 34ch;
    font: 300 15px/1.7 var(--sans);
    color: var(--ink-soft);
  }

  .password-page__form { text-align: left; }

  .password-page__label {
    display: block;
    margin-bottom: 10px;
    font: 500 11px/1 var(--sans);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .password-page__row { display: flex; gap: 12px; align-items: stretch; }

  .password-page__input {
    flex: 1;
    min-width: 0;
    height: 48px;
    padding: 0 2px;
    border: 0;
    border-bottom: 1px solid var(--rule);
    border-radius: 0;
    background: transparent;
    font: 400 16px/1 var(--sans);
    color: var(--ink);
    transition: border-color 240ms var(--ease);
  }
  .password-page__input:focus { outline: none; border-bottom-color: var(--brand); }
  .password-page__input:focus-visible { box-shadow: 0 1px 0 0 var(--brand); }
  .password-page__input[aria-invalid='true'] { border-bottom-color: var(--accent-1); }

  .password-page__button {
    height: 48px;
    padding: 0 30px;
    border: 1px solid var(--brand);
    border-radius: 0;
    background: var(--brand);
    color: var(--paper);
    font: 500 12px/1 var(--sans);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 240ms var(--ease), color 240ms var(--ease);
  }
  .password-page__button:hover { background: transparent; color: var(--brand); }
  .password-page__button:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; }

  .password-page__error {
    margin-bottom: 18px;
    padding: 12px 14px;
    border-left: 2px solid var(--accent-1);
    background: var(--ink-faint-08);
    font: 400 13px/1.5 var(--sans);
    color: var(--accent-1);
  }

  .password-page__foot {
    margin: 56px 0 0;
    font: 400 11px/1.6 var(--sans);
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .password-page__foot a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .password-page__foot a:hover { color: var(--brand); }

  @media (max-width: 819px) {
    .password-page { grid-template-columns: 1fr; grid-template-rows: 38svh auto; }
    .password-page__panel { padding: 40px 16px 32px; align-items: flex-start; }
    .password-page__logo { width: 52px; margin-bottom: 28px; }
    .password-page__text { margin-bottom: 32px; }
    .password-page__row { flex-direction: column; }
    .password-page__button { width: 100%; }
    .password-page__foot { margin-top: 40px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .password-page__input, .password-page__button { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
