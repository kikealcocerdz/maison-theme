{%- liquid
  assign menu = linklists[section.settings.menu]
  assign menu_right = linklists[section.settings.menu_right]
  assign logo_dark = section.settings.logo_override | default: settings.logo
  assign logo_width = section.settings.logo_width_override | default: settings.logo_width
  assign logo_alt = settings.logo_alt | default: shop.name
-%}

<header class="site-header" id="siteHeader" data-section-id="{{ section.id }}">
  <nav class="nav" aria-label="{{ 'sections.header.menu' | t }}">
    <div class="nav-left">
      <button class="menu-trigger" id="menuToggle" aria-label="{{ 'general.accessibility.open_menu' | t }}" aria-expanded="false" aria-controls="megaMenu">
        {% render 'icon-hamburger' %}
        <span>{{ 'sections.header.menu' | t }}</span>
      </button>
      {%- if menu.links.size > 0 -%}
        {%- comment -%}
          Con menú propio a la derecha, el de la izquierda se pinta entero; si no,
          se sigue partiendo por `nav_left_limit` como hasta ahora.
        {%- endcomment -%}
        {%- if menu_right.links.size > 0 -%}
          {%- for link in menu.links -%}{% render 'nav-item', link: link, side: 'left' %}{%- endfor -%}
        {%- else -%}
          {%- for link in menu.links limit: section.settings.nav_left_limit -%}{% render 'nav-item', link: link, side: 'left' %}{%- endfor -%}
        {%- endif -%}
      {%- else -%}
        {%- comment -%} Demo nav (shown until a navigation menu is selected). {%- endcomment -%}
        <a href="{{ routes.collections_url }}">Colecciones</a>
        <a href="/pages/nuestras-mesas">Nuestras mesas</a>
        <a href="/pages/artesania">Artesanía</a>
      {%- endif -%}
    </div>

    <a href="{{ routes.root_url }}" class="site-header__logo-link" aria-label="{{ logo_alt | escape }}">
      {%- if logo_dark != blank -%}
        <img class="logo" src="{{ logo_dark | image_url: width: 200 }}" alt="{{ logo_alt | escape }}" width="{{ logo_width }}" height="auto" loading="eager" fetchpriority="high">
      {%- else -%}
        {%- comment -%} Demo logo (shown until a logo is uploaded in theme settings). {%- endcomment -%}
        <img class="logo" src="{{ 'logo-navy.png' | asset_url }}" alt="{{ logo_alt | escape }}" width="119" height="124" loading="eager" fetchpriority="high">
      {%- endif -%}
    </a>

    <div class="nav-right">
      {%- comment -%}
        Mientras no exista el menú de la derecha, y el de la izquierda no sobre
        entradas para este lado, se pintan los enlaces del brief a mano.
      {%- endcomment -%}
      {%- assign right_from_left = menu.links.size | minus: section.settings.nav_left_limit -%}
      {%- if menu_right.links.size > 0 -%}
        {%- for link in menu_right.links -%}{% render 'nav-item', link: link, side: 'right' %}{%- endfor -%}
      {%- elsif right_from_left > 0 -%}
        {%- for link in menu.links offset: section.settings.nav_left_limit -%}{% render 'nav-item', link: link, side: 'right' %}{%- endfor -%}
      {%- else -%}
        <a href="{{ routes.collections_url }}/novedades">Nuevo</a>
        <a href="/pages/viste-tu-mesa">Viste tu mesa</a>
        <a href="/pages/nuestras-mesas">Ambientes</a>
        <a href="/pages/heritage-1841">Legado</a>
      {%- endif -%}
      <button type="button" class="search-link" id="searchToggle" aria-label="{{ 'general.search.label' | t }}" aria-expanded="false" aria-controls="searchPanel">{% render 'icon-search' %}</button>
      <a href="{{ routes.account_url }}" class="account-link" aria-label="{{ 'general.account.label' | t }}">{% render 'icon-account' %}</a>
      <a href="{{ routes.cart_url }}" class="header-cart" data-cart-toggle aria-label="{{ 'general.cart.label' | t }}">
        {{ 'general.cart.label' | t | default: 'Cesta' }} (<span data-cart-count-badge>{{ cart.item_count }}</span>)
      </a>
    </div>
  </nav>

  <div class="search-panel" id="searchPanel" data-predictive-url="{{ routes.predictive_search_url }}">
    <div class="search-panel__inner">
      <form class="search-panel__form" action="{{ routes.search_url }}" method="get" role="search">
        <input class="search-panel__input" type="search" name="q" placeholder="{{ 'general.search.label' | t }}…" autocomplete="off" aria-label="{{ 'general.search.label' | t }}">
        <button class="search-panel__submit" type="submit" aria-label="{{ 'general.search.label' | t }}">{% render 'icon-search' %}</button>
        {%- comment -%}
          Una sola aspa: limpia lo escrito y cierra el panel. La del navegador
          (input type=search) se oculta por CSS para no tener dos.
        {%- endcomment -%}
        <button class="search-panel__close" type="button" data-search-close aria-label="{{ 'general.accessibility.close' | t }}">{% render 'icon-close' %}</button>
      </form>
      <div class="search-panel__results" id="searchResults" aria-live="polite"></div>
    </div>
  </div>
</header>

{% render 'mobile-drawer', menu: menu, menu_right: menu_right %}

{% stylesheet %}
.site-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 90;
  color: var(--ink);
  background: rgba(255, 255, 255, 0.96);
  -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
  border-bottom: 0.5px solid var(--rule);
  transition: color 420ms var(--ease), background 420ms var(--ease), border-color 420ms var(--ease), backdrop-filter 420ms var(--ease);
}

.site-header.scrolled {
  background: rgba(255, 255, 255, 0.96);
  border-color: var(--rule);
}

/* Sobre un hero claro la barra va transparente y en blanco. */
.site-header.light {
  color: var(--paper);
  background: transparent;
  -webkit-backdrop-filter: none; backdrop-filter: none;
  border-color: rgba(255, 255, 255, 0.18);
}

.site-header.light.scrolled {
  background: rgba(15, 26, 46, 0.12);
  -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
}

.nav {
  height: var(--header-h);
  width: var(--content-wide);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
}

.nav-left,
.nav-right {
  display: flex;
  /* A todo el alto del header: así cada entrada con desplegable llega hasta el
     borde inferior y el ratón baja al panel sin salir de su área. */
  align-self: stretch;
  /* Con el árbol nuevo la barra lleva cinco entradas por lado: el hueco cede
     antes que dejar que el logo se desplace. */
  gap: clamp(19px, 2vw, 38px);
  align-items: center;
  min-width: 0;
  white-space: nowrap;
  font-size: 11px;
  line-height: 1;
  font-weight: 400;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}

.nav-right { justify-content: flex-end; }

.nav-left > a,
.nav-left .nav-item__link,
.nav-right > a:not(.search-link):not(.account-link):not(.header-cart),
.nav-right .nav-item__link {
  font-family: var(--menu-serif);
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0.025em;
  text-transform: none;
}

/* Subrayado que crece por la izquierda; la entrada mide 42px de alto y el
   filete queda 6px por encima del borde, como en el módulo del cliente. */
.nav-left > a,
.nav-left .nav-item__link,
.nav-right > a:not(.search-link):not(.account-link),
.nav-right .nav-item__link { position: relative; display: inline-flex; align-items: center; height: 42px; }

.nav-left > a::after,
.nav-left .nav-item__link::after,
.nav-right > a:not(.search-link):not(.account-link)::after,
.nav-right .nav-item__link::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0.235em;
  bottom: 6px;
  height: 1px;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 360ms var(--ease-long);
}

.nav-left > a:hover::after,
.nav-left > a[aria-current="page"]::after,
.nav-right > a:not(.search-link):not(.account-link):hover::after,
.nav-right > a[aria-current="page"]::after,
.nav-item:hover .nav-item__link::after,
.nav-item:focus-within .nav-item__link::after,
.nav-item__link[aria-current="page"]::after {
  transform: scaleX(1);
  transform-origin: left;
}

/* ==========================================================================
   Desplegables de la barra (snippets/nav-item.liquid).
   Sólo CSS: se abren con el ratón encima o con el foco dentro. El panel va a
   todo el ancho de la cabecera: la entrada ocupa el alto entero del header
   (align-self: stretch), así que el panel arranca justo en su borde inferior
   y el puntero baja hasta él sin salir del área de hover.
   ========================================================================== */
.nav-item { position: static; align-self: stretch; display: flex; align-items: center; }
.nav-item__link { position: relative; }

/* Sin desplazamiento y con el cierre retrasado: al pasar de Mesa a Café & Té el
   panel nuevo entra por encima (z 21) mientras el viejo aguanta 90 ms antes de
   fundirse, así que las dos bandas blancas se solapan y no hay parpadeo. */
.nav-drop {
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  z-index: 20;
  opacity: 0;
  visibility: hidden;
  transition: opacity 220ms var(--ease) 90ms, visibility 0s linear 310ms;
}

.nav-item:hover .nav-drop,
.nav-item:focus-within .nav-drop {
  opacity: 1;
  visibility: visible;
  z-index: 21;
  transition: opacity 180ms var(--ease) 0s, visibility 0s linear 0s;
}

/* Banda a sangre en papel; las columnas (y tarjetas) se reparten el ancho del
   shell a partes iguales. */
.nav-drop__inner {
  display: flex;
  align-items: stretch;
  gap: 38px;
  width: var(--content-wide);
  margin: 0 auto;
  padding: 35px 0 38px;
  color: var(--ink);
  animation: nav-drop-in 480ms var(--ease-long) both;
}
@keyframes nav-drop-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }
.nav-drop::before {
  content: "";
  position: absolute;
  inset: 0;
  background: var(--paper);
  border-top: 0.5px solid var(--rule);
  border-bottom: 0.5px solid var(--rule);
  box-shadow: 0 18px 55px rgba(15, 26, 46, 0.07);
  z-index: -1;
}

.nav-drop__col { flex: 1 1 0; min-width: 0; padding-right: 27px; border-right: 0.5px solid var(--rule); }
.nav-drop__col:last-child { padding-right: 0; border-right: 0; }
.nav-drop__head {
  display: block;
  margin: 0 0 13px;
  font-family: var(--serif);
  font-size: 25px;
  line-height: 1;
  font-weight: 400;
  letter-spacing: -0.01em;
  text-transform: none;
  color: var(--ink);
}
.nav-drop__head:hover { opacity: 0.62; }
.nav-drop__col--flag .nav-drop__head { color: var(--accent-1); }

.nav-drop ul { list-style: none; margin: 0; padding: 0; }
.nav-drop li { border-bottom: 0.5px solid rgba(15, 26, 46, 0.12); }
.nav-drop li a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 28px;
  padding: 6px 0;
  font-size: 12px;
  line-height: 1.25;
  letter-spacing: 0.035em;
  text-transform: none;
  color: var(--ink);
  transition: padding 240ms var(--ease), color 240ms var(--ease);
}
.nav-drop li a::after {
  content: "→";
  font-size: 11px;
  opacity: 0;
  transform: translateX(-5px);
  transition: opacity 240ms var(--ease), transform 240ms var(--ease);
}
.nav-drop li a:hover,
.nav-drop li a[aria-current="page"] { padding-left: 6px; color: var(--brand); }
.nav-drop li a:hover::after,
.nav-drop li a[aria-current="page"]::after { opacity: 1; transform: none; }
.nav-drop__col--flag li a { color: var(--accent-1); }

/* Tarjeta con foto (Vajilla, Juego de café, Legado…): imagen a sangre, degradado
   y rótulo abajo a la izquierda; al pasar por encima entra un marco blanco. */
.nav-drop__card,
.nav-drop__visual { flex: 1.15 1 0; min-width: 0; }
.nav-drop__visual { display: grid; grid-template-rows: 1fr auto; }
.nav-drop__visual .nav-drop__card { min-height: 170px; }
.nav-drop__pill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 9px;
  padding: 8px 11px;
  background: var(--ink-faint-20);
  font-size: 8.5px;
  line-height: 1;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  font-weight: 500;
}
.nav-drop__pill--sale { background: rgba(155, 44, 58, 0.10); color: var(--accent-1); }
.nav-drop__card {
  position: relative;
  display: block;
  min-height: 220px;
  overflow: hidden;
  background: #d7d3cd;
  isolation: isolate;
  color: var(--paper);
}
.nav-drop__card img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.nav-drop__card::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(180deg, rgba(15, 26, 46, 0.01) 30%, rgba(15, 26, 46, 0.78) 100%);
}
.nav-drop__card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 2;
  border: 0 solid rgba(255, 255, 255, 0.45);
  transition: border-width 350ms var(--ease);
}
.nav-drop__card:hover::before { border-width: 6px; }
.nav-drop__card-copy {
  position: absolute;
  z-index: 2;
  left: 17px;
  right: 17px;
  bottom: 16px;
  text-transform: none;
  letter-spacing: 0;
}
.nav-drop__card-copy strong {
  display: block;
  font-family: var(--serif);
  font-size: 21px;
  line-height: 1.02;
  font-weight: 400;
}

/* Con un desplegable abierto la cabecera pasa a papel, también sobre el hero
   claro: el logo vuelve a su tinta y el texto deja de ser blanco. */
/* La cabecera se queda en papel mientras el ratón esté sobre la barra entera
   (huecos entre entradas incluidos), no solo sobre una entrada: si no, al
   cruzar de una a otra volvía a transparente un instante y parpadeaba. */
.site-header:has(.nav-left:hover),
.site-header:has(.nav-right:hover),
.site-header:has(.nav-item:focus-within) {
  background: var(--paper);
  color: var(--ink);
  border-color: rgba(15, 26, 46, 0.08);
  -webkit-backdrop-filter: none; backdrop-filter: none;
}
.site-header:has(.nav-left:hover) .logo,
.site-header:has(.nav-right:hover) .logo,
.site-header:has(.nav-item:focus-within) .logo { filter: none; }

@media (prefers-reduced-motion: reduce) {
  .nav-drop,
  .nav-item:hover .nav-drop,
  .nav-item:focus-within .nav-drop { transition: opacity 1ms linear, visibility 0s; }
  .nav-drop__inner { animation: none; }
}

@media (prefers-reduced-motion: reduce) {
  .nav-left > a::after,
  .nav-right > a:not(.search-link):not(.account-link)::after { transition: none; }
}

.search-link,
.account-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 32px;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
}

.search-panel {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  background: var(--paper);
  color: var(--ink);
  border-bottom: 0.5px solid rgba(15, 26, 46, 0.08);
  opacity: 0;
  transform: translateY(-8px);
  pointer-events: none;
  transition: opacity 320ms var(--ease), transform 320ms var(--ease);
}

.search-open .search-panel {
  opacity: 1;
  transform: none;
  pointer-events: auto;
}

.search-panel__inner {
  width: var(--content-wide);
  margin: 0 auto;
  padding: 22px 0;
}

.search-panel__form {
  display: flex;
  align-items: center;
  gap: 16px;
}

.search-panel__results:not(:empty) {
  margin-top: 18px;
  max-height: min(60vh, 520px);
  overflow-y: auto;
}

.search-panel__input {
  flex: 1;
  min-width: 0;
  border: 0;
  border-bottom: 0.5px solid var(--rule);
  background: transparent;
  font-family: var(--serif);
  font-size: var(--fs-h3);
  font-weight: 400;
  padding: 8px 0;
  color: var(--ink);
}

.search-panel__input::-webkit-search-cancel-button,
.search-panel__input::-webkit-search-decoration { -webkit-appearance: none; appearance: none; }
.search-panel__input::placeholder { color: var(--muted); }

.search-panel__close {
  display: inline-flex; align-items: center; justify-content: center;
  width: 34px; height: 34px; flex: 0 0 34px; color: var(--muted); cursor: pointer;
  transition: color 220ms var(--ease);
}
.search-panel__close:hover { color: var(--ink); }
.search-panel__close svg { width: 14px; height: 14px; }
.search-panel__input:focus { outline: none; border-color: var(--ink); }

.search-panel__submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  flex: 0 0 auto;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--ink);
  cursor: pointer;
}

.search-panel__submit svg {
  width: 18px;
  height: 18px;
  stroke: currentColor;
  stroke-width: 1.25;
  fill: none;
}

.search-link svg,
.account-link svg {
  width: 15px;
  height: 15px;
  stroke: currentColor;
  stroke-width: 1.2;
  fill: none;
}

.header-cart { letter-spacing: 0.19em; }

.logo {
  height: 64px;
  width: auto;
  object-fit: contain;
  filter: none;
}

.site-header.light .logo { filter: brightness(0) invert(1); }

.menu-open .site-header,
.search-open .site-header {
  background: var(--paper);
  color: var(--ink);
  border-color: rgba(15, 26, 46, 0.08);
  -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
}

.menu-open .site-header .logo,
.search-open .site-header .logo { filter: none; }

.menu-trigger {
  display: flex;
  align-items: center;
  gap: 10px;
  height: 28px;
  padding: 0 8px;
  border: 1px solid transparent;
  border-radius: 2px;
  letter-spacing: 0.08em;
  transition: border-color 300ms var(--ease), background 300ms var(--ease);
}

.menu-trigger[aria-expanded="true"] { border-color: currentColor; }

.hamb {
  width: 22px;
  height: 13px;
  display: inline-block;
  position: relative;
}

.hamb::before,
.hamb::after {
  content: "";
  position: absolute;
  left: 0;
  width: 22px;
  height: 1px;
  background: currentColor;
  transition: transform 420ms var(--ease-long), top 420ms var(--ease-long);
}

.hamb::before { top: 2px; }
.hamb::after { top: 11px; }

.menu-trigger[aria-expanded="true"] .hamb::before { top: 6px; transform: rotate(36deg); }
.menu-trigger[aria-expanded="true"] .hamb::after { top: 6px; transform: rotate(-36deg); }

/* ==========================================================================
   Cajón móvil (snippets/mobile-drawer.liquid), por debajo de 1050px.
   ========================================================================== */
.mobile-drawer {
  display: none;
  position: fixed;
  z-index: 150;
  inset: 0;
  background: #f1f2f4;
  color: var(--ink);
  visibility: hidden;
  pointer-events: none;
  opacity: 0;
  transform: translateX(-12px);
  transition: opacity 340ms var(--ease), transform 500ms var(--ease-long), visibility 0s linear 500ms;
}
.mobile-drawer.is-open {
  visibility: visible;
  pointer-events: auto;
  opacity: 1;
  transform: none;
  transition: opacity 340ms var(--ease), transform 500ms var(--ease-long), visibility 0s;
}
.menu-lock { overflow: hidden; }

.mobile-head {
  height: 64px;
  padding: 0 14px;
  display: grid;
  grid-template-columns: 40px 1fr 40px;
  align-items: center;
  border-bottom: 0.5px solid var(--rule);
  background: rgba(255, 255, 255, 0.35);
}
.mobile-head-title { text-align: center; font-family: var(--serif); font-size: 21px; line-height: 1; font-weight: 400; }
.mobile-head button {
  width: 40px; height: 40px; display: grid; place-items: center;
  padding: 0; border: 0; background: none; color: inherit; font: inherit; font-size: 23px; cursor: pointer;
}
.mobile-head .mobile-back { font-size: 22px; }
.mobile-head .mobile-back[hidden] { display: grid; visibility: hidden; }

.mobile-view { display: none; height: calc(100dvh - 64px); overflow: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; }
.mobile-view.is-active { display: block; animation: mobile-view-in 420ms var(--ease-long) both; }
@keyframes mobile-view-in { from { opacity: 0; transform: translateX(12px); } to { opacity: 1; transform: none; } }

.mobile-main-list { list-style: none; margin: 0; padding: 20px 14px 28px; }
.mobile-main-list li { border-bottom: 0.5px solid rgba(15, 26, 46, 0.13); }
.mobile-main-list a,
.mobile-main-list button {
  width: 100%; min-height: 51px; display: flex; align-items: center; justify-content: space-between;
  padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left;
  font-family: var(--menu-serif); font-size: 18px; line-height: 1.25; font-weight: 700; cursor: pointer;
}
.mobile-main-list a::after,
.mobile-main-list button::after { content: "›"; font-size: 21px; font-weight: 300; }

.mobile-content { padding: 22px 15px 38px; }
.mobile-accordion { border-bottom: 0.5px solid rgba(15, 26, 46, 0.15); }
.accordion-toggle {
  width: 100%; min-height: 49px; display: flex; align-items: center; justify-content: space-between;
  padding: 0; border: 0; background: none; color: inherit; font: inherit; text-align: left;
  font-size: 12px; line-height: 1.3; font-weight: 400; cursor: pointer;
}
.accordion-toggle::after { content: "⌄"; font-size: 17px; transition: transform 320ms var(--ease); }
.mobile-accordion.is-open .accordion-toggle::after { transform: rotate(180deg); }
.accordion-body { display: grid; grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows 420ms var(--ease-long), opacity 300ms var(--ease); }
.mobile-accordion.is-open .accordion-body { grid-template-rows: 1fr; opacity: 1; }
.accordion-inner { overflow: hidden; }
.mobile-links { list-style: none; margin: 0; padding: 0 13px 15px; }
.mobile-links--loose { padding: 8px 0 0; }
.mobile-links a { display: block; padding: 8px 0; font-size: 11px; line-height: 1.35; color: var(--ink-soft); }
.mobile-visual-link {
  display: flex; align-items: center; justify-content: space-between; min-height: 49px;
  border-bottom: 0.5px solid rgba(15, 26, 46, 0.15); font-size: 12px; font-weight: 400;
}
.mobile-visual-link::after { content: "›"; font-size: 19px; }

.mobile-rail {
  display: flex; align-items: flex-start; gap: 14px; margin: 30px -15px 0; padding: 0 15px 18px;
  overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; scroll-padding-inline: 15px;
  scrollbar-width: none; -webkit-overflow-scrolling: touch;
}
.mobile-rail::-webkit-scrollbar { display: none; }
.mobile-card { display: block; min-width: 0; scroll-snap-align: start; }
.mobile-rail .mobile-card { flex: 0 0 calc(100vw - 46px); width: calc(100vw - 46px); }
.mobile-card-image { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; background: #d7d3cd; }
.mobile-card-label {
  display: flex; align-items: center; justify-content: space-between; padding: 10px 1px 5px;
  font-family: var(--serif); font-size: 17px; line-height: 1.1;
}
.mobile-card-label::after { content: "→"; font-family: var(--sans); font-size: 13px; }

/* Vista sólo de tarjetas (Legado): la primera a todo el ancho, el resto por parejas. */
.mobile-legacy { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 12px; }
.mobile-legacy .mobile-card:first-child { grid-column: 1 / -1; }
.mobile-legacy .mobile-card:first-child .mobile-card-image { aspect-ratio: 16 / 8; }
.mobile-legacy .mobile-card:not(:first-child) .mobile-card-image { aspect-ratio: 4 / 3; }
.mobile-legacy .mobile-card:not(:first-child) .mobile-card-label { font-size: 15px; }

@media (min-width: 621px) and (max-width: 1050px) {
  .mobile-rail .mobile-card { flex-basis: min(72vw, 680px); width: min(72vw, 680px); }
}

.skip-link {
  position: absolute;
  left: -9999px;
  top: 0;
  padding: 12px 16px;
  background: var(--ink);
  color: var(--paper);
  font-size: 12px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  z-index: 1000;
}

.skip-link:focus { left: 16px; top: 16px; }

/* Entre 1050 y 1280px la barra sigue siendo de escritorio pero el hueco no da
   para cinco entradas a 11px: baja medio punto y cierra el tracking. */
@media (min-width: 1051px) and (max-width: 1280px) {
  .nav-left,
  .nav-right { gap: 16px; font-size: 10.5px; letter-spacing: 0.16em; }
  .nav-left > a,
  .nav-left .nav-item__link,
  .nav-right > a:not(.search-link):not(.account-link):not(.header-cart),
  .nav-right .nav-item__link { font-size: 14px; }
}

@media (max-width: 1050px) {
  .nav-left > a,
  .nav-item,
  .nav-right > a:not(.search-link):not(.account-link):not(:last-child) { display: none; }
  .nav { grid-template-columns: 1fr auto 1fr; }
  .nav-left,
  .nav-right { gap: 16px; }
  .logo { height: 52px; }
  .site-header { z-index: 130; }
  .mobile-drawer { display: block; }
}

@media (max-width: 620px) {
  .menu-trigger { padding: 0; border-color: transparent !important; }
  .menu-trigger > span:last-child { display: none; }
  .nav-right { gap: 9px; }
  .account-link { display: none; }
  .search-link { width: 24px; }
  .mobile-head { height: 58px; }
  .mobile-view { height: calc(100dvh - 58px); }
}

/* v96: barra móvil con safe-area y objetivos táctiles de 44px. Buscar y cesta
   siguen visibles (antes se ocultaba todo .nav-right en móvil). */
@media (max-width: 780px) {
  .nav {
    width: calc(100vw - 28px);
    height: calc(var(--header-h) + env(safe-area-inset-top, 0px));
    padding-top: env(safe-area-inset-top, 0px);
    align-items: center;
  }

  .nav-left,
  .nav-right {
    gap: 12px;
    transform: translateY(-2px);
  }

  .menu-trigger { gap: 7px; }

  .logo,
  .logo img {
    height: 44px;
    max-height: 44px;
  }

  .nav-right > a:last-child {
    font-size: 9px;
    letter-spacing: 0.08em;
    white-space: nowrap;
  }

  .menu-trigger,
  .search-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .search-link { width: 40px; height: 40px; }
}

@media (prefers-reduced-motion: reduce) {
  .mobile-drawer,
  .mobile-view.is-active,
  .accordion-body,
  .accordion-toggle::after { transition: none; animation: none; }
}
{% endstylesheet %}

{% javascript %}
(function () {
  const header = document.getElementById('siteHeader');
  const menuToggle = document.getElementById('menuToggle');
  const body = document.body;

  const drawer = document.getElementById('mobileDrawer');
  const compact = window.matchMedia('(max-width: 1050px)');

  // Cajón móvil: vistas apiladas (principal → entrada), acordeones y bloqueo de scroll.
  const drawerViews = drawer ? Array.from(drawer.querySelectorAll('[data-mobile-view]')) : [];
  const drawerTitle = drawer && drawer.querySelector('[data-drawer-title]');
  const drawerBack = drawer && drawer.querySelector('[data-drawer-back]');
  const setDrawerView = (name) => {
    const view = drawerViews.find((v) => v.dataset.mobileView === name);
    if (!view) return;
    drawerViews.forEach((v) => v.classList.toggle('is-active', v === view));
    drawerTitle.textContent = name === 'main' ? drawerTitle.dataset.rootTitle : view.dataset.title;
    drawerBack.hidden = name === 'main';
    view.scrollTop = 0;
  };
  const openDrawer = () => {
    setDrawerView('main');
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');
    menuToggle.setAttribute('aria-expanded', 'true');
    body.classList.add('menu-lock');
  };
  const closeDrawer = () => {
    if (!drawer || !drawer.classList.contains('is-open')) return;
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    menuToggle.setAttribute('aria-expanded', 'false');
    body.classList.remove('menu-lock');
  };
  const closeMega = () => {
    body.classList.remove('menu-open');
    if (menuToggle) menuToggle.setAttribute('aria-expanded', 'false');
  };

  if (menuToggle) {
    menuToggle.addEventListener('click', () => {
      if (drawer && compact.matches) {
        drawer.classList.contains('is-open') ? closeDrawer() : openDrawer();
        return;
      }
      const open = body.classList.toggle('menu-open');
      menuToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  }

  if (drawer) {
    drawer.querySelectorAll('[data-mobile-open]').forEach((btn) => btn.addEventListener('click', () => setDrawerView(btn.dataset.mobileOpen)));
    drawer.querySelectorAll('.accordion-toggle').forEach((btn) => btn.addEventListener('click', () => {
      const open = btn.closest('.mobile-accordion').classList.toggle('is-open');
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }));
    drawer.querySelector('[data-drawer-close]').addEventListener('click', closeDrawer);
    drawerBack.addEventListener('click', () => setDrawerView('main'));
    compact.addEventListener('change', () => { closeDrawer(); closeMega(); });
  }

  const searchToggle = document.getElementById('searchToggle');
  const searchPanel = document.getElementById('searchPanel');
  const closeSearch = () => {
    body.classList.remove('search-open');
    if (searchToggle) searchToggle.setAttribute('aria-expanded', 'false');
  };
  if (searchToggle && searchPanel) {
    const input = searchPanel.querySelector('input');
    const results = searchPanel.querySelector('#searchResults');
    const predictiveUrl = searchPanel.dataset.predictiveUrl || '/search/suggest';
    let timer;
    let lastTerm = '';

    const renderResults = (html) => {
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const section = doc.querySelector('.shopify-section') || doc.body;
      results.innerHTML = section ? section.innerHTML : '';
    };

    const fetchResults = (term) => {
      const url = predictiveUrl
        + '?q=' + encodeURIComponent(term)
        + '&section_id=predictive-search'
        + '&resources[type]=product&resources[limit]=6';
      fetch(url)
        .then((r) => (r.ok ? r.text() : ''))
        .then(renderResults)
        .catch(() => { results.innerHTML = ''; });
    };

    input.addEventListener('input', () => {
      const term = input.value.trim();
      if (term === lastTerm) return;
      lastTerm = term;
      clearTimeout(timer);
      if (term.length < 2) { results.innerHTML = ''; return; }
      timer = setTimeout(() => fetchResults(term), 220);
    });

    const searchClose = searchPanel.querySelector('[data-search-close]');
    if (searchClose) searchClose.addEventListener('click', () => {
      if (input) input.value = '';
      if (results) results.innerHTML = '';
      closeSearch();
    });

    searchToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = body.classList.toggle('search-open');
      searchToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) {
        body.classList.remove('menu-open');
        if (menuToggle) menuToggle.setAttribute('aria-expanded', 'false');
        setTimeout(() => input && input.focus(), 60);
      }
    });
    document.addEventListener('click', (e) => {
      if (body.classList.contains('search-open') && !searchPanel.contains(e.target) && !searchToggle.contains(e.target)) {
        closeSearch();
      }
    });
  }

  window.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (body.classList.contains('menu-open')) closeMega();
    closeDrawer();
    if (body.classList.contains('search-open')) closeSearch();
  });

  function updateHeaderState() {
    const scrollY = window.scrollY;
    const scrolled = scrollY > 40;

    const probeY = (header.offsetHeight || 80) / 2;
    let lightVariant = false;
    document.querySelectorAll('[data-header-variant="light"]').forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top <= probeY && rect.bottom >= probeY) lightVariant = true;
    });

    header.classList.toggle('light', lightVariant);
    header.classList.toggle('scrolled', scrolled && !lightVariant);
  }

  window.addEventListener('scroll', updateHeaderState, { passive: true });
  window.addEventListener('resize', updateHeaderState);
  document.addEventListener('shopify:section:load', updateHeaderState);
  updateHeaderState();
})();
{% endjavascript %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menú de la izquierda",
      "info": "Mesa, Café & Té, Decoración, Colecciones. Los enlaces con hijos se despliegan al pasar el ratón."
    },
    {
      "type": "link_list",
      "id": "menu_right",
      "label": "Menú de la derecha",
      "info": "Nuevo, Viste tu mesa, Ambientes, Legado. Si se deja vacío, el menú de la izquierda se parte por «Number of menu links on the left»."
    },
    {
      "type": "range",
      "id": "nav_left_limit",
      "label": "Number of menu links on the left",
      "min": 0,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Overrides (optional)"
    },
    {
      "type": "image_picker",
      "id": "logo_override",
      "label": "Logo (overrides theme setting)"
    },
    {
      "type": "image_picker",
      "id": "logo_light_override",
      "label": "Logo light variant (overrides theme setting)"
    },
    {
      "type": "range",
      "id": "logo_width_override",
      "label": "Logo width override (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "info": "0 = use theme setting."
    }
  ],
  "presets": [{ "name": "Header" }],
  "enabled_on": { "groups": ["header"] }
}
